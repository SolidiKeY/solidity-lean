  (static : Bool) (bs : List UInt8) (member : bs ∈ Solidity.Lowering.V08.LiteralFailureBytesReadbackControls.messages) :
  ∃ code,
    ExceptT.run
          (Solidity.Source.evalE (Solidity.Lowering.V08.SourceCustomErrorControls.global pipeline)
            (have __src := Solidity.Lowering.V08.SourceCustomErrorControls.frame;
            { this := __src.this, sender := __src.sender, value := __src.value, static := static,
              contract := __src.contract, checked := __src.checked, depth := __src.depth, cd := __src.cd })
            6 (Solidity.Lowering.V08.LiteralFailureLowering.revertReason bs))
          (Solidity.Lowering.V08.SourceCustomErrorControls.locals,
            Solidity.Lowering.V08.SourceCustomErrorControls.populated) =
        (Except.error
            (Solidity.Source.Halt.revert
              (Solidity.Source.errorSelector ++
                Solidity.AbiEntry.encodeArgs (Solidity.Lowering.V08.LiteralFailureBytesReadback.values bs))),
          Solidity.Lowering.V08.SourceCustomErrorControls.locals,
          Solidity.Lowering.V08.SourceCustomErrorControls.populated) ∧
      Solidity.Backend.Failure.Slice.checkedRun code Solidity.Lowering.V08.LiteralFailureBytesReadbackControls.machine =
          some
            (have __src := Solidity.Lowering.V08.LiteralFailureBytesReadbackControls.machine;
              { stack := __src.stack,
                memory :=
                  Solidity.Backend.Failure.Slice.putBytes
                    Solidity.Lowering.V08.LiteralFailureBytesReadbackControls.machine.memory 8
                    (Solidity.Source.errorData bs) },
              some
                (Solidity.Source.revertOutcome
                  (Solidity.Source.errorSelector ++
                    Solidity.AbiEntry.encodeArgs (Solidity.Lowering.V08.LiteralFailureBytesReadback.values bs)))) ∧
        Solidity.Semantics.decodeError
            (Solidity.Backend.Failure.Slice.getBytes
              (Solidity.Backend.Failure.Slice.putBytes
                Solidity.Lowering.V08.LiteralFailureBytesReadbackControls.machine.memory 8
                (Solidity.Source.errorData bs))
              8 (List.length (Solidity.Source.errorData bs))) =
          some bs
