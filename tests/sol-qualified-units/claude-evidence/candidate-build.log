  (G : Solidity.Source.Glob E) (F : Solidity.Source.Fr) (n : Nat) (locals : Solidity.Source.Locals E.layout Γ)
  (state : Solidity.Source.St E) (bs : List UInt8) (address : Nat) (machine : Solidity.Backend.Failure.Slice.Machine)
  (fits : Solidity.Backend.Failure.Fits address (Solidity.Source.errorData bs))
  (stack : machine.stack.length + 2 ≤ 1024) :
  ∃ code,
    Solidity.Lowering.V08.LiteralFailureLowering.emitLiteral address
          (Solidity.Lowering.V08.LiteralFailureLowering.revertReason bs) =
        some code ∧
      ExceptT.run (Solidity.Source.evalE G F (n + 6) (Solidity.Lowering.V08.LiteralFailureLowering.revertReason bs))
            (locals, state) =
          (Except.error
              (Solidity.Source.Halt.revert
                (Solidity.Source.errorSelector ++
                  Solidity.AbiEntry.encodeArgs (Solidity.Lowering.V08.LiteralFailureBytesReadback.values bs))),
            locals, state) ∧
        Solidity.Backend.Failure.Slice.checkedRun code machine =
            some
              ({ stack := machine.stack,
                  memory :=
                    Solidity.Backend.Failure.Slice.putBytes machine.memory address (Solidity.Source.errorData bs) },
                some
                  (Solidity.Source.revertOutcome
                    (Solidity.Source.errorSelector ++
                      Solidity.AbiEntry.encodeArgs (Solidity.Lowering.V08.LiteralFailureBytesReadback.values bs)))) ∧
          Solidity.Backend.Failure.Slice.getBytes
                (Solidity.Backend.Failure.Slice.putBytes machine.memory address (Solidity.Source.errorData bs)) address
                (List.length (Solidity.Source.errorData bs)) =
              Solidity.Source.errorSelector ++
                Solidity.AbiEntry.encodeArgs (Solidity.Lowering.V08.LiteralFailureBytesReadback.values bs) ∧
            Solidity.Semantics.decodeError
                (Solidity.Backend.Failure.Slice.getBytes
                  (Solidity.Backend.Failure.Slice.putBytes machine.memory address (Solidity.Source.errorData bs))
                  address (List.length (Solidity.Source.errorData bs))) =
              some bs
