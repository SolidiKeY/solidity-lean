  assert((mv@Inner.b == 0));
  assert((mv@Inner.c == 0)) > (true)

// SolcMemory.memoryStructWriteRead
< Inner memory mv;
  mv@Inner.a = 1;
  mv@Inner.b = 2;
  mv@Inner.c = 3;
  assert((mv@Inner.a == 1));
  assert((mv@Inner.b == 2));
  assert((mv@Inner.c == 3)) > (true)

