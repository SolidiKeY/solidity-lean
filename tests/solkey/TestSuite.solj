// TestSuite.indexWriteBothImpureStorageRef
< (buckets@@TokenBucketArray).push();
  (buckets@@TokenBucketArray).push();
  (buckets@@TokenBucketArray[1].tokens).push();
  (buckets@@TokenBucketArray[1].tokens).push();
  tok@@Token.value = 8;
  Token storage src = tok@@Token;
  uint i = 1;
  uint j = 0;
  buckets@@TokenBucketArray[i++].tokens[j++] = src@Token;
  assert((i == 2));
  assert((j == 1));
  assert((buckets@@TokenBucketArray[1].tokens[0].value == 8)) > (true)

// TestSuite.indexWriteBothImpureMemToStorage
< (buckets@@TokenBucketArray).push();
  (buckets@@TokenBucketArray).push();
  (buckets@@TokenBucketArray[1].tokens).push();
  (buckets@@TokenBucketArray[1].tokens).push();
  Token memory mv;
  mv@Token.value = 5;
  uint i = 1;
  uint j = 0;
  buckets@@TokenBucketArray[i++].tokens[j++] = mv@Token;
  assert((i == 2));
  assert((j == 1));
  assert((buckets@@TokenBucketArray[1].tokens[0].value == 5)) > (true)
