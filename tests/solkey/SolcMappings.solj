// SolcMappings.structStorageToMappingEntry
< sBox@@S.a = 12;
  sMap@@SMap[1] = sBox@@S;
  assert((sMap@@SMap[1].a == 12)) > (true)

// SolcMappings.mappingEntryToStorageStruct
< sMap@@SMap[1].a = 7;
  sBox@@S = sMap@@SMap[1];
  assert((sBox@@S.a == 7)) > (true)

// SolcMappings.mappingEntryCopyIsDeep
< sBox@@S.a = 12;
  sMap@@SMap[1] = sBox@@S;
  sBox@@S.a = 13;
  assert((sMap@@SMap[1].a == 12)) > (true)

// SolcMappings.copySubstructureIntoMapping
< withSub@@WithSub.a = 1;
  withSub@@WithSub.sub.x = 2;
  withSub@@WithSub.sub.y = 3;
  withSubMap@@WithSubMap[5] = withSub@@WithSub;
  assert((withSubMap@@WithSubMap[5].a == 1));
  assert((withSubMap@@WithSubMap[5].sub.x == 2));
  assert((withSubMap@@WithSubMap[5].sub.y == 3)) > (true)

// SolcMappings.copySubstructureFromMapping
< withSubMap@@WithSubMap[5].a = 1;
  withSubMap@@WithSubMap[5].sub.x = 2;
  withSub@@WithSub = withSubMap@@WithSubMap[5];
  assert((withSub@@WithSub.a == 1));
  assert((withSub@@WithSub.sub.x == 2)) > (true)

// SolcMappings.mappingKeysAreIndependent
< balances[1] = 10;
  balances[2] = 20;
  delete balances[1];
  assert((balances[1] == 0));
  assert((balances[2] == 20)) > (true)

// SolcMappings.deleteStructKeepsMappingMember
< ledger@@Ledger.nonce = 5;
  ledger@@Ledger.balances[1] = 10;
  delete ledger@@Ledger;
  assert((ledger@@Ledger.nonce == 0));
  assert((ledger@@Ledger.balances[1] == 10)) > (true)

