// State-variable access inside a diamond: `value` is a purely syntactic field reference in
// the program AST (no program variable). fieldWriteThenRead moves the write into a save
// update and reads it back via find; the existing struct rule findAfterSave closes the goal.

\programSource "FieldBox.sol";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program FieldReference fr;
    \program SimpleExpression se;
    \term List path;
    \formula post;
}

\rules {
    fieldWriteThenRead {
        \schemaVar \program FieldReference fr;
        \schemaVar \program SimpleExpression se;
        \schemaVar \term List path;
        \schemaVar \formula post;
        \find(\modality{#mod}{ s#fr = s#se; }\endmodality(post))
        \varcond(\sameAsTerm(fr, path))
        \replacewith({storage := save(storage, path, se)} find<[int]>(storage, path) = se)
        \heuristics(simplify_prog)
    };
}

\problem {
    \<{ value = 42; }\>(true)
}
