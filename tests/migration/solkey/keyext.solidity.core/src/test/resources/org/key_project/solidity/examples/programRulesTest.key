\include "./commonFields.key";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
}

\rules {
    simpleVarAssign {
        \schemaVar \formula post;
        \schemaVar \program Variable lhs, rhs;
        \find(\modality{#mod}{ s#lhs = s#rhs; }\endmodality(post))
        \replacewith({lhs := rhs}post)
        \heuristics(simplify_prog)
    };

    diamondSkipVar {
        \schemaVar \formula post;
        \schemaVar \program Variable pv;
        \find(\<{ s#pv; }\>(post))
        \replacewith(post)
        \heuristics(simplify_prog)
    };

    boxSkipVar {
        \schemaVar \formula post;
        \schemaVar \program Variable pv;
        \find(\[{ s#pv; }\](post))
        \replacewith(post)
        \heuristics(simplify_prog)
    };

    constAssign42 {
        \schemaVar \formula post;
        \schemaVar \program Variable lhs;
        \find(\modality{#mod}{ s#lhs = 42; }\endmodality(post))
        \replacewith({lhs := 42}post)
        \heuristics(simplify_prog)
    };
}

\problem {
    (u = 42 -> \<{ v = u; }\>(v = 42))
    & (\<{ u; }\>(true))
    & (\[{ u; }\](true))
    & (\<{ v = 42; }\>(v = 42))
}
