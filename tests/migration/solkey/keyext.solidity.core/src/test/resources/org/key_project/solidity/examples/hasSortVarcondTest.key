\include "./commonFields.key";

// Smoke test that the \hasSort variable condition (SolidityTypeToSortCondition)
// parses and loads: it constrains a generic sort to the type of the expression a
// program schema variable is instantiated with (the typeof/newTypeOf mechanism).

\sorts {
    \generic G;
}

\schemaVariables {
    \modalOperator {diamond, box} #mod;
    \program SimpleExpression se;
    \formula post;
}

\rules {
    hasSortSmoke {
        \find(\modality{#mod}{ s#se }\endmodality(post))
        \varcond(\hasSort(se, \sort(G)))
        \replacewith(post)
        \heuristics(simplify_prog)
    };
}

\problem {
    true
}
