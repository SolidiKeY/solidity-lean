\include "./commonFields.key";

\schemaVariables {
    \modalOperator {diamond, box} #mod;
}

\rules {
    simpleAssignCtx {
        \schemaVar \formula post;
        \schemaVar \program Variable lhs;
        \schemaVar \program SimpleExpression se;
        \find(\modality{#mod}{c# s#lhs = s#se; #c}\endmodality(post))
        \replacewith({lhs := se}\modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    simpleAssign {
        \schemaVar \formula post;
        \schemaVar \program Variable lhs;
        \schemaVar \program SimpleExpression se;
        \find(\modality{#mod}{ s#lhs = s#se; }\endmodality(post))
        \replacewith({lhs := se}post)
        \heuristics(simplify_prog)
    };
}

\problem {
    // Two sequential assignments via context blocks.
    \<{ v = 42; u = v; }\>(u = 42)
}
