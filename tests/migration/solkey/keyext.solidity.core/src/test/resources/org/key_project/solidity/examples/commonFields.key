\functions {
    \unique MemberField owner;
    \unique MemberField age;
    \unique MemberField balance;
    \unique MemberField account;

    \unique IdentityPrim ca;
    \unique IdentityPrim cb;

    Identity alice;
    Identity aliceAcc;
    Identity bob;
    Identity bobAcc;

    \unique MemberField carol;
    \unique MemberField carolAcc;
    \unique MemberField eve;
    \unique MemberField eveAcc;
}

\programVariables {
    Memory mem;
    Struct st;
    Identity ownerEx;
    int u, v;
}

\rules {
    accNotPrimitive {
        \find(isPrimitive(account))
        \replacewith(false)
        \heuristics(concrete)
    };

    ownerNotPrimitive {
        \find(isPrimitive(owner))
        \replacewith(false)
        \heuristics(concrete)
    };

    ageIsPrimitive {
        \find(isPrimitive(age))
        \replacewith(true)
        \heuristics(concrete)
    };

}
