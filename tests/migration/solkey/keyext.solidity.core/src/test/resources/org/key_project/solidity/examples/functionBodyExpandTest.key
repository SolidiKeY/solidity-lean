\include "./commonFields.key";

// Smoke test that the functionBodyExpand taclet parses and loads: it declares a
// program schema variable of the new FunctionBody sort, matches a function-body
// statement inside a modality and replaces it by the body-inlining program
// transformer (expand_function_body).

\schemaVariables {
    \modalOperator {diamond, box} #mod;
}

\rules {
    functionBodyExpand {
        \schemaVar \formula post;
        \schemaVar \program FunctionBody fbs;
        \find(\modality{#mod}{ s#fbs }\endmodality(post))
        \replacewith(\modality{#mod}{ s#expand_function_body(s#fbs) }\endmodality(post))
        \heuristics(simplify_prog)
    };
}

\problem {
    true
}
