\include "./commonFields.key";

/*
    carol.f1.f2.f3.f4.f5 = 1;
    carol.f1.f2.f3.f4.f6 = 2;
    carol.f1.f2.f3.f4.f6 = 2;
    carol.f1.f2.f3.f4.f6 = 2;
    carol.f1.f2.f3.f4.f6 = 2;
    return carol.f1.f2.f3.f4.f5;
*/


\functions {
    \unique MemberField f1;
    \unique MemberField f2;
    \unique MemberField f3;
    \unique MemberField f4;
    \unique MemberField f5;
    \unique MemberField f6;
    \unique MemberField f7;
    \unique MemberField c;

    List flds;
    List flds2;
}

\rules {
    fldsSub {
        \find(flds)
        \replacewith(cons(f1, cons(f2, cons(f3, cons(f4, cons(f5, nil))))))
        \heuristics(concrete)
    };

    fldsSub2 {
        \find(flds2)
        \replacewith(cons(f1, cons(f2, cons(f3, cons(f4, cons(f6, nil))))))
        \heuristics(concrete)
    };
}


\problem {
    { st := mtSt }
    { st := save(st, flds , 1) }
    { st := save(st, flds2, 2) }
    { st := save(st, flds2, 2) }
    { st := save(st, flds2, 2) }
    { st := save(st, flds2, 2) }
    { st := save(st, flds2, 2) }
    { st := save(st, cons1(f7), 3) }
        { v := find<[int]>(st, cons1(f7)) }
            (v = 3)
}
