// NEGATIVE example, asserted to stay OPEN by NetExamplesTest#negativeAmountDiamondStaysOpen:
// with CInv defined as true, transferWithCallbackDiamond's "invariant on exit" and
// "resume after callback" goals close trivially, isolating the "non-negative amount"
// obligation 0 <= v, which cannot close with v unconstrained.

\withOptions transferSemantics:withCallback;

\programVariables {
    int to;
    int v;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(true)
        \heuristics(simplify)
    };
}

\problem {
    \<{ to.transfer(v); }\>(true)
}
