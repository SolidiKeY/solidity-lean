\include "./commonFields.key";

/*
    carol.age = 20;
    eve = carol;
    carol.age = 30;
    return eve.age;
*/


\problem {
    { st := save(mtSt, cons2(carol, age), 20) }
        { st := save(st, cons1(eve), find<[Struct]>(st, cons1(carol))) }
            { st := save(st, cons2(carol, age), 30) }
                { v := find<[int]>(st, cons2(eve, age)) }
                    (v = 20)
}
