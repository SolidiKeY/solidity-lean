// NEGATIVE example, asserted to stay OPEN by NetExamplesTest#negativeAmountDiamondStaysOpen
// (which is why it lives outside the RulesTest-scanned directory):
// transferNoCallbackDiamond owes 0 <= v, and v is unconstrained, so the "non-negative
// amount" goal cannot close. The "transfer booked" goal closes trivially against
// post = true, isolating that obligation as the only open goal.

\programVariables {
    int to;
    int v;
}

\problem {
    \<{ to.transfer(v); }\>(true)
}
