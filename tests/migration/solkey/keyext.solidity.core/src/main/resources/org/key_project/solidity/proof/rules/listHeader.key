\sorts {
    List;
    \generic alpha;
}

\functions{
    // Core
    \unique List nil;
    \unique List cons(any, List);
    List consr(List, any);

    alpha head<[alpha]>(List);
    List tail(List);

    List firsts(List);
    alpha last<[alpha]>(List);

    // Helpers
    List cons1(any);
    List cons2(any, any);
    List cons3(any, any, any);
}

\predicates {
    sizeLE1(List);
    isEmpty(List);
}
