/*
 * This file contains the known taclet options (aka choices) as well as their documentation.
 */

 \optionsDecl {
    /*! Rules dealing with Solidity language constructs can be turned off by setting this to 'None'. */
    programRules: {Solidity, /*! @choiceIncomplete */ None};

    /*!
    Loading less commonly used rules for (mathematical) integers,
    such as rules for bounded sums and products, modulo, or polynomials,
    can be disabled. If they are loaded, their application in the strategy
    can still be controlled as usual.

    This option is experimental. Depending of your understanding of 'less common',
    you may experience incompleteness.
    */
    integerSimplificationRules: {full, /*! @choiceIncomplete */ minimal}; // TODO: further refine this option

    /*! Semantics of `a.transfer(v)` (docs/net.md) and of the external call
     *  in `try`. Under either option the box transfer rule books the debit unconditionally, while the diamond rule
     *  additionally owes `0 <= v` as a "non-negative amount" goal. A transfer to
     *  `self` leaves the net ledger unchanged. */
    transferSemantics: {
        /*! Gas-limited transfer cannot call back into the contract: only the
         *  net ledger update remains and symbolic execution continues with all
         *  knowledge intact. This is the default option.
         *  @choiceDefaultOption
         */
        noCallback,
        /*! The callee may call back into the contract: the contract invariant
         *  CInv(storage, net) must be proven when control leaves, storage and
         *  net are havocked, and CInv is assumed on resume. */
        withCallback
    };
 }
