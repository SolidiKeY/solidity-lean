\functions{
    // Memory to Storage
    Struct copyMem(Struct, Memory, Identity);

    // Storage to Memory
    Memory copySt(Memory, IdentityPrim, Struct);
}

\schemaVariables{
    \term Memory mem;
    \term Identity id, id1, id2;
    \term IdentityPrim idp, idp1, idp2;
    \term Field a, a1, a2;
    \term List fxs, flds, xs;
    \term int iv;
    \term Struct st;
}

\rules {
    // Memory To Storage
    findOnCopy {
        \find(find<[prim]>(copyMem(st, mem, id), flds))
        \replacewith(readR<[prim]>(mem, id, flds))
        \heuristics(simplify)
    };

    selectOnCopyMemPrim {
        \find(selectSt<[prim]>(copyMem(st, mem, id), a))
        \replacewith(read<[prim]>(mem, id, a))
        \heuristics(simplify)
    };

    selectOnCopyMemRef {
        \find(selectSt<[Struct]>(copyMem(st, mem, id), a))
        \replacewith(copyMem(mtSt, mem, read<[Identity]>(mem, id, a)))
        \heuristics(simplify)
    };

    // Storage to Memory
    readFromCopyToStorage {
        \find( read<[prim]>(copySt(mem, idp1, st), idC(idp2, fxs), a) )
        \replacewith (
            \if (idp1 = idp2)
            \then ( find<[prim]>(st, consr(fxs, a)) )
            \else ( read<[prim]>(mem, idC(idp2, fxs), a) )
        )
        \heuristics(simplify_enlarging)
    };

    readFromCopyToStorageIdentity {
        \find( read<[Identity]>(copySt(mem, idp1, st), idC(idp2, fxs), a) )
        \replacewith (
            \if (idp1 = idp2)
            \then ( idC(idp1, consr(fxs, a)) )
            \else ( read<[Identity]>(mem, idC(idp2, fxs), a) )
        )
        \heuristics(simplify_enlarging)
    };
}
