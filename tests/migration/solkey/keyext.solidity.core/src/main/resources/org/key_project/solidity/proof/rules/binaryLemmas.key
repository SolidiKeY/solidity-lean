\rules {
    binaryAnd_literals {
        \schemaVar \term numbers iz, jz;
        \find(binaryAnd(Z(iz), Z(jz)))
        \replacewith(#BinaryAnd(Z(iz), Z(jz)))
        \heuristics(simplify_literals)
    };

    binaryAndZeroRight {
        \schemaVar \term int i;
        \find(binaryAnd(i, 0))
        \replacewith(0)
        \heuristics(concrete)
    };

    binaryAndZeroLeft {
        \schemaVar \term int i;
        \find(binaryAnd(0, i))
        \replacewith(0)
        \heuristics(concrete)
    };

    binaryAndIdentity {
        \schemaVar \term int i;
        \find(binaryAnd(i, i))
        \replacewith(i)
        \heuristics(concrete)
    };

    binaryAndOne {
        \schemaVar \term int i;
        \find(binaryAnd(i, 1))
        \replacewith(\if(mod(i, 2) = 0) \then(0) \else(1))
        \heuristics(simplify)
    };

    binaryAndOneLeft {
        \schemaVar \term int i;
        \find(binaryAnd(1, i))
        \replacewith(\if(mod(i, 2) = 0) \then(0) \else(1))
        \heuristics(simplify)
    };
}
