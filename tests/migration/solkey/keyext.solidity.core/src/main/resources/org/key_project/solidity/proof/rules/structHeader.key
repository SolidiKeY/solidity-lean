\sorts{
 Struct \extends StValue;
 Field;
 MemberField \extends Field;
 MapField \extends Field;
 MapMemberField \extends MapField, MemberField;
 RefField \extends MemberField;
 FixedField \extends MemberField;
 Shape \extends Struct;
}

\functions {
  \unique Struct mt;
  \unique Field at(Prim);
  \unique MapField atMap(int);
  \unique Field size;

  \unique Shape leaf;
  \unique Shape fixedArr(int, Shape);
  \unique Shape dynArr(Shape);
  \unique Shape mapOf(Shape);
  int sizeOf(Shape);
  Shape shapeAt(Shape, List);
  Shape fieldShape(MemberField);
}

\predicates {
  wf(Shape, Struct);
  wellformed(Struct);
  fixed(Struct);
}

\programVariables {
   Struct storage;
}
