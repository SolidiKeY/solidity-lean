    //     taclet                             ⟨0⟩  ⟨1⟩
    //     memoryFieldPreincrementAssignment  ++   +
    //     memoryFieldPredecrementAssignment  --   -
    memoryFieldPreincrementAssignment {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field fld;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v = ++s#mv.s#fld; #c}\endmodality(post))
        \replacewith({memory := write(memory, mv, fld,
                read<[int]>(memory, mv, fld) + 1)}
            {v := read<[int]>(memory, mv, fld)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // generalization:
    //     memoryField⟨name⟩Assignment {
