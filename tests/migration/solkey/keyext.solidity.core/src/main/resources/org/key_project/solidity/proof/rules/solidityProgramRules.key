    //     memoryFieldPostincrement_unfold_leftFst  s#nmp.s#fld++  s#mv.s#fld++
    //     memoryFieldPredecrement_unfold_leftFst   --s#nmp.s#fld  --s#mv.s#fld
    //     memoryFieldPostdecrement_unfold_leftFst  s#nmp.s#fld--  s#mv.s#fld--
    memoryFieldPreincrement_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,complex] nmp;
        \schemaVar \program Field fld;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# ++s#nmp.s#fld; #c}\endmodality(post))
        \varcond(\newTypeOf(mv, nmp))
        \replacewith(\modality{#mod}{c# s#aliasType memory s#mv = s#nmp;
                                      ++s#mv.s#fld; #c}\endmodality(post))
