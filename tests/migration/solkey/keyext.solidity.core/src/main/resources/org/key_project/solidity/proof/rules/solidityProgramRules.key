    //                 -> {v := find<[int]>(storage, consr(sp, at(ie)))}
    //                     {storage := save(storage, consr(sp, at(ie)),
    //                         find<[int]>(storage, consr(sp, at(ie))) ⟨1⟩ 1)}
    //                     \modality{#mod}{c# #c}\endmodality(post));
    //         "outOfBounds":
    //             \replacewith(!(0 <= ie & ie < find<[int]>(storage, consr(sp, size)))
    //                 -> \modality{#mod}{c# revert(); #c}\endmodality(post))
    //         \heuristics(simplify_expression)
    //     };
    //     taclet                                    ⟨0⟩  ⟨1⟩
    //     storageIndexArrayPostincrementAssignment  ++   +
    //     storageIndexArrayPostdecrementAssignment  --   -
    storageIndexArrayPostincrementAssignment {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v = s#sp[s#ie]++; #c}\endmodality(post))
        "inBounds":
            \replacewith(0 <= ie & ie < find<[int]>(storage, consr(sp, size))
                -> {v := find<[int]>(storage, consr(sp, at(ie)))}
                    {storage := save(storage, consr(sp, at(ie)),
                        find<[int]>(storage, consr(sp, at(ie))) + 1)}
                    \modality{#mod}{c# #c}\endmodality(post));
        "outOfBounds":
            \replacewith(!(0 <= ie & ie < find<[int]>(storage, consr(sp, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Pre-decrement assignment on storage index: result = --values[i];
    storageIndexMappingPredecrementAssignment {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,mapping] sp;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v = --s#sp[s#ie]; #c}\endmodality(post))
        \replacewith({storage := save(storage, consr(sp, at(ie)),
                find<[int]>(storage, consr(sp, at(ie))) - 1)}
            {v := find<[int]>(storage, consr(sp, at(ie)))}
