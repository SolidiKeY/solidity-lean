    storageLocalRootPushBind {
        \schemaVar \formula post;
        \schemaVar \program Variable[storage] lsv;
        \schemaVar \program Path[storage,simple,array,nonMappingElement] sp;

        \find(\modality{#mod}{c# s#lsv = s#sp.push(); #c}\endmodality(post))
        \replacewith({storage := save(delAt(storage,
                                          consr(sp, at(find<[int]>(storage,
                                              consr(sp, size))))),
                                     consr(sp, size),
                                     find<[int]>(storage, consr(sp, size)) + 1)
                      || lsv := consr(sp, at(find<[int]>(storage, consr(sp, size))))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storageLocalPrimitivePushBind {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program Path[storage,simple,array,primitiveElement] sp;

        \find(\modality{#mod}{c# s#v = s#sp.push(); #c}\endmodality(post))
        \varcond(\hasElementSort(sp, \sort(alphaPrim)))
        \replacewith({storage := save(delAt(storage,
                                          consr(sp, at(find<[int]>(storage,
                                              consr(sp, size))))),
                                     consr(sp, size),
                                     find<[int]>(storage, consr(sp, size)) + 1)
                      || v := find<[alphaPrim]>(delAt(storage,
                                                    consr(sp, at(find<[int]>(storage,
                                                        consr(sp, size))))),
                                                consr(sp, at(find<[int]>(storage,
                                                    consr(sp, size)))))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // generalization:
    //     storagePush⟨name⟩Assign {
    //         \schemaVar \formula post;
    //         \schemaVar \program Path[storage,simple,array,primitiveElement] sp;
    //         \schemaVar \program SimpleExpression se;
    //         \find(\modality{#mod}{c# s#sp.push() ⟨0⟩= s#se; #c}\endmodality(post))
    //         \replacewith({storage := save(delAt(storage,
    //                                           consr(sp, at(find<[int]>(storage,
    //                                               consr(sp, size))))),
    //                                      consr(sp, size),
    //                                      find<[int]>(storage, consr(sp, size)) + 1)}
    //             {storage := save(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1)),
    //                              find<[int]>(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1))) ⟨0⟩ se)}
    //             \modality{#mod}{c# #c}\endmodality(post))
    //         \heuristics(simplify_expression)
    //     };
    //     taclet                ⟨0⟩
    //     storagePushAddAssign  +
    //     storagePushSubAssign  -
    //     storagePushMulAssign  *
    storagePushAddAssign {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array,primitiveElement] sp;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#sp.push() += s#se; #c}\endmodality(post))
        \replacewith({storage := save(delAt(storage,
                                          consr(sp, at(find<[int]>(storage,
                                              consr(sp, size))))),
                                     consr(sp, size),
                                     find<[int]>(storage, consr(sp, size)) + 1)}
            {storage := save(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1)),
                             find<[int]>(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1))) + se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storagePushSubAssign {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array,primitiveElement] sp;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#sp.push() -= s#se; #c}\endmodality(post))
        \replacewith({storage := save(delAt(storage,
                                          consr(sp, at(find<[int]>(storage,
                                              consr(sp, size))))),
                                     consr(sp, size),
                                     find<[int]>(storage, consr(sp, size)) + 1)}
            {storage := save(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1)),
                             find<[int]>(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1))) - se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storagePushMulAssign {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array,primitiveElement] sp;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#sp.push() *= s#se; #c}\endmodality(post))
        \replacewith({storage := save(delAt(storage,
                                          consr(sp, at(find<[int]>(storage,
                                              consr(sp, size))))),
                                     consr(sp, size),
                                     find<[int]>(storage, consr(sp, size)) + 1)}
            {storage := save(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1)),
                             find<[int]>(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1))) * se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // generalization:
    //     storagePush⟨name⟩Assign {
    //         \schemaVar \formula post;
    //         \schemaVar \program Path[storage,simple,array,primitiveElement] sp;
    //         \schemaVar \program SimpleExpression se;
    //         \find(\modality{#mod}{c# s#sp.push() ⟨0⟩= s#se; #c}\endmodality(post))
    //         \replacewith(\if(se != 0)
    //             \then({storage := save(delAt(storage,
    //                                           consr(sp, at(find<[int]>(storage,
    //                                               consr(sp, size))))),
    //                                      consr(sp, size),
    //                                      find<[int]>(storage, consr(sp, size)) + 1)}
    //                 {storage := save(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1)),
    //                                  ⟨1⟩(find<[int]>(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1))), se))}
    //                 \modality{#mod}{c# #c}\endmodality(post))
    //             \else(\modality{#mod}{c# revert(); #c}\endmodality(post)))
    //         \heuristics(simplify_expression)
    //     };
    //     taclet                ⟨0⟩  ⟨1⟩
    //     storagePushDivAssign  /    sdiv
    //     storagePushModAssign  %    smod
    storagePushDivAssign {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array,primitiveElement] sp;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#sp.push() /= s#se; #c}\endmodality(post))
        \replacewith(\if(se != 0)
            \then({storage := save(delAt(storage,
                                          consr(sp, at(find<[int]>(storage,
                                              consr(sp, size))))),
                                     consr(sp, size),
                                     find<[int]>(storage, consr(sp, size)) + 1)}
                {storage := save(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1)),
                                 sdiv(find<[int]>(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1))), se))}
                \modality{#mod}{c# #c}\endmodality(post))
            \else(\modality{#mod}{c# revert(); #c}\endmodality(post)))
        \heuristics(simplify_expression)
    };

    storagePushModAssign {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array,primitiveElement] sp;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#sp.push() %= s#se; #c}\endmodality(post))
        \replacewith(\if(se != 0)
            \then({storage := save(delAt(storage,
                                          consr(sp, at(find<[int]>(storage,
                                              consr(sp, size))))),
                                     consr(sp, size),
                                     find<[int]>(storage, consr(sp, size)) + 1)}
                {storage := save(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1)),
                                 smod(find<[int]>(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1))), se))}
                \modality{#mod}{c# #c}\endmodality(post))
            \else(\modality{#mod}{c# revert(); #c}\endmodality(post)))
        \heuristics(simplify_expression)
    };

    // generalization:
    //     storagePush⟨name⟩ {
    //         \schemaVar \formula post;
    //         \schemaVar \program Path[storage,simple,array,primitiveElement] sp;
    //         \find(\modality{#mod}{c# ⟨0⟩; #c}\endmodality(post))
    //         \replacewith({storage := save(delAt(storage,
    //                                           consr(sp, at(find<[int]>(storage,
    //                                               consr(sp, size))))),
    //                                      consr(sp, size),
    //                                      find<[int]>(storage, consr(sp, size)) + 1)}
    //             {storage := save(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1)),
    //                              find<[int]>(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1))) ⟨1⟩ 1)}
    //             \modality{#mod}{c# #c}\endmodality(post))
    //         \heuristics(simplify_expression)
    //     };
    //     taclet                    ⟨0⟩            ⟨1⟩
    //     storagePushPreincrement   ++s#sp.push()  +
    //     storagePushPostincrement  s#sp.push()++  +
    //     storagePushPredecrement   --s#sp.push()  -
    //     storagePushPostdecrement  s#sp.push()--  -
    storagePushPreincrement {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array,primitiveElement] sp;

        \find(\modality{#mod}{c# ++s#sp.push(); #c}\endmodality(post))
        \replacewith({storage := save(delAt(storage,
                                          consr(sp, at(find<[int]>(storage,
                                              consr(sp, size))))),
                                     consr(sp, size),
                                     find<[int]>(storage, consr(sp, size)) + 1)}
            {storage := save(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1)),
                             find<[int]>(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1))) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storagePushPostincrement {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array,primitiveElement] sp;

        \find(\modality{#mod}{c# s#sp.push()++; #c}\endmodality(post))
        \replacewith({storage := save(delAt(storage,
                                          consr(sp, at(find<[int]>(storage,
                                              consr(sp, size))))),
                                     consr(sp, size),
                                     find<[int]>(storage, consr(sp, size)) + 1)}
            {storage := save(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1)),
                             find<[int]>(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1))) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storagePushPredecrement {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array,primitiveElement] sp;

        \find(\modality{#mod}{c# --s#sp.push(); #c}\endmodality(post))
        \replacewith({storage := save(delAt(storage,
                                          consr(sp, at(find<[int]>(storage,
                                              consr(sp, size))))),
                                     consr(sp, size),
                                     find<[int]>(storage, consr(sp, size)) + 1)}
            {storage := save(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1)),
                             find<[int]>(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1))) - 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storagePushPostdecrement {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array,primitiveElement] sp;

        \find(\modality{#mod}{c# s#sp.push()--; #c}\endmodality(post))
        \replacewith({storage := save(delAt(storage,
                                          consr(sp, at(find<[int]>(storage,
                                              consr(sp, size))))),
                                     consr(sp, size),
                                     find<[int]>(storage, consr(sp, size)) + 1)}
            {storage := save(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1)),
                             find<[int]>(storage, consr(sp, at(find<[int]>(storage, consr(sp, size)) - 1))) - 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storageLocalRootPushBindMappingElement {
        \schemaVar \formula post;
        \schemaVar \program Variable[storage] lsv;
        \schemaVar \program Path[storage,simple,array,mappingElement] sp;

        \find(\modality{#mod}{c# s#lsv = s#sp.push(); #c}\endmodality(post))
        \replacewith({storage := save(storage, consr(sp, size),
                                      find<[int]>(storage, consr(sp, size)) + 1)
                      || lsv := consr(sp, atMap(find<[int]>(storage, consr(sp, size))))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storagePopSave {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array,nonMappingElement] sp;

        \find(\modality{#mod}{c# s#sp.pop(); #c}\endmodality(post))
        "nonEmpty":
            \replacewith(0 < find<[int]>(storage, consr(sp, size))
                -> {storage := save(delAt(storage,
                                         consr(sp, at(find<[int]>(storage,
                                             consr(sp, size)) - 1))),
                                         consr(sp, size),
                                         find<[int]>(storage, consr(sp, size)) - 1)}
                    \modality{#mod}{c# #c}\endmodality(post));
        "empty":
            \replacewith(!(0 < find<[int]>(storage, consr(sp, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storagePopSaveMappingElement {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array,mappingElement] sp;

        \find(\modality{#mod}{c# s#sp.pop(); #c}\endmodality(post))
        "nonEmpty":
            \replacewith(0 < find<[int]>(storage, consr(sp, size))
                -> {storage := save(storage, consr(sp, size),
                                    find<[int]>(storage, consr(sp, size)) - 1)}
                    \modality{#mod}{c# #c}\endmodality(post));
        "empty":
            \replacewith(!(0 < find<[int]>(storage, consr(sp, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageLocalRootRebind {
        \schemaVar \formula post;
        \schemaVar \program Variable[storage] lsv;
        \schemaVar \program Path[storage,simple] sp;

        \find(\modality{#mod}{c# s#lsv = s#sp; #c}\endmodality(post))
        \replacewith({lsv := sp}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageLocalDeclSkip {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable[storage] lsv;

        \find(\modality{#mod}{c# s#aliasType storage s#lsv; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# #c}\endmodality(post))
        \addprogvars(lsv)
        \heuristics(simplify_prog)
    };

    storageLocalDeclInitDrop {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable lhs;
        \schemaVar \program Expression rhs;

        \find(\modality{#mod}{c# s#aliasType storage s#lhs = s#rhs; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#lhs = s#rhs; #c}\endmodality(post))
        \addprogvars(lhs)
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for memory reference allocation
    // ------------------------------------------------------------------------

    memoryReferenceDeclFreshAlloc {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \skolemTerm IdentityPrim freshIdp;

        \find(\modality{#mod}{c# s#aliasType memory s#mv; #c}\endmodality(post))
        \sameUpdateLevel
        \replacewith({mv := idC(shaped(freshIdp, #shapeOf(mv)), nil)}
            {memory := addM(memory, shaped(freshIdp, #shapeOf(mv)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \add(new(memory, shaped(freshIdp, #shapeOf(mv))) ==>)
        \addprogvars(mv)
        \heuristics(simplify_prog)
    };

    memoryLocalDeclInitDrop {
        \schemaVar \formula post;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable lhs;
        \schemaVar \program Expression rhs;

        \find(\modality{#mod}{c# s#aliasType memory s#lhs = s#rhs; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#lhs = s#rhs; #c}\endmodality(post))
        \addprogvars(lhs)
        \heuristics(simplify_prog)
    };

    memoryRootDeleteFreshRebind {
        \schemaVar \formula post;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \skolemTerm IdentityPrim freshIdp;

        \find(\modality{#mod}{c# delete s#mv; #c}\endmodality(post))
        \sameUpdateLevel
        \replacewith({mv := idC(shaped(freshIdp, idShape(mv)), nil)
                      || memory := addM(memory, shaped(freshIdp, idShape(mv)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \add(new(memory, shaped(freshIdp, idShape(mv))) ==>) // ensures semantic freshness
        \heuristics(simplify_prog)
    };

    memoryRootRebind {
        \schemaVar \formula post;
        \schemaVar \program Variable[memory] mv1;
        \schemaVar \program Path[memory,simple] mv2;

        \find(\modality{#mod}{c# s#mv1 = s#mv2; #c}\endmodality(post))
        \replacewith({mv1 := mv2}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryArrayFreshAlloc {
        \schemaVar \formula post;
        \schemaVar \program Type arrayType;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program SimpleExpression se;
        \schemaVar \skolemTerm IdentityPrim freshIdp;

        \find(\modality{#mod}{c# s#mv = new s#arrayType(s#se); #c}\endmodality(post))
        \sameUpdateLevel
        \replacewith({mv := idC(shaped(freshIdp, #shapeOf(mv)), nil)}
            {memory := write(addM(memory, shaped(freshIdp, #shapeOf(mv))),
                             idC(shaped(freshIdp, #shapeOf(mv)), nil), size, se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \add(new(memory, shaped(freshIdp, #shapeOf(mv))) ==>)
        \heuristics(simplify_prog)
    };

    newArrayCapture {
        \schemaVar \formula post;
        \schemaVar \program Path[complex] lhs;
        \schemaVar \program Type arrayType;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#lhs = new s#arrayType(s#se); #c}\endmodality(post))
        \varcond(\newTypeOf(mv, lhs))
        \replacewith(\modality{#mod}{c# s#aliasType memory s#mv = new s#arrayType(s#se);
                                      s#lhs = s#mv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    newArrayCaptureStorageRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;
        \schemaVar \program Type arrayType;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#gsp = new s#arrayType(s#se); #c}\endmodality(post))
        \varcond(\newTypeOf(mv, gsp))
        \replacewith(\modality{#mod}{c# s#aliasType memory s#mv = new s#arrayType(s#se);
                                      s#gsp = s#mv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Deep-copy a simple storage path into a fresh memory struct: m = sp;
    memoryStorageCopy {
        \schemaVar \formula post;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \skolemTerm IdentityPrim freshIdp;

        \find(\modality{#mod}{c# s#mv = s#sp; #c}\endmodality(post))
        \sameUpdateLevel
        \replacewith({mv := idC(shaped(freshIdp, #shapeOf(mv)), nil)}
            {memory := copySt(addM(memory, shaped(freshIdp, #shapeOf(mv))),
                              shaped(freshIdp, #shapeOf(mv)), find<[Struct]>(storage, sp))}
            \modality{#mod}{c# #c}\endmodality(post))
        \add(new(memory, shaped(freshIdp, #shapeOf(mv))) ==>)
        \heuristics(simplify_prog)
    };

    // Capture a complex storage path in a local storage pointer first: m = sp;
    memoryStorageCopyUnfold {
        \schemaVar \formula post;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#mv = s#nsp; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#mv = s#sp; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryFieldWrite {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field fld;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#mv.s#fld = s#se; #c}\endmodality(post))
        \replacewith({memory := write(memory, mv, fld, se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryFieldRead {
        \schemaVar \formula post;
        \schemaVar \program Variable lhs;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field fld;

        \find(\modality{#mod}{c# s#lhs = s#mv.s#fld; #c}\endmodality(post))
        \varcond(\hasMemoryFieldSort(fld, \sort(alpha)))
        \replacewith({lhs := read<[alpha]>(memory, mv, fld)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryFieldRead_unfold_rightFst {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,complex] nmp;
        \schemaVar \program Field fld;
        \schemaVar \program Expression lhs;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#lhs = s#nmp.s#fld; #c}\endmodality(post))
        \varcond(\newTypeOf(mv, nmp))
        \replacewith(\modality{#mod}{c# s#aliasType memory s#mv = s#nmp;
                                      s#lhs = s#mv.s#fld; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryFieldWriteCaptureSrc {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple] mv1;
        \schemaVar \program Field fld;
        \schemaVar \program Path[memory,complex,reference] nmp;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#mv1.s#fld = s#nmp; #c}\endmodality(post))
        \varcond(\newTypeOf(mv, nmp))
        \replacewith(\modality{#mod}{c# s#aliasType memory s#mv = s#nmp;
                                      s#mv1.s#fld = s#mv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryFieldWrite_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,complex] nmp;
        \schemaVar \program Field fld;
        \schemaVar \program Expression[primitive] e;
        \schemaVar \program Variable rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nmp.s#fld = s#e; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, e), \newTypeOf(mv, nmp))
        \replacewith(\modality{#mod}{c# s#rvType s#rv = s#e;
                                      s#aliasType memory s#mv = s#nmp;
                                      s#mv.s#fld = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryFieldWriteMemRef_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,complex] nmp;
        \schemaVar \program Field fld;
        \schemaVar \program Path[memory,reference] src;
        \schemaVar \program Variable[memory] rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nmp.s#fld = s#src; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, src), \newTypeOf(mv, nmp))
        \replacewith(\modality{#mod}{c# s#rvType memory s#rv = s#src;
                                      s#aliasType memory s#mv = s#nmp;
                                      s#mv.s#fld = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryIndexWriteArray {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple,array] mv;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#mv[s#ie] = s#se; #c}\endmodality(post))
        \sameUpdateLevel
        "inBounds":
            \replacewith({memory := write(memory, mv, at(ie), se)}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(0 <= ie & ie < read<[int]>(memory, mv, size) ==>);
        "outOfBounds":
            \replacewith(\modality{#mod}{c# revert(); #c}\endmodality(post))
            \add( ==> 0 <= ie & ie < read<[int]>(memory, mv, size))
        \heuristics(simplify_prog)
    };

    memoryIndexReadArrayValue {
        \schemaVar \formula post;
        \schemaVar \program Variable lhs;
        \schemaVar \program Path[memory,simple,array,primitiveElement] mv;
        \schemaVar \program SimpleExpression ie;

        \find(\modality{#mod}{c# s#lhs = s#mv[s#ie]; #c}\endmodality(post))
        \sameUpdateLevel
        \varcond(\hasMemoryElementSort(mv, \sort(alpha)))
        "inBounds":
            \replacewith({lhs := read<[alpha]>(memory, mv, at(ie))}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(0 <= ie & ie < read<[int]>(memory, mv, size) ==>);
        "outOfBounds":
            \replacewith(\modality{#mod}{c# revert(); #c}\endmodality(post))
            \add( ==> 0 <= ie & ie < read<[int]>(memory, mv, size))
        \heuristics(simplify_prog)
    };

    memoryIndexReadArrayMemory {
        \schemaVar \formula post;
        \schemaVar \program Variable[memory] mv1;
        \schemaVar \program Path[memory,simple,array,referenceElement] mv2;
        \schemaVar \program SimpleExpression ie;

        \find(\modality{#mod}{c# s#mv1 = s#mv2[s#ie]; #c}\endmodality(post))
        \sameUpdateLevel
        "inBounds":
            \replacewith({mv1 := read<[Identity]>(memory, mv2, at(ie))}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(0 <= ie & ie < read<[int]>(memory, mv2, size) ==>);
        "outOfBounds":
            \replacewith(\modality{#mod}{c# revert(); #c}\endmodality(post))
            \add( ==> 0 <= ie & ie < read<[int]>(memory, mv2, size))
        \heuristics(simplify_prog)
    };

    memoryIndexRead_unfold_rightFst {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,complex] nmp;
        \schemaVar \program Expression ie;
        \schemaVar \program Expression lhs;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#lhs = s#nmp[s#ie]; #c}\endmodality(post))
        \varcond(\newTypeOf(mv, nmp))
        \replacewith(\modality{#mod}{c# s#aliasType memory s#mv = s#nmp;
                                      s#lhs = s#mv[s#ie]; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryFieldDeletePrimitive {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field fld;

        \find(\modality{#mod}{c# delete s#mv.s#fld; #c}\endmodality(post))
        \varcond(\hasMemoryFieldSort(fld, \sort(alphaPrim)))
        \replacewith({memory := write(memory, mv, fld, defaultValue<[alphaPrim]>)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryFieldDeleteReference {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field fld;
        \schemaVar \skolemTerm IdentityPrim freshIdp;

        \find(\modality{#mod}{c# delete s#mv.s#fld; #c}\endmodality(post))
        \sameUpdateLevel
        \varcond(\hasMemoryFieldSort(fld, \sort(alphaId)))
        "freshen":
            \replacewith({memory := write(addM(memory, shaped(freshIdp, #shapeOf(fld))), mv, fld,
                                          idC(shaped(freshIdp, #shapeOf(fld)), nil))}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(new(memory, shaped(freshIdp, #shapeOf(fld))) ==>)
        \heuristics(simplify_prog)
    };

    memoryIndexDeletePrimitive {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple,array,primitiveElement] mv;
        \schemaVar \program SimpleExpression ie;

        \find(\modality{#mod}{c# delete s#mv[s#ie]; #c}\endmodality(post))
        \sameUpdateLevel
        "inBounds":
            \replacewith({memory := write(memory, mv, at(ie), defVal)}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(0 <= ie & ie < read<[int]>(memory, mv, size) ==>);
        "outOfBounds":
            \replacewith(\modality{#mod}{c# revert(); #c}\endmodality(post))
            \add( ==> 0 <= ie & ie < read<[int]>(memory, mv, size))
        \heuristics(simplify_prog)
    };

    memoryIndexDeleteReference {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple,array,referenceElement] mv;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \skolemTerm IdentityPrim freshIdp;

        \find(\modality{#mod}{c# delete s#mv[s#ie]; #c}\endmodality(post))
        \sameUpdateLevel
        "inBounds":
            \replacewith({memory := write(addM(memory,
                                               shaped(freshIdp, shapeAt(idShape(mv), cons(at(ie), nil)))),
                                          mv, at(ie),
                                          idC(shaped(freshIdp, shapeAt(idShape(mv), cons(at(ie), nil))),
                                              nil))}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(0 <= ie & ie < read<[int]>(memory, mv, size)
                 & new(memory, shaped(freshIdp, shapeAt(idShape(mv), cons(at(ie), nil)))) ==>);
        "outOfBounds":
            \replacewith(\modality{#mod}{c# revert(); #c}\endmodality(post))
            \add( ==> 0 <= ie & ie < read<[int]>(memory, mv, size))
        \heuristics(simplify_prog)
    };

    memoryFieldDelete_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,complex] nmp;
        \schemaVar \program Field fld;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# delete s#nmp.s#fld; #c}\endmodality(post))
        \varcond(\newTypeOf(mv, nmp))
        \replacewith(\modality{#mod}{c# s#aliasType memory s#mv = s#nmp;
                                      delete s#mv.s#fld; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryIndexDelete_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,complex] nmp;
        \schemaVar \program Expression ie;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# delete s#nmp[s#ie]; #c}\endmodality(post))
        \varcond(\newTypeOf(mv, nmp))
        \replacewith(\modality{#mod}{c# s#aliasType memory s#mv = s#nmp;
                                      delete s#mv[s#ie]; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryToStorageStoreRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;
        \schemaVar \program Path[memory,simple] mv;

        \find(\modality{#mod}{c# s#gsp = s#mv; #c}\endmodality(post))
        \replacewith({storage := save(storage, gsp, copyMem(mtSt, memory, mv))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryToStorageFieldCopyRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \program Field fld;
        \schemaVar \program Variable[memory] mv;

        \find(\modality{#mod}{c# s#sp.s#fld = s#mv; #c}\endmodality(post))
        \replacewith({storage := save(storage, consr(sp, fld),
                                      copyMem(mtSt, memory, mv))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryToStorageFieldCopyField {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \program Field fld;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field srcFld;

        \find(\modality{#mod}{c# s#sp.s#fld = s#mv.s#srcFld; #c}\endmodality(post))
        \varcond(\hasMemoryFieldSort(srcFld, \sort(alphaId)))
        \replacewith({storage := save(storage, consr(sp, fld),
                                      copyMem(mtSt, memory,
                                          read<[Identity]>(memory, mv, srcFld)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryToStorageIndexMappingCopyRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,mapping] sp;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program Variable[memory] mv;

        \find(\modality{#mod}{c# s#sp[s#ie] = s#mv; #c}\endmodality(post))
        \replacewith({storage := save(storage, consr(sp, at(ie)),
                                      copyMem(mtSt, memory, mv))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryToStorageIndexArrayCopyRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program Variable[memory] mv;

        \find(\modality{#mod}{c# s#sp[s#ie] = s#mv; #c}\endmodality(post))
        "inBounds":
            \replacewith(0 <= ie & ie < find<[int]>(storage, consr(sp, size))
                -> {storage := save(storage, consr(sp, at(ie)),
                        copyMem(mtSt, memory, mv))}
                    \modality{#mod}{c# #c}\endmodality(post));
        "outOfBounds":
            \replacewith(!(0 <= ie & ie < find<[int]>(storage, consr(sp, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for value variable declarations
    // ------------------------------------------------------------------------

    // Declarations with initialization are decomposed by localValueDeclInitDrop,
    // storageLocalDeclInitDrop, and memoryLocalDeclInitDrop (one per data location).

    localValueDeclInitDrop {
        \schemaVar \formula post;
        \schemaVar \program Type varType;
        \schemaVar \program Variable lhs;
        \schemaVar \program Expression rhs;

        \find(\modality{#mod}{c# s#varType s#lhs = s#rhs; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#lhs = s#rhs; #c}\endmodality(post))
        \addprogvars(lhs)
        \heuristics(simplify_prog)
    };

    // Skip bare value variable declaration and add to program variables
    valueDeclSkip {
        \schemaVar \formula post;
        \schemaVar \program Type varType;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#varType s#v; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# #c}\endmodality(post))
        \addprogvars(v)
        \heuristics(simplify_prog)
    };

    storageFieldReadBindLocalRoot {
        \schemaVar \formula post;
        \schemaVar \program Variable[storage] lsv;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \program Field fld;

        \find(\modality{#mod}{c# s#lsv = s#sp.s#fld; #c}\endmodality(post))
        \replacewith({lsv := consr(sp, fld)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldReadStoreRoot {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \program Field fld;

        \find(\modality{#mod}{c# s#gsp = s#sp.s#fld; #c}\endmodality(post))
        \replacewith({storage := save(storage, gsp,
                find<[StValue]>(storage, consr(sp, fld)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for storage compound assignment operators
    // ------------------------------------------------------------------------

    // generalization:
    //     storageRoot⟨name⟩Assign {
    //         \schemaVar \formula post;
    //         \schemaVar \program Path[storage,simple,global] gsp;
    //         \schemaVar \program SimpleExpression se;
    //         \find(\modality{#mod}{c# s#gsp ⟨0⟩= s#se; #c}\endmodality(post))
    //         \replacewith({storage := save(storage, gsp, find<[int]>(storage, gsp) ⟨0⟩ se)}
    //             \modality{#mod}{c# #c}\endmodality(post))
    //         \heuristics(simplify_expression)
    //     };
    //     taclet                ⟨0⟩
    //     storageRootAddAssign  +
    //     storageRootSubAssign  -
    //     storageRootMulAssign  *
    storageRootAddAssign {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#gsp += s#se; #c}\endmodality(post))
        \replacewith({storage := save(storage, gsp, find<[int]>(storage, gsp) + se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // generalization:
    //     storageField⟨name⟩Assign_unfold_leftFst {
    //         \schemaVar \formula post;
    //         \schemaVar \program Path[storage,complex] nsp;
    //         \schemaVar \program Field fld;
    //         \schemaVar \program SimpleExpression[primitive] se;
    //         \schemaVar \program Variable rv;
    //         \schemaVar \program Type rvType;
    //         \schemaVar \program Variable[storage] sp;
    //         \schemaVar \program Type aliasType;
    //         \find(\modality{#mod}{c# s#nsp.s#fld ⟨0⟩= s#se; #c}\endmodality(post))
    //         \varcond(\newTypeOf(rv, se), \newTypeOf(sp, nsp))
    //         \replacewith(\modality{#mod}{c# s#rvType s#rv = s#se;
    //                                       s#aliasType storage s#sp = s#nsp;
    //                                       s#sp.s#fld ⟨0⟩= s#rv; #c}\endmodality(post))
    //         \heuristics(simplify_prog)
    //     };
    //     taclet                                ⟨0⟩
    //     storageFieldAddAssign_unfold_leftFst  +
    //     storageFieldSubAssign_unfold_leftFst  -
    //     storageFieldMulAssign_unfold_leftFst  *
    //     storageFieldDivAssign_unfold_leftFst  /
    //     storageFieldModAssign_unfold_leftFst  %
    storageFieldAddAssign_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program Field fld;
        \schemaVar \program SimpleExpression[primitive] se;
        \schemaVar \program Variable rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.s#fld += s#se; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, se), \newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#rvType s#rv = s#se;
                                      s#aliasType storage s#sp = s#nsp;
                                      s#sp.s#fld += s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // generalization:
    //     storageIndex⟨name⟩Assign_unfold_leftFst {
    //         \schemaVar \formula post;
    //         \schemaVar \program Path[storage,complex] nsp;
