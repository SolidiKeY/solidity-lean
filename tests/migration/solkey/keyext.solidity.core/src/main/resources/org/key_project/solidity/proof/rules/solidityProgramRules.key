    //         \heuristics(simplify_prog)
    //     };
    //     taclet                   ⟨0⟩  ⟨1⟩
    //     localAssignPreincrement  ++   +
    //     localAssignPredecrement  --   -
    localAssignPreincrement {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program Variable lv;

        \find(\modality{#mod}{c# s#v = ++s#lv; #c}\endmodality(post))
        \replacewith({lv := lv + 1} {v := lv}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ── pre-decrement on local value variable ───────────────────────────────
    // `--lv` evaluates to the new (decremented) value of lv.

    localDeclPredecrement {
        \schemaVar \formula post;
        \schemaVar \program Variable pv;
        \schemaVar \program Variable lv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#pvType s#pv = --s#lv; #c}\endmodality(post))
        \replacewith({pv := lv - 1} {lv := lv - 1}
            \modality{#mod}{c# #c}\endmodality(post))
        \addprogvars(pv)
        \heuristics(simplify_prog)
    };

    // Resolve the assignment form `v = --lv` where both are local value variables.
    localAssignPredecrement {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program Variable lv;

        \find(\modality{#mod}{c# s#v = --s#lv; #c}\endmodality(post))
        \replacewith({lv := lv - 1} {v := lv}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ── post-increment on local value variable ──────────────────────────────
    // `lv++` evaluates to the old value of lv, then increments lv.

    // generalization:
    //     localDecl⟨name⟩ {
    //         \schemaVar \formula post;
    //         \schemaVar \program Variable pv;
    //         \schemaVar \program Variable lv;
    //         \schemaVar \program Type pvType;
    //         \find(\modality{#mod}{c# s#pvType s#pv = s#lv⟨0⟩; #c}\endmodality(post))
    //         \replacewith({pv := lv} {lv := lv ⟨1⟩ 1}
