    //             \else(\modality{#mod}{c# revert(); #c}\endmodality(post)))
    //         \heuristics(simplify_prog)
    //     };
    //     taclet              ⟨0⟩  ⟨1⟩
    //     divisionAssignment  /    sdiv
    //     moduloAssignment    %    smod
    divisionAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;

        \find(\modality{#mod}{c# s#v = s#se1 / s#se2; #c}\endmodality(post))
        \replacewith(\if(se2 != 0)
            \then({v := sdiv(se1, se2)}\modality{#mod}{c# #c}\endmodality(post))
            \else(\modality{#mod}{c# revert(); #c}\endmodality(post)))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
