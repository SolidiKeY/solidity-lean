        \schemaVar \program SimpleExpression se2;

        \find(\modality{#mod}{c# s#v = s#se1 <= s#se2; #c}\endmodality(post))
        \replacewith({v := \if(leq(se1, se2))\then(TRUE)\else(FALSE)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // --- greater-or-equal (>=) ---
    greaterEqualCaptureLhs {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Variable pv1;
        \schemaVar \program Type pv1Type;
        \schemaVar \program Variable pv2;
        \schemaVar \program Type pv2Type;

        \find(\modality{#mod}{c# s#v = s#nse >= s#se; #c}\endmodality(post))
        \varcond(\newTypeOf(pv1, nse), \newTypeOf(pv2, nse))
        \replacewith(\modality{#mod}{c# s#pv1Type s#pv1 = s#se;
                                      s#pv2Type s#pv2 = s#nse;
                                      s#v = s#pv2 >= s#pv1; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    greaterEqualCaptureRhs {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program Expression e;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#v = s#e >= s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#v = s#e >= s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    greaterEqualAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;

        \find(\modality{#mod}{c# s#v = s#se1 >= s#se2; #c}\endmodality(post))
        \replacewith({v := \if(geq(se1, se2))\then(TRUE)\else(FALSE)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ── logical operators (&&, ||, !) ───────────────────────────────────────

    // --- logical and (&&) ---
    logicalAndCaptureLhs {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Expression e;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#v = s#nse && s#e; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#v = s#pv && s#e; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    logicalAndAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;

        \find(\modality{#mod}{c# s#v = s#se1 && s#se2; #c}\endmodality(post))
        \replacewith({v := \if(se1 = TRUE)\then(\if(se2 = TRUE)\then(TRUE)\else(FALSE))\else(FALSE)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    logicalAndShortCircuitRhs {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program NonSimpleExpression nse;

        \find(\modality{#mod}{c# s#v = s#se && s#nse; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# if (s#se) s#v = s#nse; else s#v = false; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // --- logical or (||) ---
    logicalOrCaptureLhs {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Expression e;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#v = s#nse || s#e; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#v = s#pv || s#e; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    logicalOrAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;

        \find(\modality{#mod}{c# s#v = s#se1 || s#se2; #c}\endmodality(post))
        \replacewith({v := \if(se1 = TRUE)\then(TRUE)\else(\if(se2 = TRUE)\then(TRUE)\else(FALSE))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    logicalOrShortCircuitRhs {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program NonSimpleExpression nse;

        \find(\modality{#mod}{c# s#v = s#se || s#nse; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# if (s#se) s#v = true; else s#v = s#nse; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // --- logical not (!) ---
    logicalNotCapture {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#v = !s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#v = !s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    logicalNotAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#v = !s#se; #c}\endmodality(post))
        \replacewith({v := \if(se = TRUE)\then(FALSE)\else(TRUE)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ── conditional operator (?:) ───────────────────────────────────────────

    ternaryCaptureCond {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Expression thenExpr;
        \schemaVar \program Expression elseExpr;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#v = s#nse ? s#thenExpr : s#elseExpr; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#v = s#pv ? s#thenExpr : s#elseExpr; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    ternaryToIf {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Expression thenExpr;
        \schemaVar \program Expression elseExpr;

        \find(\modality{#mod}{c# s#v = s#se ? s#thenExpr : s#elseExpr; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# if (s#se) s#v = s#thenExpr; else s#v = s#elseExpr; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // The twin of ternaryToIf for a storage-path target, which is not a Variable.
    ternaryToIfStorage {
        \schemaVar \formula post;
        \schemaVar \program Path[storage] path;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Expression thenExpr;
        \schemaVar \program Expression elseExpr;

        \find(\modality{#mod}{c# s#path = s#se ? s#thenExpr : s#elseExpr; #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# if (s#se) s#path = s#thenExpr; else s#path = s#elseExpr; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ── if / if-else statements ─────────────────────────────────────────────

    ifUnfold {
        \schemaVar \formula post;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Statement thenStm;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# if (s#nse) s#thenStm #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      if (s#pv) s#thenStm #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    ifElseUnfold {
        \schemaVar \formula post;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Statement thenStm;
        \schemaVar \program Statement elseStm;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# if (s#nse) s#thenStm else s#elseStm #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      if (s#pv) s#thenStm else s#elseStm #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    ifTrue {
        \schemaVar \formula post;
        \schemaVar \program Statement thenStm;

        \find(\modality{#mod}{c# if (true) s#thenStm #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#thenStm #c}\endmodality(post))
        \heuristics(concrete_solidity)
    };

    ifFalse {
        \schemaVar \formula post;
        \schemaVar \program Statement thenStm;

        \find(\modality{#mod}{c# if (false) s#thenStm #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# #c}\endmodality(post))
        \heuristics(concrete_solidity)
    };

    ifElseTrue {
        \schemaVar \formula post;
        \schemaVar \program Statement thenStm;
        \schemaVar \program Statement elseStm;

        \find(\modality{#mod}{c# if (true) s#thenStm else s#elseStm #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#thenStm #c}\endmodality(post))
        \heuristics(concrete_solidity)
    };

    ifElseFalse {
        \schemaVar \formula post;
        \schemaVar \program Statement thenStm;
        \schemaVar \program Statement elseStm;

        \find(\modality{#mod}{c# if (false) s#thenStm else s#elseStm #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# s#elseStm #c}\endmodality(post))
        \heuristics(concrete_solidity)
    };

    // Swapping the branches beats capturing the negation into a fresh variable,
    // which is what ifElseUnfold would otherwise do with the NonSimpleExpression `!se`.
    ifElseNegated {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Statement thenStm;
        \schemaVar \program Statement elseStm;

        \find(\modality{#mod}{c# if (!s#se) s#thenStm else s#elseStm #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# if (s#se) s#elseStm else s#thenStm #c}\endmodality(post))
        \heuristics(concrete_solidity)
    };

    ifSplit {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Statement thenStm;

        \find( ==> \modality{#mod}{c# if (s#se) s#thenStm #c}\endmodality(post))
        "if s#se true":
            \replacewith( ==> \modality{#mod}{c# s#thenStm #c}\endmodality(post))
            \add(se = TRUE ==>);
        "if s#se false":
            \replacewith( ==> \modality{#mod}{c# #c}\endmodality(post))
            \add(se = FALSE ==>)
        \heuristics(simplify_prog)
    };

    ifElseSplit {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Statement thenStm;
        \schemaVar \program Statement elseStm;

        \find( ==> \modality{#mod}{c# if (s#se) s#thenStm else s#elseStm #c}\endmodality(post))
        "if s#se true":
            \replacewith( ==> \modality{#mod}{c# s#thenStm #c}\endmodality(post))
            \add(se = TRUE ==>);
        "if s#se false":
            \replacewith( ==> \modality{#mod}{c# s#elseStm #c}\endmodality(post))
            \add(se = FALSE ==>)
        \heuristics(simplify_prog)
    };

    // ── while loops ─────────────────────────────────────────────────────────

    whileUnwind {
        \schemaVar \formula post;
        \schemaVar \program Expression cond;
        \schemaVar \program Statement body;

        \find(\modality{#mod}{c# while (s#cond) s#body #c}\endmodality(post))
        \replacewith(\modality{#mod}{c# if (s#cond) { s#body while (s#cond) s#body } #c}\endmodality(post))
        \heuristics(loop_expand)
    };

    whileInvariantBox {
        \schemaVar \formula post;
        \schemaVar \formula inv;
        \schemaVar \program Expression cond;
        \schemaVar \program Statement body;
        \schemaVar \program Variable b;
        \schemaVar \program Type bType;

        \find(\modality{#box}{c# while (s#cond) s#body #c}\endmodality(post))
        \varcond(\newTypeOf(b, cond))
        \varcond(\getInvariant(cond, body, inv))
        "invariant initially valid":
            \replacewith(inv);
        "invariant preserved and used":
            \replacewith(#loopAnon(\modality{#box}{ s#body }\endmodality(true),
                inv -> \modality{#box}{ s#bType s#b = s#cond; }\endmodality(
                    (b = TRUE -> \modality{#box}{ s#body }\endmodality(inv))
                  & (b = FALSE -> \modality{#box}{c# #c}\endmodality(post)))))
        \heuristics(loop_inv)
    };

    whileInvariantDiamond {
        \schemaVar \formula post;
        \schemaVar \formula inv;
        \schemaVar \term int dec;
        \schemaVar \skolemTerm int variant;
        \schemaVar \program Expression cond;
        \schemaVar \program Statement body;
        \schemaVar \program Variable b;
        \schemaVar \program Type bType;

        \find(\modality{#diamond}{c# while (s#cond) s#body #c}\endmodality(post))
        \varcond(\newTypeOf(b, cond))
        \varcond(\getInvariant(cond, body, inv))
        \varcond(\getVariant(cond, body, dec))
        "invariant initially valid":
            \replacewith(inv);
        "invariant preserved and used":
            \replacewith(#loopAnon(\modality{#diamond}{ s#body }\endmodality(true),
                inv & dec = variant -> \modality{#diamond}{ s#bType s#b = s#cond; }\endmodality(
                    (b = TRUE -> \modality{#diamond}{ s#body }\endmodality(
                        inv & \modality{#diamond}{ s#b = s#cond; }\endmodality(
                            b = TRUE -> 0 <= dec & dec < variant)))
                  & (b = FALSE -> \modality{#diamond}{c# #c}\endmodality(post)))))
        \heuristics(loop_inv)
    };

    // ── unary minus (-x) ────────────────────────────────────────────────────

    unaryMinusCapture {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#v = -s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#v = -s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    unaryMinusAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#v = -s#se; #c}\endmodality(post))
        \replacewith({v := -se}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    assertSimple {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# assert(s#se); #c}\endmodality(post))
        "Holds":
            \replacewith(\modality{#mod}{c# #c}\endmodality(post))
            \add(se = TRUE ==>);
        "Violated":
            \replacewith(se = TRUE)
        \heuristics(simplify_prog)
    };

    requireConditionCapture {
        \schemaVar \formula post;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;
        \schemaVar \program NonSimpleExpression nse;

        \find(\modality{#mod}{c# require(s#nse); #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      require(s#pv); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    requireSimple {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# require(s#se); #c}\endmodality(post))
        "Holds":
            \replacewith(se = FALSE | \modality{#mod}{c# #c}\endmodality(post));
        "Reverts":
            \replacewith(se = TRUE | \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for address payments: sadr.transfer(se) (docs/net.md)
    // ------------------------------------------------------------------------

    transfer_unfold_leftFstReceiver {
        \schemaVar \formula post;
        \schemaVar \program NonSimpleExpression nadr;
        \schemaVar \program Expression e;
        \schemaVar \program Variable sadr;
        \schemaVar \program Type sadrType;

        \find(\modality{#mod}{c# s#nadr.transfer(s#e); #c}\endmodality(post))
        \varcond(\newTypeOf(sadr, nadr))
        \replacewith(\modality{#mod}{c# s#sadrType s#sadr = s#nadr;
                                      s#sadr.transfer(s#e); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    transfer_unfold_rightSndArgument {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression[primitive] sadr;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable se;
        \schemaVar \program Type seType;

        \find(\modality{#mod}{c# s#sadr.transfer(s#nse); #c}\endmodality(post))
        \varcond(\newTypeOf(se, nse))
        \replacewith(\modality{#mod}{c# s#seType s#se = s#nse;
                                      s#sadr.transfer(s#se); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for address payments: pv = sadr.send(se) (docs/net.md)
    // ------------------------------------------------------------------------

    send_unfold_leftFstReceiver {
        \schemaVar \formula post;
        \schemaVar \program Variable pv;
        \schemaVar \program NonSimpleExpression nadr;
        \schemaVar \program Expression e;
        \schemaVar \program Variable sadr;
        \schemaVar \program Type sadrType;

        \find(\modality{#mod}{c# s#pv = s#nadr.send(s#e); #c}\endmodality(post))
        \varcond(\newTypeOf(sadr, nadr))
        \replacewith(\modality{#mod}{c# s#sadrType s#sadr = s#nadr;
                                      s#pv = s#sadr.send(s#e); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    send_unfold_rightSndArgument {
        \schemaVar \formula post;
        \schemaVar \program Variable pv;
        \schemaVar \program SimpleExpression[primitive] sadr;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable se;
        \schemaVar \program Type seType;

        \find(\modality{#mod}{c# s#pv = s#sadr.send(s#nse); #c}\endmodality(post))
        \varcond(\newTypeOf(se, nse))
        \replacewith(\modality{#mod}{c# s#seType s#se = s#nse;
                                      s#pv = s#sadr.send(s#se); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Index-write capture: `recv[idx] = rhs`
    // ------------------------------------------------------------------------

    // generalization:
    //     ⟨name⟩ {
    //         \schemaVar \formula post;
    //         \schemaVar \program Path[⟨0⟩,⟨1⟩] p;
    //         \schemaVar \program ⟨2⟩ ie;
    //         \schemaVar \program Expression[primitive] e;
    //         \schemaVar \program Variable rv;
    //         \schemaVar \program Type rvType;
    //         \schemaVar \program Variable[⟨0⟩] ⟨3⟩;
    //         \schemaVar \program Type aliasType;
    //         \schemaVar \program Variable pv;
    //         \schemaVar \program Type pvType;
    //         \find(\modality{#mod}{c# s#p[s#ie] = s#e; #c}\endmodality(post))
    //         \varcond(\newTypeOf(rv, e), \newTypeOf(⟨3⟩, p), \newTypeOf(pv, ie))
    //         \replacewith(\modality{#mod}{c# s#rvType s#rv = s#e;
    //                                       s#aliasType ⟨0⟩ s#⟨3⟩ = s#p;
    //                                       s#pvType s#pv = s#ie;
    //                                       s#⟨3⟩[s#pv] = s#rv; #c}\endmodality(post))
    //         \heuristics(simplify_prog)
    //     };
    //     taclet                                     ⟨0⟩      ⟨1⟩      ⟨2⟩                  ⟨3⟩
    //     storageIndexWriteCaptureAllComplexRecv     storage  complex  Expression           sp
    //     storageIndexWriteCaptureAllNonSimpleIndex  storage  simple   NonSimpleExpression  sp
    //     memoryIndexWriteCaptureAllComplexRecv      memory   complex  Expression           mv
    //     memoryIndexWriteCaptureAllNonSimpleIndex   memory   simple   NonSimpleExpression  mv

    storageIndexWriteCaptureAllComplexRecv {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] p;
        \schemaVar \program Expression ie;
        \schemaVar \program Expression[primitive] e;
        \schemaVar \program Variable rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#p[s#ie] = s#e; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, e), \newTypeOf(sp, p), \newTypeOf(pv, ie))
        \replacewith(\modality{#mod}{c# s#rvType s#rv = s#e;
                                      s#aliasType storage s#sp = s#p;
                                      s#pvType s#pv = s#ie;
                                      s#sp[s#pv] = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteCaptureAllNonSimpleIndex {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] p;
        \schemaVar \program NonSimpleExpression ie;
        \schemaVar \program Expression[primitive] e;
        \schemaVar \program Variable rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#p[s#ie] = s#e; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, e), \newTypeOf(sp, p), \newTypeOf(pv, ie))
        \replacewith(\modality{#mod}{c# s#rvType s#rv = s#e;
                                      s#aliasType storage s#sp = s#p;
                                      s#pvType s#pv = s#ie;
                                      s#sp[s#pv] = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryIndexWriteCaptureAllComplexRecv {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,complex] p;
        \schemaVar \program Expression ie;
        \schemaVar \program Expression[primitive] e;
        \schemaVar \program Variable rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#p[s#ie] = s#e; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, e), \newTypeOf(mv, p), \newTypeOf(pv, ie))
        \replacewith(\modality{#mod}{c# s#rvType s#rv = s#e;
                                      s#aliasType memory s#mv = s#p;
                                      s#pvType s#pv = s#ie;
                                      s#mv[s#pv] = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryIndexWriteCaptureAllNonSimpleIndex {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple] p;
        \schemaVar \program NonSimpleExpression ie;
        \schemaVar \program Expression[primitive] e;
        \schemaVar \program Variable rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#p[s#ie] = s#e; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, e), \newTypeOf(mv, p), \newTypeOf(pv, ie))
        \replacewith(\modality{#mod}{c# s#rvType s#rv = s#e;
                                      s#aliasType memory s#mv = s#p;
                                      s#pvType s#pv = s#ie;
                                      s#mv[s#pv] = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // generalization:
    //     ⟨name⟩ {
    //         \schemaVar \formula post;
    //         \schemaVar \program Path[⟨0⟩,⟨1⟩] p;
    //         \schemaVar \program ⟨2⟩ ie;
    //         \schemaVar \program Path[⟨3⟩,reference] src;
    //         \schemaVar \program Variable[⟨3⟩] rv;
    //         \schemaVar \program Type rvType;
    //         \schemaVar \program Variable[⟨0⟩] ⟨4⟩;
    //         \schemaVar \program Type aliasType;
    //         \schemaVar \program Variable pv;
    //         \schemaVar \program Type pvType;
    //         \find(\modality{#mod}{c# s#p[s#ie] = s#src; #c}\endmodality(post))
    //         \varcond(\newTypeOf(rv, src), \newTypeOf(⟨4⟩, p), \newTypeOf(pv, ie))
    //         \replacewith(\modality{#mod}{c# s#rvType ⟨3⟩ s#rv = s#src;
    //                                       s#aliasType ⟨0⟩ s#⟨4⟩ = s#p;
    //                                       s#pvType s#pv = s#ie;
    //                                       s#⟨4⟩[s#pv] = s#rv; #c}\endmodality(post))
    //         \heuristics(simplify_prog)
    //     };
    //     taclet                                               ⟨0⟩      ⟨1⟩      ⟨2⟩                  ⟨3⟩      ⟨4⟩
    //     storageIndexWriteStorageRefCaptureAllComplexRecv     storage  complex  Expression           storage  sp
    //     storageIndexWriteStorageRefCaptureAllNonSimpleIndex  storage  simple   NonSimpleExpression  storage  sp
    //     memoryToStorageIndexCaptureAllComplexRecv            storage  complex  Expression           memory   sp
    //     memoryToStorageIndexCaptureAllNonSimpleIndex         storage  simple   NonSimpleExpression  memory   sp
    //     memoryIndexWriteMemRefCaptureAllComplexRecv          memory   complex  Expression           memory   mv
    //     memoryIndexWriteMemRefCaptureAllNonSimpleIndex       memory   simple   NonSimpleExpression  memory   mv

    storageIndexWriteStorageRefCaptureAllComplexRecv {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] p;
        \schemaVar \program Expression ie;
        \schemaVar \program Path[storage,reference] src;
        \schemaVar \program Variable[storage] rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#p[s#ie] = s#src; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, src), \newTypeOf(sp, p), \newTypeOf(pv, ie))
        \replacewith(\modality{#mod}{c# s#rvType storage s#rv = s#src;
                                      s#aliasType storage s#sp = s#p;
                                      s#pvType s#pv = s#ie;
                                      s#sp[s#pv] = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexWriteStorageRefCaptureAllNonSimpleIndex {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] p;
        \schemaVar \program NonSimpleExpression ie;
        \schemaVar \program Path[storage,reference] src;
        \schemaVar \program Variable[storage] rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#p[s#ie] = s#src; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, src), \newTypeOf(sp, p), \newTypeOf(pv, ie))
        \replacewith(\modality{#mod}{c# s#rvType storage s#rv = s#src;
                                      s#aliasType storage s#sp = s#p;
                                      s#pvType s#pv = s#ie;
                                      s#sp[s#pv] = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // keep this
    memoryToStorageIndexCaptureAllComplexRecv {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] p;
        // TODO: Can index be storage or memory?
        \schemaVar \program Expression ie;
        \schemaVar \program Path[memory,reference] src;
        \schemaVar \program Variable[memory] rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#p[s#ie] = s#src; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, src), \newTypeOf(sp, p), \newTypeOf(pv, ie))
        \replacewith(\modality{#mod}{c# s#rvType memory s#rv = s#src;
                                      s#aliasType storage s#sp = s#p;
                                      s#pvType s#pv = s#ie;
                                      s#sp[s#pv] = s#rv; #c}\endmodality(post))
        // TODO: maybe other rules
        // bindRuleSet("simplify_prog_expensive", longConst(someValue + 100))
        // \heuristics(simplify_prog_expensive)
        \heuristics(simplify_prog)
    };

    memoryToStorageIndexCaptureAllNonSimpleIndex {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] p;
        // TODO: Can index be storage or memory?
        \schemaVar \program NonSimpleExpression ie;
        \schemaVar \program Path[memory,reference] src;
        \schemaVar \program Variable[memory] rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#p[s#ie] = s#src; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, src), \newTypeOf(sp, p), \newTypeOf(pv, ie))
        \replacewith(\modality{#mod}{c# s#rvType memory s#rv = s#src;
                                      s#aliasType storage s#sp = s#p;
                                      s#pvType s#pv = s#ie;
                                      s#sp[s#pv] = s#rv; #c}\endmodality(post))
        // TODO: maybe other rules
        // bindRuleSet("simplify_prog_expensive", longConst(someValue + 100))
        // \heuristics(simplify_prog_expensive)
        \heuristics(simplify_prog)
    };

    memoryIndexWriteMemRefCaptureAllComplexRecv {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,complex] p;
        \schemaVar \program Expression ie;
        \schemaVar \program Path[memory,reference] src;
        \schemaVar \program Variable[memory] rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#p[s#ie] = s#src; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, src), \newTypeOf(mv, p), \newTypeOf(pv, ie))
        \replacewith(\modality{#mod}{c# s#rvType memory s#rv = s#src;
                                      s#aliasType memory s#mv = s#p;
                                      s#pvType s#pv = s#ie;
                                      s#mv[s#pv] = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    memoryIndexWriteMemRefCaptureAllNonSimpleIndex {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple] p;
        \schemaVar \program NonSimpleExpression ie;
        \schemaVar \program Path[memory,reference] src;
        \schemaVar \program Variable[memory] rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[memory] mv;
        \schemaVar \program Type aliasType;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#p[s#ie] = s#src; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, src), \newTypeOf(mv, p), \newTypeOf(pv, ie))
        \replacewith(\modality{#mod}{c# s#rvType memory s#rv = s#src;
                                      s#aliasType memory s#mv = s#p;
                                      s#pvType s#pv = s#ie;
                                      s#mv[s#pv] = s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

}

\rules(transferSemantics:noCallback) {

    // Box (partial correctness): an unfunded transfer reverts on the EVM and a
    // reverting run is trivially correct, so the box books the debit
    // unconditionally - no balance check, no revert branch. A transfer to
    // `self` leaves the ledger unchanged.
    transferNoCallbackBox {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression[primitive] sadr;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#box}{c# s#sadr.transfer(s#se); #c}\endmodality(post))
        \replacewith({net := \if(sadr = self) \then(net)
                             \else(storeSt(net, at(sadr),
                                           selectSt<[int]>(net, at(sadr)) - se))}
            \modality{#box}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Diamond (total correctness): a negative amount is unrepresentable in the
    // EVM's unsigned value field, so the diamond owes `0 <= se`.
    transferNoCallbackDiamond {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression[primitive] sadr;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#diamond}{c# s#sadr.transfer(s#se); #c}\endmodality(post))
        "non-negative amount":
            \replacewith(0 <= se);
        "transfer booked":
            \replacewith({net := \if(sadr = self) \then(net)
                                 \else(storeSt(net, at(sadr),
                                               selectSt<[int]>(net, at(sadr)) - se))}
                \modality{#diamond}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    sendNoCallbackBox {
        \schemaVar \formula post;
        \schemaVar \program Variable pv;
        \schemaVar \program SimpleExpression[primitive] sadr;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#box}{c# s#pv = s#sadr.send(s#se); #c}\endmodality(post))
        "send succeeded":
            \replacewith({net := \if(sadr = self) \then(net)
                                 \else(storeSt(net, at(sadr),
                                               selectSt<[int]>(net, at(sadr)) - se))
                          || pv := TRUE}
                \modality{#box}{c# #c}\endmodality(post));
        "send failed":
            \replacewith({pv := FALSE} \modality{#box}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    sendNoCallbackDiamond {
        \schemaVar \formula post;
        \schemaVar \program Variable pv;
        \schemaVar \program SimpleExpression[primitive] sadr;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#diamond}{c# s#pv = s#sadr.send(s#se); #c}\endmodality(post))
        "non-negative amount":
            \replacewith(0 <= se);
        "send succeeded":
            \replacewith({net := \if(sadr = self) \then(net)
                                 \else(storeSt(net, at(sadr),
                                               selectSt<[int]>(net, at(sadr)) - se))
                          || pv := TRUE}
                \modality{#diamond}{c# #c}\endmodality(post));
        "send failed":
            \replacewith({pv := FALSE} \modality{#diamond}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    tryCallNoCallbackBox {
        \schemaVar \formula post;
        \schemaVar \program ExternalCall call;
        \schemaVar \program Statement body;
        \schemaVar \program Statement errorBody;
        \schemaVar \program Statement panicBody;
        \schemaVar \program Statement otherBody;

        \find(\modality{#box}{c# try s#call s#body catch Error s#errorBody
                                 catch Panic s#panicBody catch s#otherBody #c}\endmodality(post))
        "call succeeded":
            \replacewith(\modality{#box}{c# s#body #c}\endmodality(post));
        "Error caught":
            \replacewith(\modality{#box}{c# s#errorBody #c}\endmodality(post));
        "Panic caught":
            \replacewith(\modality{#box}{c# s#panicBody #c}\endmodality(post));
        "other failure caught":
            \replacewith(\modality{#box}{c# s#otherBody #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

}

\rules(transferSemantics:withCallback) {

    transferWithCallbackBox {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression[primitive] sadr;
        \schemaVar \program SimpleExpression[primitive] se;
        \schemaVar \skolemTerm Struct storageSk;
        \schemaVar \skolemTerm Struct netSk;

        \find(\modality{#box}{c# s#sadr.transfer(s#se); #c}\endmodality(post))
        "invariant on exit":
            \replacewith({net := \if(sadr = self) \then(net)
                                 \else(storeSt(net, at(sadr),
                                               selectSt<[int]>(net, at(sadr)) - se))}
                CInv(storage, net));
        "resume after callback":
            \replacewith({storage := storageSk || net := netSk}
                (CInv(storage, net) -> \modality{#box}{c# #c}\endmodality(post)))
        \heuristics(simplify_prog)
    };

    transferWithCallbackDiamond {
        \schemaVar \formula post;
        \schemaVar \program SimpleExpression[primitive] sadr;
        \schemaVar \program SimpleExpression[primitive] se;
        \schemaVar \skolemTerm Struct storageSk;
        \schemaVar \skolemTerm Struct netSk;

        \find(\modality{#diamond}{c# s#sadr.transfer(s#se); #c}\endmodality(post))
        "non-negative amount":
            \replacewith(0 <= se);
        "invariant on exit":
            \replacewith(0 <= se
                -> {net := \if(sadr = self) \then(net)
                           \else(storeSt(net, at(sadr),
                                         selectSt<[int]>(net, at(sadr)) - se))}
                   CInv(storage, net));
        "resume after callback":
            \replacewith(0 <= se
                -> {storage := storageSk || net := netSk}
                   (CInv(storage, net) -> \modality{#diamond}{c# #c}\endmodality(post)))
        \heuristics(simplify_prog)
    };

    sendWithCallbackBox {
        \schemaVar \formula post;
        \schemaVar \program Variable pv;
        \schemaVar \program SimpleExpression[primitive] sadr;
        \schemaVar \program SimpleExpression[primitive] se;
        \schemaVar \skolemTerm Struct storageSk;
        \schemaVar \skolemTerm Struct netSk;

        \find(\modality{#box}{c# s#pv = s#sadr.send(s#se); #c}\endmodality(post))
        "invariant on exit":
            \replacewith({net := \if(sadr = self) \then(net)
                                 \else(storeSt(net, at(sadr),
                                               selectSt<[int]>(net, at(sadr)) - se))}
                CInv(storage, net));
        "send succeeded":
            \replacewith({storage := storageSk || net := netSk || pv := TRUE}
                (CInv(storage, net) -> \modality{#box}{c# #c}\endmodality(post)));
        "send failed":
            \replacewith({pv := FALSE} \modality{#box}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    sendWithCallbackDiamond {
        \schemaVar \formula post;
        \schemaVar \program Variable pv;
        \schemaVar \program SimpleExpression[primitive] sadr;
        \schemaVar \program SimpleExpression[primitive] se;
        \schemaVar \skolemTerm Struct storageSk;
        \schemaVar \skolemTerm Struct netSk;

        \find(\modality{#diamond}{c# s#pv = s#sadr.send(s#se); #c}\endmodality(post))
        "non-negative amount":
            \replacewith(0 <= se);
        "invariant on exit":
            \replacewith(0 <= se
                -> {net := \if(sadr = self) \then(net)
                           \else(storeSt(net, at(sadr),
                                         selectSt<[int]>(net, at(sadr)) - se))}
                   CInv(storage, net));
        "send succeeded":
            \replacewith(0 <= se
                -> {storage := storageSk || net := netSk || pv := TRUE}
                   (CInv(storage, net) -> \modality{#diamond}{c# #c}\endmodality(post)));
        "send failed":
            \replacewith({pv := FALSE} \modality{#diamond}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    tryCallWithCallbackBox {
        \schemaVar \formula post;
        \schemaVar \program ExternalCall call;
        \schemaVar \program Statement body;
        \schemaVar \program Statement errorBody;
        \schemaVar \program Statement panicBody;
        \schemaVar \program Statement otherBody;
        \schemaVar \skolemTerm Struct storageSk;
        \schemaVar \skolemTerm Struct netSk;

        \find(\modality{#box}{c# try s#call s#body catch Error s#errorBody
                                 catch Panic s#panicBody catch s#otherBody #c}\endmodality(post))
        "invariant on exit":
            \replacewith(CInv(storage, net));
        "call succeeded":
            \replacewith({storage := storageSk || net := netSk}
                (CInv(storage, net) -> \modality{#box}{c# s#body #c}\endmodality(post)));
        "Error caught":
            \replacewith(\modality{#box}{c# s#errorBody #c}\endmodality(post));
        "Panic caught":
            \replacewith(\modality{#box}{c# s#panicBody #c}\endmodality(post));
        "other failure caught":
            \replacewith(\modality{#box}{c# s#otherBody #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

}
