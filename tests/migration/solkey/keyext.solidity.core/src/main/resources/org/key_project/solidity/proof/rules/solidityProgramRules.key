        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v = s#mv.s#fld++; #c}\endmodality(post))
        \replacewith({v := read<[int]>(memory, mv, fld)}
            {memory := write(memory, mv, fld,
                read<[int]>(memory, mv, fld) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
