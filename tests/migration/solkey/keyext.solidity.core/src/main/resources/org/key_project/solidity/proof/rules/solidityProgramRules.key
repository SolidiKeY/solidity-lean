        \schemaVar \program Variable lv;

        \find(\modality{#mod}{c# s#lv--; #c}\endmodality(post))
        \replacewith({lv := lv - 1}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ── compound assignment on a local ──────────────────────────────────────
    // The twins of storageRoot{Add,Sub,Mul,Div,Mod}Assign for a local target;
    // `/=` and `%=` carry the same zero-denominator revert branch.

    // generalization:
    //     local⟨name⟩Assign {
    //         \schemaVar \formula post;
    //         \schemaVar \program Variable lv;
    //         \schemaVar \program SimpleExpression[primitive] se;
    //         \find(\modality{#mod}{c# s#lv ⟨0⟩= s#se; #c}\endmodality(post))
    //         \replacewith({lv := lv ⟨0⟩ se}
    //             \modality{#mod}{c# #c}\endmodality(post))
    //         \heuristics(simplify_prog)
    //     };
    //     taclet          ⟨0⟩
    //     localAddAssign  +
    //     localSubAssign  -
    //     localMulAssign  *
    localAddAssign {
        \schemaVar \formula post;
        \schemaVar \program Variable lv;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#lv += s#se; #c}\endmodality(post))
        \replacewith({lv := lv + se}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    localSubAssign {
        \schemaVar \formula post;
        \schemaVar \program Variable lv;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#lv -= s#se; #c}\endmodality(post))
        \replacewith({lv := lv - se}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    localMulAssign {
        \schemaVar \formula post;
        \schemaVar \program Variable lv;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#lv *= s#se; #c}\endmodality(post))
        \replacewith({lv := lv * se}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // generalization:
    //     local⟨name⟩Assign {
    //         \schemaVar \formula post;
    //         \schemaVar \program Variable lv;
    //         \schemaVar \program SimpleExpression[primitive] se;
    //         \find(\modality{#mod}{c# s#lv ⟨0⟩= s#se; #c}\endmodality(post))
    //         \replacewith(\if(se != 0)
    //             \then({lv := ⟨1⟩(lv, se)}
    //                 \modality{#mod}{c# #c}\endmodality(post))
    //             \else(\modality{#mod}{c# revert(); #c}\endmodality(post)))
    //         \heuristics(simplify_prog)
    //     };
    //     taclet          ⟨0⟩  ⟨1⟩
    //     localDivAssign  /    sdiv
    //     localModAssign  %    smod
    localDivAssign {
        \schemaVar \formula post;
        \schemaVar \program Variable lv;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#lv /= s#se; #c}\endmodality(post))
        \replacewith(\if(se != 0)
            \then({lv := sdiv(lv, se)}
                \modality{#mod}{c# #c}\endmodality(post))
            \else(\modality{#mod}{c# revert(); #c}\endmodality(post)))
        \heuristics(simplify_prog)
    };

    localModAssign {
        \schemaVar \formula post;
        \schemaVar \program Variable lv;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#lv %= s#se; #c}\endmodality(post))
        \replacewith(\if(se != 0)
            \then({lv := smod(lv, se)}
                \modality{#mod}{c# #c}\endmodality(post))
            \else(\modality{#mod}{c# revert(); #c}\endmodality(post)))
        \heuristics(simplify_prog)
    };

    // ── non-simple right-hand side of a compound assignment ─────────────────
    // Location-neutral like fieldWriteValueRhsCapture: the target may be a
    // local or a storage path at any depth, since only the RHS is rewritten.

    // generalization:
    //     ⟨name⟩AssignValueRhsCapture {
    //         \schemaVar \formula post;
    //         \schemaVar \program Expression lhs;
    //         \schemaVar \program NonSimpleExpression[primitive] nse;
    //         \schemaVar \program Variable pv;
    //         \schemaVar \program Type pvType;
    //         \find(\modality{#mod}{c# s#lhs ⟨0⟩= s#nse; #c}\endmodality(post))
    //         \varcond(\newTypeOf(pv, nse))
    //         \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
    //                                       s#lhs ⟨0⟩= s#pv; #c}\endmodality(post))
    //         \heuristics(simplify_prog)
    //     };
    //     taclet                    ⟨0⟩
    //     addAssignValueRhsCapture  +
    //     subAssignValueRhsCapture  -
    //     mulAssignValueRhsCapture  *
    //     divAssignValueRhsCapture  /
    //     modAssignValueRhsCapture  %
    addAssignValueRhsCapture {
        \schemaVar \formula post;
        \schemaVar \program Expression lhs;
        \schemaVar \program NonSimpleExpression[primitive] nse;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#lhs += s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, nse))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#lhs += s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

