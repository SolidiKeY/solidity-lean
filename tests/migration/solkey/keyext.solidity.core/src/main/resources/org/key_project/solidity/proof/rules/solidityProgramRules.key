    // ------------------------------------------------------------------------
    // ----------- Rules for memory increment and decrement operators
    // ------------------------------------------------------------------------

    // generalization:
    //     memoryField⟨name⟩ {
    //         \schemaVar \formula post;
    //         \schemaVar \program Path[memory,simple] mv;
    //         \schemaVar \program Field fld;
    //         \find(\modality{#mod}{c# ⟨0⟩; #c}\endmodality(post))
    //         \replacewith({memory := write(memory, mv, fld,
    //                 read<[int]>(memory, mv, fld) ⟨1⟩ 1)}
    //             \modality{#mod}{c# #c}\endmodality(post))
    //         \heuristics(simplify_expression)
    //     };
    //     taclet                    ⟨0⟩           ⟨1⟩
    //     memoryFieldPreincrement   ++s#mv.s#fld  +
    //     memoryFieldPostincrement  s#mv.s#fld++  +
    //     memoryFieldPredecrement   --s#mv.s#fld  -
    //     memoryFieldPostdecrement  s#mv.s#fld--  -
    memoryFieldPreincrement {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field fld;

        \find(\modality{#mod}{c# ++s#mv.s#fld; #c}\endmodality(post))
        \replacewith({memory := write(memory, mv, fld,
                read<[int]>(memory, mv, fld) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    memoryFieldPostincrement {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field fld;

        \find(\modality{#mod}{c# s#mv.s#fld++; #c}\endmodality(post))
        \replacewith({memory := write(memory, mv, fld,
                read<[int]>(memory, mv, fld) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    memoryFieldPredecrement {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field fld;

        \find(\modality{#mod}{c# --s#mv.s#fld; #c}\endmodality(post))
        \replacewith({memory := write(memory, mv, fld,
                read<[int]>(memory, mv, fld) - 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    memoryFieldPostdecrement {
