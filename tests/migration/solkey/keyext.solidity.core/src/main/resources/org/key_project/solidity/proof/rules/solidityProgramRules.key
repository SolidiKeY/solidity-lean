    memoryIndexArraySubAssign {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple,array] mv;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#mv[s#ie] -= s#se; #c}\endmodality(post))
        \sameUpdateLevel
        "inBounds":
            \replacewith({memory := write(memory, mv, at(ie),
                    read<[int]>(memory, mv, at(ie)) - se)}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(0 <= ie & ie < read<[int]>(memory, mv, size) ==>);
        "outOfBounds":
