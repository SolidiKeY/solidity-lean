    // ------------------------------------------------------------------------
    // ----------- Unfold rules for complex paths in increment/decrement
    // ------------------------------------------------------------------------

    // Unfold pre-increment on complex field path: ++nsp.fld;
    // generalization:
    //     storageField⟨name⟩_unfold_leftFst {
    //         \schemaVar \formula post;
    //         \schemaVar \program Path[storage,complex] nsp;
    //         \schemaVar \program Field fld;
    //         \schemaVar \program Variable[storage] sp;
    //         \schemaVar \program Type aliasType;
    //         \find(\modality{#mod}{c# ⟨0⟩; #c}\endmodality(post))
    //         \varcond(\newTypeOf(sp, nsp))
    //         \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
    //                                       ⟨1⟩; #c}\endmodality(post))
    //         \heuristics(simplify_prog)
    //     };
    //     taclet                                    ⟨0⟩            ⟨1⟩
    //     storageFieldPreincrement_unfold_leftFst   ++s#nsp.s#fld  ++s#sp.s#fld
    //     storageFieldPostincrement_unfold_leftFst  s#nsp.s#fld++  s#sp.s#fld++
    //     storageFieldPredecrement_unfold_leftFst   --s#nsp.s#fld  --s#sp.s#fld
    //     storageFieldPostdecrement_unfold_leftFst  s#nsp.s#fld--  s#sp.s#fld--
    storageFieldPreincrement_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program Field fld;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# ++s#nsp.s#fld; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      ++s#sp.s#fld; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Unfold post-increment on complex field path: nsp.fld++;
    storageFieldPostincrement_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program Field fld;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp.s#fld++; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      s#sp.s#fld++; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

