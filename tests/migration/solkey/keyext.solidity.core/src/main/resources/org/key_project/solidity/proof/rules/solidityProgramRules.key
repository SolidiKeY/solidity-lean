    //         "outOfBounds":
    //             \replacewith(\modality{#mod}{c# revert(); #c}\endmodality(post))
    //             \add( ==> 0 <= ie & ie < read<[int]>(memory, mv, size))
    //         \heuristics(simplify_expression)
    //     };
    //     taclet                                   ⟨0⟩  ⟨1⟩
    //     memoryIndexArrayPostincrementAssignment  ++   +
    //     memoryIndexArrayPostdecrementAssignment  --   -
    memoryIndexArrayPostincrementAssignment {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple,array] mv;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v = s#mv[s#ie]++; #c}\endmodality(post))
        \sameUpdateLevel
        "inBounds":
            \replacewith({v := read<[int]>(memory, mv, at(ie))}
                {memory := write(memory, mv, at(ie),
                    read<[int]>(memory, mv, at(ie)) + 1)}
                \modality{#mod}{c# #c}\endmodality(post))
            \add(0 <= ie & ie < read<[int]>(memory, mv, size) ==>);
        "outOfBounds":
            \replacewith(\modality{#mod}{c# revert(); #c}\endmodality(post))
            \add( ==> 0 <= ie & ie < read<[int]>(memory, mv, size))
        \heuristics(simplify_expression)
