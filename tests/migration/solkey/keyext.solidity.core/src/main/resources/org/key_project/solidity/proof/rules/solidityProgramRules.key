                                      s#sp.s#fld %= s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageIndexModAssign_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program SimpleExpression[primitive] se;
        \schemaVar \program Variable rv;
        \schemaVar \program Type rvType;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# s#nsp[s#ie] %= s#se; #c}\endmodality(post))
        \varcond(\newTypeOf(rv, se), \newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#rvType s#rv = s#se;
                                      s#aliasType storage s#sp = s#nsp;
                                      s#sp[s#ie] %= s#rv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    storageFieldModAssign {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \program Field fld;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#sp.s#fld %= s#se; #c}\endmodality(post))
        \replacewith(\if(se != 0)
            \then({storage := save(storage, consr(sp, fld),
                    smod(find<[int]>(storage, consr(sp, fld)), se))}
                \modality{#mod}{c# #c}\endmodality(post))
            \else(\modality{#mod}{c# revert(); #c}\endmodality(post)))
        \heuristics(simplify_expression)
    };

    storageIndexMappingModAssign {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,mapping] sp;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#sp[s#ie] %= s#se; #c}\endmodality(post))
        \replacewith(\if(se != 0)
            \then({storage := save(storage, consr(sp, at(ie)),
                    smod(find<[int]>(storage, consr(sp, at(ie))), se))}
                \modality{#mod}{c# #c}\endmodality(post))
            \else(\modality{#mod}{c# revert(); #c}\endmodality(post)))
        \heuristics(simplify_expression)
    };

    storageIndexArrayModAssign {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp;
        \schemaVar \program SimpleExpression ie;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#sp[s#ie] %= s#se; #c}\endmodality(post))
        "inBounds":
            \replacewith(0 <= ie & ie < find<[int]>(storage, consr(sp, size))
                -> \if(se != 0)
                    \then({storage := save(storage, consr(sp, at(ie)),
                            smod(find<[int]>(storage, consr(sp, at(ie))), se))}
                        \modality{#mod}{c# #c}\endmodality(post))
                    \else(\modality{#mod}{c# revert(); #c}\endmodality(post)));
        "outOfBounds":
            \replacewith(!(0 <= ie & ie < find<[int]>(storage, consr(sp, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for `delete` (storage, primitive targets) -------------
    // ------------------------------------------------------------------------

    // delete sp;  -- save the storage path type's default value.
    storageRootDelete {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;

        \find(\modality{#mod}{c# delete s#gsp; #c}\endmodality(post))
        \replacewith({storage := delAt(storage, gsp)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // delete sp.fld;  -- field write of the field's default value
    storageFieldDelete {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple] sp;
        \schemaVar \program Field fld;

        \find(\modality{#mod}{c# delete s#sp.s#fld; #c}\endmodality(post))
        \replacewith({storage := delAt(storage, consr(sp, fld))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // delete sp[ie];  -- reset the element/value in place; a struct there
    // keeps its mapping members, like the root and field deletes.
    storageIndexDelete {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,mapping] sp;
        \schemaVar \program SimpleExpression ie;

        \find(\modality{#mod}{c# delete s#sp[s#ie]; #c}\endmodality(post))
        \replacewith({storage := delAt(storage, consr(sp, at(ie)))}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    storageIndexArrayDelete {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,array] sp;
        \schemaVar \program SimpleExpression ie;

        \find(\modality{#mod}{c# delete s#sp[s#ie]; #c}\endmodality(post))
        "inBounds":
            \replacewith(0 <= ie & ie < find<[int]>(storage, consr(sp, size))
                -> {storage := delAt(storage, consr(sp, at(ie)))}
                    \modality{#mod}{c# #c}\endmodality(post));
        "outOfBounds":
            \replacewith(!(0 <= ie & ie < find<[int]>(storage, consr(sp, size)))
                -> \modality{#mod}{c# revert(); #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // delete nsp.fld; with a complex receiver -- alias the receiver.
    storageFieldDelete_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program Field fld;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# delete s#nsp.s#fld; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      delete s#sp.s#fld; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // delete nsp[ie]; with a complex receiver -- alias the receiver.
    storageIndexDelete_unfold_leftFst {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,complex] nsp;
        \schemaVar \program Expression ie;
        \schemaVar \program Variable[storage] sp;
        \schemaVar \program Type aliasType;

        \find(\modality{#mod}{c# delete s#nsp[s#ie]; #c}\endmodality(post))
        \varcond(\newTypeOf(sp, nsp))
        \replacewith(\modality{#mod}{c# s#aliasType storage s#sp = s#nsp;
                                      delete s#sp[s#ie]; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for prefix and postfix increment and decrement operators
    // ------------------------------------------------------------------------

    // Pre-increment on storage root: ++age;
    // generalization:
    //     storageRoot⟨name⟩ {
    //         \schemaVar \formula post;
    //         \schemaVar \program Path[storage,simple,global] gsp;
    //         \find(\modality{#mod}{c# ⟨0⟩; #c}\endmodality(post))
    //         \replacewith({storage := save(storage, gsp, find<[int]>(storage, gsp) ⟨1⟩ 1)}
    //             \modality{#mod}{c# #c}\endmodality(post))
    //         \heuristics(simplify_expression)
    //     };
    //     taclet                    ⟨0⟩      ⟨1⟩
    //     storageRootPreincrement   ++s#gsp  +
    //     storageRootPostincrement  s#gsp++  +
    //     storageRootPredecrement   --s#gsp  -
    //     storageRootPostdecrement  s#gsp--  -
    storageRootPreincrement {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;

        \find(\modality{#mod}{c# ++s#gsp; #c}\endmodality(post))
        \replacewith({storage := save(storage, gsp, find<[int]>(storage, gsp) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Pre-decrement on storage root: --age;
    storageRootPredecrement {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;

        \find(\modality{#mod}{c# --s#gsp; #c}\endmodality(post))
        \replacewith({storage := save(storage, gsp, find<[int]>(storage, gsp) - 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Post-increment on storage root: age++;
    storageRootPostincrement {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;

        \find(\modality{#mod}{c# s#gsp++; #c}\endmodality(post))
        \replacewith({storage := save(storage, gsp, find<[int]>(storage, gsp) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Post-decrement on storage root: age--;
    storageRootPostdecrement {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;

        \find(\modality{#mod}{c# s#gsp--; #c}\endmodality(post))
        \replacewith({storage := save(storage, gsp, find<[int]>(storage, gsp) - 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Pre-increment assignment on storage root: result = ++age;
    // generalization:
    //     storageRoot⟨name⟩Assignment {
    //         \schemaVar \formula post;
    //         \schemaVar \program Path[storage,simple,global] gsp;
    //         \schemaVar \program Variable v;
    //         \find(\modality{#mod}{c# s#v = ⟨0⟩s#gsp; #c}\endmodality(post))
    //         \replacewith({storage := save(storage, gsp, find<[int]>(storage, gsp) ⟨1⟩ 1)}
    //             {v := find<[int]>(storage, gsp)}
    //             \modality{#mod}{c# #c}\endmodality(post))
    //         \heuristics(simplify_expression)
    //     };
    //     taclet                             ⟨0⟩  ⟨1⟩
    //     storageRootPreincrementAssignment  ++   +
    //     storageRootPredecrementAssignment  --   -
    storageRootPreincrementAssignment {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v = ++s#gsp; #c}\endmodality(post))
        \replacewith({storage := save(storage, gsp, find<[int]>(storage, gsp) + 1)}
            {v := find<[int]>(storage, gsp)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Pre-decrement assignment on storage root: result = --age;
    storageRootPredecrementAssignment {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v = --s#gsp; #c}\endmodality(post))
        \replacewith({storage := save(storage, gsp, find<[int]>(storage, gsp) - 1)}
            {v := find<[int]>(storage, gsp)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Post-increment assignment on storage root: result = age++;
    // generalization:
    //     storageRoot⟨name⟩Assignment {
    //         \schemaVar \formula post;
    //         \schemaVar \program Path[storage,simple,global] gsp;
    //         \schemaVar \program Variable v;
    //         \find(\modality{#mod}{c# s#v = s#gsp⟨0⟩; #c}\endmodality(post))
    //         \replacewith({v := find<[int]>(storage, gsp)}
    //             {storage := save(storage, gsp, find<[int]>(storage, gsp) ⟨1⟩ 1)}
    //             \modality{#mod}{c# #c}\endmodality(post))
    //         \heuristics(simplify_expression)
    //     };
    //     taclet                              ⟨0⟩  ⟨1⟩
    //     storageRootPostincrementAssignment  ++   +
    //     storageRootPostdecrementAssignment  --   -
    storageRootPostincrementAssignment {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v = s#gsp++; #c}\endmodality(post))
        \replacewith({v := find<[int]>(storage, gsp)}
            {storage := save(storage, gsp, find<[int]>(storage, gsp) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // Post-decrement assignment on storage root: result = age--;
    storageRootPostdecrementAssignment {
        \schemaVar \formula post;
        \schemaVar \program Path[storage,simple,global] gsp;
        \schemaVar \program Variable v;

        \find(\modality{#mod}{c# s#v = s#gsp--; #c}\endmodality(post))
        \replacewith({v := find<[int]>(storage, gsp)}
            {storage := save(storage, gsp, find<[int]>(storage, gsp) - 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for addition operator (+)
    // ------------------------------------------------------------------------

    // generalization:
    //     ⟨name⟩_unfold_left {
    //         \schemaVar \formula post;
    //         \schemaVar \program Variable v;
    //         \schemaVar \program NonSimpleExpression nse;
    //         \schemaVar \program SimpleExpression se;
    //         \schemaVar \program Variable pv1;
    //         \schemaVar \program Type pv1Type;
    //         \schemaVar \program Variable pv2;
    //         \schemaVar \program Type pv2Type;
    //         \find(\modality{#mod}{c# s#v = s#nse ⟨0⟩ s#se; #c}\endmodality(post))
    //         \varcond(\newTypeOf(pv1, v), \newTypeOf(pv2, v))
    //         \replacewith(\modality{#mod}{c# s#pv1Type s#pv1 = s#se;
    //                                       s#pv2Type s#pv2 = s#nse;
    //                                       s#v = s#pv2 ⟨0⟩ s#pv1; #c}\endmodality(post))
    //         \heuristics(simplify_prog)
    //     };
    //     taclet                      ⟨0⟩
    //     addition_unfold_left        +
    //     subtraction_unfold_left     -
    //     multiplication_unfold_left  *
    //     power_unfold_left           **
    //     division_unfold_left        /
    //     modulo_unfold_left          %
    addition_unfold_left {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Variable pv1;
        \schemaVar \program Type pv1Type;
        \schemaVar \program Variable pv2;
        \schemaVar \program Type pv2Type;

        \find(\modality{#mod}{c# s#v = s#nse + s#se; #c}\endmodality(post))
        \varcond(\newTypeOf(pv1, v), \newTypeOf(pv2, v))
        \replacewith(\modality{#mod}{c# s#pv1Type s#pv1 = s#se;
                                      s#pv2Type s#pv2 = s#nse;
                                      s#v = s#pv2 + s#pv1; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // generalization:
    //     ⟨name⟩_unfold_right {
    //         \schemaVar \formula post;
    //         \schemaVar \program Variable v;
    //         \schemaVar \program Expression e;
    //         \schemaVar \program NonSimpleExpression nse;
    //         \schemaVar \program Variable pv;
    //         \schemaVar \program Type pvType;
    //         \find(\modality{#mod}{c# s#v = s#e ⟨0⟩ s#nse; #c}\endmodality(post))
    //         \varcond(\newTypeOf(pv, v))
    //         \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
    //                                       s#v = s#e ⟨0⟩ s#pv; #c}\endmodality(post))
    //         \heuristics(simplify_prog)
    //     };
    //     taclet                       ⟨0⟩
    //     addition_unfold_right        +
    //     subtraction_unfold_right     -
    //     multiplication_unfold_right  *
    //     power_unfold_right           **
    //     division_unfold_right        /
    //     modulo_unfold_right          %
    addition_unfold_right {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program Expression e;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#v = s#e + s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, v))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#v = s#e + s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // Assign a simple value (literal or non-storage local) to a local value variable.
    // v = se  =>  { v := se }
    localValueAssign {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression[primitive] se;

        \find(\modality{#mod}{c# s#v = s#se; #c}\endmodality(post))
        \replacewith({v := se}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // generalization:
    //     ⟨name⟩Assignment {
    //         \schemaVar \formula post;
    //         \schemaVar \program Variable v;
    //         \schemaVar \program SimpleExpression se1;
    //         \schemaVar \program SimpleExpression se2;
    //         \find(\modality{#mod}{c# s#v = s#se1 ⟨0⟩ s#se2; #c}\endmodality(post))
    //         \replacewith({v := ⟨1⟩}
    //             \modality{#mod}{c# #c}\endmodality(post))
    //         \heuristics(simplify_prog)
    //     };
    //     taclet                    ⟨0⟩  ⟨1⟩
    //     additionAssignment        +    se1 + se2
    //     subtractionAssignment     -    se1 - se2
    //     multiplicationAssignment  *    se1 * se2
    //     powerAssignment           **   pow(se1, se2)
    additionAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;

        \find(\modality{#mod}{c# s#v = s#se1 + s#se2; #c}\endmodality(post))
        \replacewith({v := se1 + se2}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for subtraction operator (-)
    // ------------------------------------------------------------------------

    subtraction_unfold_left {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Variable pv1;
        \schemaVar \program Type pv1Type;
        \schemaVar \program Variable pv2;
        \schemaVar \program Type pv2Type;

        \find(\modality{#mod}{c# s#v = s#nse - s#se; #c}\endmodality(post))
        \varcond(\newTypeOf(pv1, v), \newTypeOf(pv2, v))
        \replacewith(\modality{#mod}{c# s#pv1Type s#pv1 = s#se;
                                      s#pv2Type s#pv2 = s#nse;
                                      s#v = s#pv2 - s#pv1; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    subtraction_unfold_right {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program Expression e;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#v = s#e - s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, v))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#v = s#e - s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    subtractionAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;

        \find(\modality{#mod}{c# s#v = s#se1 - s#se2; #c}\endmodality(post))
        \replacewith({v := se1 - se2}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for multiplication operator (*)
    // ------------------------------------------------------------------------

    multiplication_unfold_left {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Variable pv1;
        \schemaVar \program Type pv1Type;
        \schemaVar \program Variable pv2;
        \schemaVar \program Type pv2Type;

        \find(\modality{#mod}{c# s#v = s#nse * s#se; #c}\endmodality(post))
        \varcond(\newTypeOf(pv1, v), \newTypeOf(pv2, v))
        \replacewith(\modality{#mod}{c# s#pv1Type s#pv1 = s#se;
                                      s#pv2Type s#pv2 = s#nse;
                                      s#v = s#pv2 * s#pv1; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    multiplication_unfold_right {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program Expression e;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#v = s#e * s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, v))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#v = s#e * s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    multiplicationAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;

        \find(\modality{#mod}{c# s#v = s#se1 * s#se2; #c}\endmodality(post))
        \replacewith({v := se1 * se2}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for power operator (**)
    // ------------------------------------------------------------------------

    power_unfold_left {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Variable pv1;
        \schemaVar \program Type pv1Type;
        \schemaVar \program Variable pv2;
        \schemaVar \program Type pv2Type;

        \find(\modality{#mod}{c# s#v = s#nse ** s#se; #c}\endmodality(post))
        \varcond(\newTypeOf(pv1, v), \newTypeOf(pv2, v))
        \replacewith(\modality{#mod}{c# s#pv1Type s#pv1 = s#se;
                                      s#pv2Type s#pv2 = s#nse;
                                      s#v = s#pv2 ** s#pv1; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    power_unfold_right {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program Expression e;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#v = s#e ** s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, v))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#v = s#e ** s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    powerAssignment {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program SimpleExpression se1;
        \schemaVar \program SimpleExpression se2;

        \find(\modality{#mod}{c# s#v = s#se1 ** s#se2; #c}\endmodality(post))
        \replacewith({v := pow(se1, se2)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // ------------------------------------------------------------------------
    // ----------- Rules for division operator (/)
    // ------------------------------------------------------------------------

    division_unfold_left {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program SimpleExpression se;
        \schemaVar \program Variable pv1;
        \schemaVar \program Type pv1Type;
        \schemaVar \program Variable pv2;
        \schemaVar \program Type pv2Type;

        \find(\modality{#mod}{c# s#v = s#nse / s#se; #c}\endmodality(post))
        \varcond(\newTypeOf(pv1, v), \newTypeOf(pv2, v))
        \replacewith(\modality{#mod}{c# s#pv1Type s#pv1 = s#se;
                                      s#pv2Type s#pv2 = s#nse;
                                      s#v = s#pv2 / s#pv1; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    division_unfold_right {
        \schemaVar \formula post;
        \schemaVar \program Variable v;
        \schemaVar \program Expression e;
        \schemaVar \program NonSimpleExpression nse;
        \schemaVar \program Variable pv;
        \schemaVar \program Type pvType;

        \find(\modality{#mod}{c# s#v = s#e / s#nse; #c}\endmodality(post))
        \varcond(\newTypeOf(pv, v))
        \replacewith(\modality{#mod}{c# s#pvType s#pv = s#nse;
                                      s#v = s#e / s#pv; #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    // generalization:
    //     ⟨name⟩Assignment {
    //         \schemaVar \formula post;
    //         \schemaVar \program Variable v;
    //         \schemaVar \program SimpleExpression se1;
    //         \schemaVar \program SimpleExpression se2;
