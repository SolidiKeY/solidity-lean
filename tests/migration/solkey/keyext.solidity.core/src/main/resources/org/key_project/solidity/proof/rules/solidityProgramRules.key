        \find(\modality{#mod}{c# ++s#sp.s#fld; #c}\endmodality(post))
        \replacewith({storage := save(storage, consr(sp, fld),
                find<[int]>(storage, consr(sp, fld)) + 1)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

