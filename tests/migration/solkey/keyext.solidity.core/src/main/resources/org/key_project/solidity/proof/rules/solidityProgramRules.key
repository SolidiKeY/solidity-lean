    // ------------------------------------------------------------------------
    // ----------- Rules for memory compound assignment operators
    // ------------------------------------------------------------------------

    // generalization:
    //     memoryField⟨name⟩Assign {
    //         \schemaVar \formula post;
    //         \schemaVar \program Path[memory,simple] mv;
    //         \schemaVar \program Field fld;
    //         \schemaVar \program SimpleExpression se;
    //         \find(\modality{#mod}{c# s#mv.s#fld ⟨0⟩= s#se; #c}\endmodality(post))
    //         \replacewith({memory := write(memory, mv, fld,
    //                 read<[int]>(memory, mv, fld) ⟨0⟩ se)}
    //             \modality{#mod}{c# #c}\endmodality(post))
    //         \heuristics(simplify_expression)
    //     };
    //     taclet                ⟨0⟩
    //     memoryFieldAddAssign  +
    //     memoryFieldSubAssign  -
    //     memoryFieldMulAssign  *
    memoryFieldAddAssign {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field fld;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#mv.s#fld += s#se; #c}\endmodality(post))
        \replacewith({memory := write(memory, mv, fld,
                read<[int]>(memory, mv, fld) + se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    memoryFieldSubAssign {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field fld;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#mv.s#fld -= s#se; #c}\endmodality(post))
        \replacewith({memory := write(memory, mv, fld,
                read<[int]>(memory, mv, fld) - se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    memoryFieldMulAssign {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field fld;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#mv.s#fld *= s#se; #c}\endmodality(post))
        \replacewith({memory := write(memory, mv, fld,
                read<[int]>(memory, mv, fld) * se)}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_expression)
    };

    // generalization:
    //     memoryField⟨name⟩Assign {
    //         \schemaVar \formula post;
    //         \schemaVar \program Path[memory,simple] mv;
    //         \schemaVar \program Field fld;
    //         \schemaVar \program SimpleExpression se;
    //         \find(\modality{#mod}{c# s#mv.s#fld ⟨0⟩= s#se; #c}\endmodality(post))
    //         \replacewith(\if(se != 0)
    //             \then({memory := write(memory, mv, fld,
    //                     ⟨1⟩(read<[int]>(memory, mv, fld), se))}
    //                 \modality{#mod}{c# #c}\endmodality(post))
    //             \else(\modality{#mod}{c# revert(); #c}\endmodality(post)))
    //         \heuristics(simplify_expression)
    //     };
    //     taclet                ⟨0⟩  ⟨1⟩
    //     memoryFieldDivAssign  /    sdiv
    //     memoryFieldModAssign  %    smod
    memoryFieldDivAssign {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field fld;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#mv.s#fld /= s#se; #c}\endmodality(post))
        \replacewith(\if(se != 0)
            \then({memory := write(memory, mv, fld,
                    sdiv(read<[int]>(memory, mv, fld), se))}
                \modality{#mod}{c# #c}\endmodality(post))
            \else(\modality{#mod}{c# revert(); #c}\endmodality(post)))
        \heuristics(simplify_expression)
    };

    memoryFieldModAssign {
        \schemaVar \formula post;
        \schemaVar \program Path[memory,simple] mv;
        \schemaVar \program Field fld;
        \schemaVar \program SimpleExpression se;

        \find(\modality{#mod}{c# s#mv.s#fld %= s#se; #c}\endmodality(post))
        \replacewith(\if(se != 0)
            \then({memory := write(memory, mv, fld,
                    smod(read<[int]>(memory, mv, fld), se))}
                \modality{#mod}{c# #c}\endmodality(post))
            \else(\modality{#mod}{c# revert(); #c}\endmodality(post)))
        \heuristics(simplify_expression)
    };

    // generalization:
    //     memoryIndexArray⟨name⟩Assign {
    //         \schemaVar \formula post;
    //         \schemaVar \program Path[memory,simple,array] mv;
    //         \schemaVar \program SimpleExpression ie;
