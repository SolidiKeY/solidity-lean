    // ── increment / decrement of a local as a statement of its own ──────────

    // generalization:
    //     local⟨name⟩ {
    //         \schemaVar \formula post;
    //         \schemaVar \program Variable lv;
    //         \find(\modality{#mod}{c# ⟨0⟩; #c}\endmodality(post))
    //         \replacewith({lv := lv ⟨1⟩ 1}
    //             \modality{#mod}{c# #c}\endmodality(post))
    //         \heuristics(simplify_prog)
    //     };
    //     taclet              ⟨0⟩     ⟨1⟩
    //     localPreincrement   ++s#lv  +
    //     localPostincrement  s#lv++  +
    //     localPredecrement   --s#lv  -
    //     localPostdecrement  s#lv--  -
    localPreincrement {
        \schemaVar \formula post;
        \schemaVar \program Variable lv;

        \find(\modality{#mod}{c# ++s#lv; #c}\endmodality(post))
        \replacewith({lv := lv + 1}
            \modality{#mod}{c# #c}\endmodality(post))
        \heuristics(simplify_prog)
    };

    localPostincrement {
        \schemaVar \formula post;
        \schemaVar \program Variable lv;

        \find(\modality{#mod}{c# s#lv++; #c}\endmodality(post))
        \replacewith({lv := lv + 1}
