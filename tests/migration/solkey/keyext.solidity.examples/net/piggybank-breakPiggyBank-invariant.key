\programSource "PiggyBankNet.sol";

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(
            // state != PiggyBankState.Broken ==> balance == net(owner) :
            (!(find<[int]>(s, cons1(PiggyBankNet$state)) = 2)
             -> find<[int]>(s, cons1(PiggyBankNet$balance))
                = selectSt<[int]>(n, at(find<[int]>(s, cons1(PiggyBankNet$owner)))))
            // state == PiggyBankState.Broken ==> net(owner) == 0 :
            & (find<[int]>(s, cons1(PiggyBankNet$state)) = 2
               -> selectSt<[int]>(n, at(find<[int]>(s, cons1(PiggyBankNet$owner))))
                  = 0))
        \heuristics(simplify)
    };
}

// Course piggybank-breakPiggyBank PO: the owner smashes the bank after the time lock.
// The surviving run has state = InUse, so balance = net(owner) going in; the payout
// debits net(owner) by exactly that balance, so it drops to 0 just as the Broken clause
// takes over. Runs under the default noCallback semantics like the course version; the
// withcallback variant beside this file proves the invariant alone.
\problem {
    // non-payable: msg.value == 0 :
    msgValue = 0
    // the payee is not the contract itself: owner != this :
    & !(find<[int]>(storage, cons1(PiggyBankNet$owner)) = self)
    & CInv(storage, net) ->
    {net := storeSt(net, at(msgSender),
                    selectSt<[int]>(net, at(msgSender)) + msgValue)
     || selfBalance := selfBalance + msgValue}
    \[{ breakPiggyBank()@PiggyBankNet; }\]
        (CInv(storage, net)
         // net(owner) == 0 :
         & selectSt<[int]>(net, at(find<[int]>(storage, cons1(PiggyBankNet$owner))))
             = 0
         // state == PiggyBankState.Broken :
         & find<[int]>(storage, cons1(PiggyBankNet$state)) = 2)
}
