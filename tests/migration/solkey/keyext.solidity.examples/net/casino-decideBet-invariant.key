\programSource "CasinoNet.sol";

\programVariables {
    int secret;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(
            // state != BET_PLACED ==> net(operator) + net(player) == pot :
            (!(find<[int]>(s, cons1(CasinoNet$state)) = 2)
             -> selectSt<[int]>(n, at(find<[int]>(s, cons1(CasinoNet$operator))))
                + selectSt<[int]>(n, at(find<[int]>(s, cons1(CasinoNet$player))))
                  = find<[int]>(s, cons1(CasinoNet$pot)))
            // state == BET_PLACED ==> net(operator) + net(player) == pot + bet :
            & (find<[int]>(s, cons1(CasinoNet$state)) = 2
               -> selectSt<[int]>(n, at(find<[int]>(s, cons1(CasinoNet$operator))))
                  + selectSt<[int]>(n, at(find<[int]>(s, cons1(CasinoNet$player))))
                    = find<[int]>(s, cons1(CasinoNet$pot))
                      + find<[int]>(s, cons1(CasinoNet$bet))))
        \heuristics(simplify)
    };
}

// Money-conservation PO for decideBet, both branches at once: a player win pays twice
// the stake from the pot (sum drops by 2*bet, pot by bet, and the staked bet leaves the
// equation), a loss folds the stake into the pot - either way the idle-shape
// conservation is restored. Non-payable: msgValue = 0.
\problem {
    // non-payable: msg.value == 0 :
    msgValue = 0
    // the payee is not the contract itself: player != this :
    & !(find<[int]>(storage, cons1(CasinoNet$player)) = self)
    // participant distinctness: operator != player :
    & !(find<[int]>(storage, cons1(CasinoNet$operator))
        = find<[int]>(storage, cons1(CasinoNet$player)))
    & CInv(storage, net) ->
    {net := storeSt(net, at(msgSender),
                    selectSt<[int]>(net, at(msgSender)) + msgValue)
     || selfBalance := selfBalance + msgValue}
    \[{ decideBet(secret)@CasinoNet; }\]
        (CInv(storage, net)
         // state == GAME_OPEN again :
         & find<[int]>(storage, cons1(CasinoNet$state)) = 1
         // bet == 0 :
         & find<[int]>(storage, cons1(CasinoNet$bet)) = 0)
}
