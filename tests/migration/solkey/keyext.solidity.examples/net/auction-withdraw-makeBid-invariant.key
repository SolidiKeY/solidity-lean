\programSource "AuctionWithdrawNet.sol";

\programVariables {
    Struct old;
    Struct oldNet;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(
            // with effective_net(a) := net(a) - withdrawableBalances[a] :
            // bid == effective_net(bidder) + effective_net(owner) :
            find<[int]>(s, cons1(AuctionWithdrawNet$bid))
                = selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionWithdrawNet$bidder))))
                  - find<[int]>(s, cons2(AuctionWithdrawNet$withdrawableBalances,
                        at(find<[int]>(s, cons1(AuctionWithdrawNet$bidder)))))
                  + selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionWithdrawNet$owner))))
                  - find<[int]>(s, cons2(AuctionWithdrawNet$withdrawableBalances,
                        at(find<[int]>(s, cons1(AuctionWithdrawNet$owner)))))
            // effective_net(owner) <= 0 :
            & selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionWithdrawNet$owner))))
              - find<[int]>(s, cons2(AuctionWithdrawNet$withdrawableBalances,
                    at(find<[int]>(s, cons1(AuctionWithdrawNet$owner)))))
                <= 0
            // mode == Open ==> effective_net(owner) == 0 :
            & (find<[int]>(s, cons1(AuctionWithdrawNet$mode)) = 1
               -> selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionWithdrawNet$owner))))
                  = find<[int]>(s, cons2(AuctionWithdrawNet$withdrawableBalances,
                        at(find<[int]>(s, cons1(AuctionWithdrawNet$owner)))))))
        \heuristics(simplify)
    };
}

// Course auction-single-withdraw-makeBid PO: crediting the outbid bidder's
// withdrawableBalances (no transfer at all) keeps effective_net conservation. The
// fresh-bidder antecedent is the msgSender instance of the course's "all
// non-participants have effective_net 0" clause; geq(bid, 0) is the uint range
// assumption of Solidity Light.
\problem {
    // msg.value >= 0 :
    geq(msgValue, 0)
    // uint range: bid >= 0 :
    & geq(find<[int]>(storage, cons1(AuctionWithdrawNet$bid)), 0)
    // fresh caller: msg.sender != bidder ==> effective_net(msg.sender) == 0 :
    & (!(msgSender = find<[int]>(storage, cons1(AuctionWithdrawNet$bidder)))
       -> selectSt<[int]>(net, at(msgSender))
          - find<[int]>(storage, cons2(AuctionWithdrawNet$withdrawableBalances,
                at(msgSender)))
            = 0)
    & CInv(storage, net) ->
    {old := storage
     || net := storeSt(net, at(msgSender),
                       selectSt<[int]>(net, at(msgSender)) + msgValue)
     || selfBalance := selfBalance + msgValue}
    \[{ makeBid()@AuctionWithdrawNet; }\]
        (CInv(storage, net)
         // bid > \old(bid) :
         & find<[int]>(storage, cons1(AuctionWithdrawNet$bid))
             > find<[int]>(old, cons1(AuctionWithdrawNet$bid))
         // effective_net(bidder) == msg.value :
         & selectSt<[int]>(net,
               at(find<[int]>(storage, cons1(AuctionWithdrawNet$bidder))))
           - find<[int]>(storage, cons2(AuctionWithdrawNet$withdrawableBalances,
                 at(find<[int]>(storage, cons1(AuctionWithdrawNet$bidder)))))
             = msgValue
         // \old(bidder) != msg.sender ==> effective_net(\old(bidder)) == 0 :
         & (!(find<[int]>(old, cons1(AuctionWithdrawNet$bidder)) = msgSender)
            -> selectSt<[int]>(net,
                   at(find<[int]>(old, cons1(AuctionWithdrawNet$bidder))))
               - find<[int]>(storage, cons2(AuctionWithdrawNet$withdrawableBalances,
                     at(find<[int]>(old, cons1(AuctionWithdrawNet$bidder)))))
                 = 0))
}
