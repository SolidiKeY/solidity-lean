\programSource "PiggyBankNet.sol";

\programVariables {
    int to;
    int other;
}

// transferNoCallbackBox terminal rule (docs/net.md, Step 3): payTo(a) transfers 5 to its
// parameter, booking net(to) = net(to) - 5 on the empty ledger while any untouched
// address keeps net(other) = 0 (selectSt on mtSt is defaultValue<[int]> = 0). The body is
// loaded from the .sol source and inlined by functionBodyExpand. The diamond twin is
// net-transfer-diamond.key; a transfer to self is net-transfer-self.key.
\problem {
    net = mtSt & !(to = other) & !(to = self) ->
    \[{ payTo(to)@PiggyBankNet; }\]
        (selectSt<[int]>(net, at(to)) = -5 & selectSt<[int]>(net, at(other)) = 0)
}
