\programSource "PiggyBankNet.sol";

// transfer_unfold_leftFstReceiver: payOwner() runs owner.transfer(5) where `owner` is a
// storage read (nonsimple), so it is captured into a fresh address local first; the
// storage root-read rule resolves it, then the terminal rule fires. Box modality:
// transferNoCallbackBox books the debit with no funding premise.
\problem {
    net = mtSt & find<[int]>(storage, cons1(PiggyBankNet$owner)) = 7 & !(self = 7) ->
    \[{ payOwner()@PiggyBankNet; }\](selectSt<[int]>(net, at(7)) = -5)
}
