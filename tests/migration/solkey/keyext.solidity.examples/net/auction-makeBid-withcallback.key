\programSource "AuctionNet.sol";

\withOptions transferSemantics:withCallback;

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(
            // bid == net(bidder) + net(owner) :
            find<[int]>(s, cons1(AuctionNet$bid))
                = selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionNet$bidder))))
                  + selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionNet$owner))))
            // net(owner) <= 0 :
            & selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionNet$owner)))) <= 0
            // mode == Open ==> net(owner) == 0 :
            & (find<[int]>(s, cons1(AuctionNet$mode)) = 1
               -> selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionNet$owner)))) = 0))
        \heuristics(simplify)
    };
}

// makeBid under transferSemantics:withCallback - the paper's Table 1 entry for the
// transfer-LAST body (Fig. 5): the new bid/bidder are written before the refund leaves,
// so "invariant on exit" closes at the transfer point, and "resume after callback"
// closes by assuming the invariant over the havocked storage and ledger. The
// transfer-first body (Fig. 4) would leave the exit branch open.
\problem {
    // msg.value >= 0 :
    geq(msgValue, 0)
    // the payee is not the contract itself: bidder != this :
    & !(find<[int]>(storage, cons1(AuctionNet$bidder)) = self)
    // uint range: bid >= 0 :
    & geq(find<[int]>(storage, cons1(AuctionNet$bid)), 0)
    // fresh caller: msg.sender != bidder ==> net(msg.sender) == 0 :
    & (!(msgSender = find<[int]>(storage, cons1(AuctionNet$bidder)))
       -> selectSt<[int]>(net, at(msgSender)) = 0)
    & CInv(storage, net) ->
    {net := storeSt(net, at(msgSender),
                    selectSt<[int]>(net, at(msgSender)) + msgValue)
     || selfBalance := selfBalance + msgValue}
    \[{ makeBid()@AuctionNet; }\] CInv(storage, net)
}
