\programSource "CasinoNet.sol";

\programVariables {
    Struct old;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(
            // state != BET_PLACED ==> net(operator) + net(player) == pot :
            (!(find<[int]>(s, cons1(CasinoNet$state)) = 2)
             -> selectSt<[int]>(n, at(find<[int]>(s, cons1(CasinoNet$operator))))
                + selectSt<[int]>(n, at(find<[int]>(s, cons1(CasinoNet$player))))
                  = find<[int]>(s, cons1(CasinoNet$pot)))
            // state == BET_PLACED ==> net(operator) + net(player) == pot + bet :
            & (find<[int]>(s, cons1(CasinoNet$state)) = 2
               -> selectSt<[int]>(n, at(find<[int]>(s, cons1(CasinoNet$operator))))
                  + selectSt<[int]>(n, at(find<[int]>(s, cons1(CasinoNet$player))))
                    = find<[int]>(s, cons1(CasinoNet$pot))
                      + find<[int]>(s, cons1(CasinoNet$bet))))
        \heuristics(simplify)
    };
}

// Money-conservation PO for addToPot: the operator's payment lands in both the ledger
// and the pot, keeping net(operator) + net(player) = pot while no bet is active. The
// operator != player antecedent keeps the two ledger slots distinct.
\problem {
    // msg.value >= 0 :
    geq(msgValue, 0)
    // participant distinctness: operator != player :
    & !(find<[int]>(storage, cons1(CasinoNet$operator))
        = find<[int]>(storage, cons1(CasinoNet$player)))
    & CInv(storage, net) ->
    {old := storage
     || net := storeSt(net, at(msgSender),
                       selectSt<[int]>(net, at(msgSender)) + msgValue)
     || selfBalance := selfBalance + msgValue}
    \[{ addToPot()@CasinoNet; }\]
        (CInv(storage, net)
         // pot == \old(pot) + msg.value :
         & find<[int]>(storage, cons1(CasinoNet$pot))
             = find<[int]>(old, cons1(CasinoNet$pot)) + msgValue)
}
