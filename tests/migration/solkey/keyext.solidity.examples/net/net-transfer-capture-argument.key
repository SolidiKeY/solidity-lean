\programSource "PiggyBankNet.sol";

\programVariables {
    int to;
    int x;
}

// transfer_unfold_rightSndArgument: payToPlus(a, x) transfers a.transfer(x + 2), so the
// nonsimple amount is captured into a fresh value local before the terminal rule fires.
// Box modality: transferNoCallbackBox books the capture result with no funding premise.
\problem {
    net = mtSt & x = 3 & !(to = self) ->
    \[{ payToPlus(to, x)@PiggyBankNet; }\](selectSt<[int]>(net, at(to)) = -5)
}
