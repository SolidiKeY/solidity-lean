\programSource "EscrowNet.sol";

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(
            // sender != receiver :
            !(find<[int]>(s, cons1(EscrowNet$sender))
              = find<[int]>(s, cons1(EscrowNet$receiver)))
            // amountInEscrow == net(sender) + net(receiver) :
            & find<[int]>(s, cons1(EscrowNet$amountInEscrow))
                = selectSt<[int]>(n, at(find<[int]>(s, cons1(EscrowNet$sender))))
                  + selectSt<[int]>(n, at(find<[int]>(s, cons1(EscrowNet$receiver))))
            // state == AwaitingDeposit ==> net(sender) == 0 :
            & (find<[int]>(s, cons1(EscrowNet$state)) = 0
               -> selectSt<[int]>(n, at(find<[int]>(s, cons1(EscrowNet$sender)))) = 0)
            // state != DepositPlaced ==> amountInEscrow == 0 :
            & (!(find<[int]>(s, cons1(EscrowNet$state)) = 1)
               -> find<[int]>(s, cons1(EscrowNet$amountInEscrow)) = 0))
        \heuristics(simplify)
    };
}

// Course escrow-v2-withdrawFrom PO: the receiver withdraws the escrowed amount; the
// conservation clause turns into net(receiver) = -net(sender) (stated as their sum being
// zero). Runs under the default noCallback semantics, as the course did - the body keeps
// the course's order (transfer before zeroing amountInEscrow), which breaks the invariant
// at the transfer point, so the withCallback variant would leave the exit branch open.
\problem {
    // non-payable: msg.value == 0 :
    msgValue = 0
    // the payee is not the contract itself: receiver != this :
    & !(find<[int]>(storage, cons1(EscrowNet$receiver)) = self)
    & CInv(storage, net) ->
    {net := storeSt(net, at(msgSender),
                    selectSt<[int]>(net, at(msgSender)) + msgValue)
     || selfBalance := selfBalance + msgValue}
    \[{ withdrawFromEscrow()@EscrowNet; }\]
        (CInv(storage, net)
         // net(receiver) == -net(sender) :
         & selectSt<[int]>(net, at(find<[int]>(storage, cons1(EscrowNet$receiver))))
           + selectSt<[int]>(net, at(find<[int]>(storage, cons1(EscrowNet$sender))))
             = 0
         // state == Withdrawn :
         & find<[int]>(storage, cons1(EscrowNet$state)) = 2)
}
