\programSource "PiggyBankNet.sol";

\programVariables {
    int to;
}

// transferNoCallbackDiamond: a diamond transfer owes the "non-negative amount" goal,
// closed by the literal 5; the "transfer booked" goal then debits the ledger. The box
// twin (net-transfer-simple.key) owes nothing.
\problem {
    net = mtSt & !(to = self) ->
    \<{ payTo(to)@PiggyBankNet; }\>(selectSt<[int]>(net, at(to)) = -5)
}
