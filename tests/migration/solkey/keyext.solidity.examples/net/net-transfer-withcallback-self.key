\programSource "PiggyBankNet.sol";

\withOptions transferSemantics:withCallback;

\programVariables {
    int to;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(selectSt<[int]>(n, at(to)) = 0)
        \heuristics(simplify)
    };
}

// transferWithCallbackBox on a transfer to the contract itself: "invariant on exit" holds
// because the ledger is left unchanged (net(to) = 0 stays 0, a debit would break it);
// "resume after callback" havocs storage and net with fresh skolem constants and assumes
// the invariant.
\problem {
    to = self & selectSt<[int]>(net, at(to)) = 0 ->
    \[{ payTo(to)@PiggyBankNet; }\] CInv(storage, net)
}
