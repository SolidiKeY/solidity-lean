\programSource "PiggyBankNet.sol";

// msg.sender / msg.value desugar to the built-in program variables msgSender / msgValue
// (docs/net.md, Step 2) - here inside a real contract function loaded from the .sol
// source, inlined by functionBodyExpand. Box modality: the starters run in box since
// the transfer rules split by modality (the diamond variants are the *-diamond-funded
// problems).
\problem {
    \[{ readMsg()@PiggyBankNet; }\]
        (find<[int]>(storage, cons1(PiggyBankNet$paidValue)) = msgValue
         & find<[int]>(storage, cons1(PiggyBankNet$paidBy)) = msgSender)
}
