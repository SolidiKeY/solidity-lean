\programSource "AuctionNet.sol";

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(
            // bid == net(bidder) + net(owner) :
            find<[int]>(s, cons1(AuctionNet$bid))
                = selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionNet$bidder))))
                  + selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionNet$owner))))
            // net(owner) <= 0 :
            & selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionNet$owner)))) <= 0
            // mode == Open ==> net(owner) == 0 :
            & (find<[int]>(s, cons1(AuctionNet$mode)) = 1
               -> selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionNet$owner)))) = 0))
        \heuristics(simplify)
    };
}

// Course closeAuction PO: paying the winning bid to the owner turns the conservation
// clause into net(owner) = -net(bidder) (stated as their sum being zero). Non-payable:
// msgValue = 0; geq(bid, 0) is the uint range assumption.
\problem {
    // non-payable: msg.value == 0 :
    msgValue = 0
    // the payee is not the contract itself: owner != this :
    & !(find<[int]>(storage, cons1(AuctionNet$owner)) = self)
    // uint range: bid >= 0 :
    & geq(find<[int]>(storage, cons1(AuctionNet$bid)), 0)
    & CInv(storage, net) ->
    {net := storeSt(net, at(msgSender),
                    selectSt<[int]>(net, at(msgSender)) + msgValue)
     || selfBalance := selfBalance + msgValue}
    \[{ closeAuction()@AuctionNet; }\]
        (CInv(storage, net)
         // net(owner) == -net(bidder) :
         & selectSt<[int]>(net, at(find<[int]>(storage, cons1(AuctionNet$owner))))
           + selectSt<[int]>(net, at(find<[int]>(storage, cons1(AuctionNet$bidder))))
             = 0
         // mode == Closed :
         & find<[int]>(storage, cons1(AuctionNet$mode)) = 2)
}
