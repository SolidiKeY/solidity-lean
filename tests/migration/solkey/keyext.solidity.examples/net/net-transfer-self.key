\programSource "PiggyBankNet.sol";

\programVariables {
    int to;
    int n;
}

// transferNoCallbackBox on a transfer to the contract itself: the money stays in the
// contract, so the ledger is left unchanged.
\problem {
    to = self & selectSt<[int]>(net, at(to)) = n ->
    \[{ payTo(to)@PiggyBankNet; }\](selectSt<[int]>(net, at(to)) = n)
}
