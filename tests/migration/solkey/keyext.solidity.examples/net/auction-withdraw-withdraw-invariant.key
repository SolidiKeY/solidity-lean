\programSource "AuctionWithdrawNet.sol";

\programVariables {
    Struct old;
    Struct oldNet;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(
            // with effective_net(a) := net(a) - withdrawableBalances[a] :
            // bid == effective_net(bidder) + effective_net(owner) :
            find<[int]>(s, cons1(AuctionWithdrawNet$bid))
                = selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionWithdrawNet$bidder))))
                  - find<[int]>(s, cons2(AuctionWithdrawNet$withdrawableBalances,
                        at(find<[int]>(s, cons1(AuctionWithdrawNet$bidder)))))
                  + selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionWithdrawNet$owner))))
                  - find<[int]>(s, cons2(AuctionWithdrawNet$withdrawableBalances,
                        at(find<[int]>(s, cons1(AuctionWithdrawNet$owner)))))
            // effective_net(owner) <= 0 :
            & selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionWithdrawNet$owner))))
              - find<[int]>(s, cons2(AuctionWithdrawNet$withdrawableBalances,
                    at(find<[int]>(s, cons1(AuctionWithdrawNet$owner)))))
                <= 0
            // mode == Open ==> effective_net(owner) == 0 :
            & (find<[int]>(s, cons1(AuctionWithdrawNet$mode)) = 1
               -> selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionWithdrawNet$owner))))
                  = find<[int]>(s, cons2(AuctionWithdrawNet$withdrawableBalances,
                        at(find<[int]>(s, cons1(AuctionWithdrawNet$owner)))))))
        \heuristics(simplify)
    };
}

// Course auction-single-withdraw-withdraw PO: paying out one's own credited balance
// leaves every effective_net unchanged (the ledger decrement exactly matches the cleared
// withdrawableBalances entry), so the invariant survives untouched; afterwards the
// caller's entry is 0 and their net dropped by exactly the old entry. Pinned to the
// canonical caller - the outbid bidder (msgSender = bidder != owner) - because the fully
// symbolic caller leaves mapping-alias if-then-else splits automode will not perform.
\problem {
    // non-payable: msg.value == 0 :
    msgValue = 0
    // the payee is not the contract itself: msg.sender != this :
    & !(msgSender = self)
    // canonical caller: the outbid bidder withdraws :
    & msgSender = find<[int]>(storage, cons1(AuctionWithdrawNet$bidder))
    // participant distinctness: bidder != owner :
    & !(find<[int]>(storage, cons1(AuctionWithdrawNet$bidder))
        = find<[int]>(storage, cons1(AuctionWithdrawNet$owner)))
    & CInv(storage, net) ->
    {old := storage
     || oldNet := net
     || net := storeSt(net, at(msgSender),
                       selectSt<[int]>(net, at(msgSender)) + msgValue)
     || selfBalance := selfBalance + msgValue}
    \[{ withdraw()@AuctionWithdrawNet; }\]
        (CInv(storage, net)
         // withdrawableBalances[msg.sender] == 0 :
         & find<[int]>(storage, cons2(AuctionWithdrawNet$withdrawableBalances,
               at(msgSender)))
             = 0
         // net(msg.sender) == \old(net(msg.sender) - withdrawableBalances[msg.sender]) :
         & selectSt<[int]>(net, at(msgSender))
             = selectSt<[int]>(oldNet, at(msgSender))
               - find<[int]>(old, cons2(AuctionWithdrawNet$withdrawableBalances,
                     at(msgSender))))
}
