\programSource "PiggyBankNet.sol";

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(
            // state != PiggyBankState.Broken ==> balance == net(owner) :
            (!(find<[int]>(s, cons1(PiggyBankNet$state)) = 2)
             -> find<[int]>(s, cons1(PiggyBankNet$balance))
                = selectSt<[int]>(n, at(find<[int]>(s, cons1(PiggyBankNet$owner)))))
            // state == PiggyBankState.Broken ==> net(owner) == 0 :
            & (find<[int]>(s, cons1(PiggyBankNet$state)) = 2
               -> selectSt<[int]>(n, at(find<[int]>(s, cons1(PiggyBankNet$owner))))
                  = 0))
        \heuristics(simplify)
    };
}

// Course piggybank-addMoney PO (ISoLA 2020, eq. 4): assuming the invariant, book the
// incoming payment on net(msgSender) and run the deposit. The surviving (non-reverting)
// run has msgSender = owner and state != Broken, so balance and net(owner) grow by the
// same msgValue, and the bank ends InUse either way (a fresh bank flips Unused ->
// InUse). The state disjunction is the enum-range assumption the course PO also
// carries.
\problem {
    // msg.value >= 0 :
    geq(msgValue, 0)
    // state is one of Unused, InUse, Broken :
    & (find<[int]>(storage, cons1(PiggyBankNet$state)) = 0
       | find<[int]>(storage, cons1(PiggyBankNet$state)) = 1
       | find<[int]>(storage, cons1(PiggyBankNet$state)) = 2)
    & CInv(storage, net) ->
    {net := storeSt(net, at(msgSender),
                    selectSt<[int]>(net, at(msgSender)) + msgValue)
     || selfBalance := selfBalance + msgValue}
    \[{ addMoney()@PiggyBankNet; }\]
        (CInv(storage, net)
         // balance == net(owner) :
         & find<[int]>(storage, cons1(PiggyBankNet$balance))
             = selectSt<[int]>(net, at(find<[int]>(storage, cons1(PiggyBankNet$owner))))
         // state == PiggyBankState.InUse :
         & find<[int]>(storage, cons1(PiggyBankNet$state)) = 1)
}
