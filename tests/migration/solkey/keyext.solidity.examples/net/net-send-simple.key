\programSource "PiggyBankNet.sol";

\programVariables {
    int to;
    int other;
}

// sendNoCallbackBox (docs/net.md): sendTo(a) sends 5 and binds the outcome instead of
// reverting, so the ledger either books net(to) = -5 or stays empty; an untouched address
// keeps net(other) = 0 either way. The call{value} twin is net-call-withcallback-simple.key.
\problem {
    net = mtSt & !(to = other) & !(to = self) ->
    \[{ sendTo(to)@PiggyBankNet; }\]
        ((selectSt<[int]>(net, at(to)) = -5 | selectSt<[int]>(net, at(to)) = 0)
         & selectSt<[int]>(net, at(other)) = 0)
}
