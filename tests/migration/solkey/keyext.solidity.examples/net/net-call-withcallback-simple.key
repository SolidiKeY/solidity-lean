\programSource "PiggyBankNet.sol";

\withOptions transferSemantics:withCallback;

\programVariables {
    int to;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(selectSt<[int]>(n, at(to)) <= 0)
        \heuristics(simplify)
    };
}

// sendWithCallbackBox on `(bool ok, ) = a.call{value: 5}("")`, which the parser lowers to
// `bool ok = a.send(5)`: "invariant on exit" proves the invariant after booking
// net(to) -= 5, "send succeeded" havocs storage and net and resumes under the invariant,
// and "send failed" leaves the ledger untouched.
\problem {
    selectSt<[int]>(net, at(to)) <= 0 ->
    \[{ callTo(to)@PiggyBankNet; }\] CInv(storage, net)
}
