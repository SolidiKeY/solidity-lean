\programSource "PiggyBankNet.sol";

\withOptions transferSemantics:withCallback;

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(
            // state != PiggyBankState.Broken ==> balance == net(owner) :
            (!(find<[int]>(s, cons1(PiggyBankNet$state)) = 2)
             -> find<[int]>(s, cons1(PiggyBankNet$balance))
                = selectSt<[int]>(n, at(find<[int]>(s, cons1(PiggyBankNet$owner)))))
            // state == PiggyBankState.Broken ==> net(owner) == 0 :
            & (find<[int]>(s, cons1(PiggyBankNet$state)) = 2
               -> selectSt<[int]>(n, at(find<[int]>(s, cons1(PiggyBankNet$owner))))
                  = 0))
        \heuristics(simplify)
    };
}

// breakPiggyBank under transferSemantics:withCallback: the course body writes
// state = Broken BEFORE the payout leaves, so "invariant on exit" closes at the transfer
// point (net(owner) is debited to 0 exactly when the Broken clause starts to apply) and
// "resume after callback" closes by assuming the invariant over the havocked storage and
// ledger. Only CInv survives the havoc - the state/net postconditions belong to the
// noCallback variant beside this file.
\problem {
    // non-payable: msg.value == 0 :
    msgValue = 0
    // the payee is not the contract itself: owner != this :
    & !(find<[int]>(storage, cons1(PiggyBankNet$owner)) = self)
    & CInv(storage, net) ->
    {net := storeSt(net, at(msgSender),
                    selectSt<[int]>(net, at(msgSender)) + msgValue)
     || selfBalance := selfBalance + msgValue}
    \[{ breakPiggyBank()@PiggyBankNet; }\] CInv(storage, net)
}
