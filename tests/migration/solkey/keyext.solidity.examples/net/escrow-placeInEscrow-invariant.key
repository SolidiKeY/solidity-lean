\programSource "EscrowNet.sol";

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(
            // sender != receiver :
            !(find<[int]>(s, cons1(EscrowNet$sender))
              = find<[int]>(s, cons1(EscrowNet$receiver)))
            // amountInEscrow == net(sender) + net(receiver) :
            & find<[int]>(s, cons1(EscrowNet$amountInEscrow))
                = selectSt<[int]>(n, at(find<[int]>(s, cons1(EscrowNet$sender))))
                  + selectSt<[int]>(n, at(find<[int]>(s, cons1(EscrowNet$receiver))))
            // state == AwaitingDeposit ==> net(sender) == 0 :
            & (find<[int]>(s, cons1(EscrowNet$state)) = 0
               -> selectSt<[int]>(n, at(find<[int]>(s, cons1(EscrowNet$sender)))) = 0)
            // state != DepositPlaced ==> amountInEscrow == 0 :
            & (!(find<[int]>(s, cons1(EscrowNet$state)) = 1)
               -> find<[int]>(s, cons1(EscrowNet$amountInEscrow)) = 0))
        \heuristics(simplify)
    };
}

// Course escrow-v2-placeInEscrow PO (ISoLA 2020, eq. 4): assuming the invariant, book the
// incoming payment on net(msgSender) and run the deposit. The surviving (non-reverting)
// run has msgSender = sender and state = AwaitingDeposit, so net(sender) was 0 and the
// new amountInEscrow = msg.value restores the conservation clause.
\problem {
    // msg.value >= 0 :
    geq(msgValue, 0) & CInv(storage, net) ->
    {net := storeSt(net, at(msgSender),
                    selectSt<[int]>(net, at(msgSender)) + msgValue)
     || selfBalance := selfBalance + msgValue}
    \[{ placeInEscrow()@EscrowNet; }\]
        (CInv(storage, net)
         // net(sender) == msg.value :
         & selectSt<[int]>(net, at(find<[int]>(storage, cons1(EscrowNet$sender))))
             = msgValue
         // state == DepositPlaced :
         & find<[int]>(storage, cons1(EscrowNet$state)) = 1)
}
