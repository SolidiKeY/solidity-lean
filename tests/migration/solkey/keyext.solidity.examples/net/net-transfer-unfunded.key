\programSource "PiggyBankNet.sol";

\programVariables {
    int to;
}

// transferNoCallbackBox needs no funding: the box books net(to) -= 5 unconditionally -
// under partial correctness an unfunded transfer reverts on the EVM and the run is
// trivially correct, so the calculus does not owe the balance check.
\problem {
    net = mtSt & !(to = self) ->
    \[{ payTo(to)@PiggyBankNet; }\](selectSt<[int]>(net, at(to)) = -5)
}
