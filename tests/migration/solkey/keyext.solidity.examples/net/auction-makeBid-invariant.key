\programSource "AuctionNet.sol";

\programVariables {
    Struct old;
}

\rules {
    insertCInv {
        \schemaVar \term Struct s, n;
        \find(CInv(s, n))
        \replacewith(
            // bid == net(bidder) + net(owner) :
            find<[int]>(s, cons1(AuctionNet$bid))
                = selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionNet$bidder))))
                  + selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionNet$owner))))
            // net(owner) <= 0 :
            & selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionNet$owner)))) <= 0
            // mode == Open ==> net(owner) == 0 :
            & (find<[int]>(s, cons1(AuctionNet$mode)) = 1
               -> selectSt<[int]>(n, at(find<[int]>(s, cons1(AuctionNet$owner)))) = 0))
        \heuristics(simplify)
    };
}

// Course auction-single-transfer PO for makeBid under the default noCallback semantics
// (the course marks these postconditions "only true if transfer can't call back"): the
// new bid is strictly higher, the new bidder's net is exactly msg.value, and an outbid
// previous bidder is fully refunded. The fresh-bidder antecedent is the msgSender
// instance of the course's "all non-participants have net 0" invariant clause; geq(bid,0)
// is the uint range assumption of Solidity Light.
\problem {
    // msg.value >= 0 :
    geq(msgValue, 0)
    // the payee is not the contract itself: bidder != this :
    & !(find<[int]>(storage, cons1(AuctionNet$bidder)) = self)
    // uint range: bid >= 0 :
    & geq(find<[int]>(storage, cons1(AuctionNet$bid)), 0)
    // fresh caller: msg.sender != bidder ==> net(msg.sender) == 0 :
    & (!(msgSender = find<[int]>(storage, cons1(AuctionNet$bidder)))
       -> selectSt<[int]>(net, at(msgSender)) = 0)
    & CInv(storage, net) ->
    {old := storage
     || net := storeSt(net, at(msgSender),
                       selectSt<[int]>(net, at(msgSender)) + msgValue)
     || selfBalance := selfBalance + msgValue}
    \[{ makeBid()@AuctionNet; }\]
        (CInv(storage, net)
         // bid > \old(bid) :
         & find<[int]>(storage, cons1(AuctionNet$bid))
             > find<[int]>(old, cons1(AuctionNet$bid))
         // net(bidder) == msg.value :
         & selectSt<[int]>(net, at(find<[int]>(storage, cons1(AuctionNet$bidder))))
             = msgValue
         // \old(bidder) != msg.sender ==> net(\old(bidder)) == 0 :
         & (!(find<[int]>(old, cons1(AuctionNet$bidder)) = msgSender)
            -> selectSt<[int]>(net, at(find<[int]>(old, cons1(AuctionNet$bidder)))) = 0))
}
