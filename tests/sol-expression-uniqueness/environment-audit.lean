import Lean
import Solidity.Frontend.ExpressionUniqueness.AxiomPins

/-! Verification tooling only, never imported by the dependency-free library.
Each generated command checks one actual imported kernel declaration using the
same collectAxioms API as #print axioms, with unchanged per-command budgets.
Its full kernel type expression and actual axiom set are recorded. -/

open Lean Elab Command

elab "#owned_axioms " moduleName:str constantName:str : command => do
  let env ← getEnv
  unless env.header.modules.size == env.header.moduleData.size do
    throwError "module metadata arrays differ"
  let modules := (env.header.modules.zip env.header.moduleData).filter
    (fun entry => entry.1.module.toString == moduleName.getString)
  let data ← match modules.toList with
    | [(_, data)] => pure data
    | _ => throwError "owned module is missing or duplicated"
  let constants := data.constants.filter (fun ci => ci.name.toString == constantName.getString)
  let ci ← match constants.toList with
    | [ci] => pure ci
    | _ => throwError "owned kernel constant is missing or duplicated"
  let axioms ← collectAxioms ci.name
  unless axioms.all (fun n => n == ``propext || n == ``Classical.choice || n == ``Quot.sound) do
    throwError "non-standard axiom in owned kernel declaration {ci.name}"
  let kind := match ci with
    | .axiomInfo _ => "axiom" | .defnInfo _ => "definition" | .thmInfo _ => "theorem"
    | .opaqueInfo _ => "opaque" | .quotInfo _ => "quotient" | .ctorInfo _ => "constructor"
    | .recInfo _ => "recursor" | .inductInfo _ => "inductive"
  let row := Json.mkObj [("module", Json.str moduleName.getString), ("name", Json.str ci.name.toString),
    ("kind", Json.str kind), ("type_expr", Json.str (reprStr ci.type)),
    ("axioms", Json.arr ((axioms.qsort Name.lt).map (fun n => Json.str n.toString)))]
  logInfo m!"OWNED_KERNEL_DECL {row.compress}"

