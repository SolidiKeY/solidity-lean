ecked_add_widen() external returns (uint256 r) { uint8 x; assembly (\"memory-safe\") { x := 0x1ff } uint8 y; unchecked { y = x + 1; } assembly { r := y } }\n  function u8_div() external returns (uint256 r) { uint8 x; assembly (\"memory-safe\") { x := 0x1fe } r = x / 2; }\n  function u8_lt() external returns (bool r) { uint8 x; assembly (\"memory-safe\") { x := 0x101 } r = (x < 2); }\n  function u8_shr() external returns (uint256 r) { uint8 x; assembly (\"memory-safe\") { x := 0x1f0 } r = x >> 4; }\n  function u8_store() external returns (uint256 r) { uint8 x; assembly (\"memory-safe\") { x := 0x1ff } s8 = x; r = s8; }\n  function u8_asm_reread() external returns (uint256 r) { uint8 x; assembly (\"memory-safe\") { x := 0x1ff } uint8 y = x; assembly { r := y } }\n  function i8_div() external returns (int256 r) { int8 x; assembly (\"memory-safe\") { x := 0x1fc } r = x / 2; }\n  function b_if() external returns (uint256 r) { bool x; assembly (\"memory-safe\") { x := 2 } if (x) { r = 5; } else { r = 6; } }\n  function b_and() external returns (bool r) { bool x; assembly (\"memory-safe\") { x := 2 } r = x && true; }\n  function b_ne_false() external returns (bool r) { bool x; assembly (\"memory-safe\") { x := 2 } r = (x != false); }\n  function b_store() external returns (uint256 r) { bool x; assembly (\"memory-safe\") { x := 2 } sb = x; assembly { r := sload(sb.slot) } }\n  function i8_eq_neg1() external returns (bool r) { int8 x; assembly (\"memory-safe\") { x := 0x1ff } r = (x == -1); }\n  function u32_widen() external returns (uint256 r) { uint32 x; assembly (\"memory-safe\") { x := 0x1234567890 } r = x; }\n  function i16_widen() external returns (int256 r) { int16 x; assembly (\"memory-safe\") { x := 0x18000 } r = x; }\n  function b_eq_b() external returns (bool r) { bool x; assembly (\"memory-safe\") { x := 2 } bool t = true; r = (x == t); }\n  function u8_asm_direct() external returns (uint256 r) { uint8 x; assembly (\"memory-safe\") { x := 0x1ff } assembly { r := x } }\n  function b_asm_direct() external returns (uint256 r) { bool x; assembly (\"memory-safe\") { x := 2 } assembly { r := x } }\n}\n",
