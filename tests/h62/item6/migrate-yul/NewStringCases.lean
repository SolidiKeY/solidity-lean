/-!
Isolated finite controls for B-KEYSORT-API. The Legacy function reproduces
headerName? from the pinned SortCheck/Parser source; New is a candidate only.
Neither file imports or repairs that owner module. These cases are not a
universal equivalence theorem, full parser validation, or KeySort gate pass.
Generated by scripts/h62/item6/migrate-yul/generate-string-fixtures.py.
-/
namespace H62.MigrateYul.New
private def isIdentChar (c : Char) : Bool := c.isAlphanum || c = '_'
def headerName? (l : String) : Option String :=
  let t := l.trimAscii.copy
  if t.endsWith "{" then
    let n := ((t.dropEnd 1).copy).trimAscii.copy
    match n.toList with
    | [] => none
    | c :: cs =>
        if !c.isDigit && (c :: cs).all isIdentChar then some n else none
  else none

def cases : List (String × Option String) := [
  ("", none),
  (" \t\r\n", none),
  ("{", none),
  (" { ", none),
  ("x{", some "x"),
  ("\tA_1 \t{\r\n", some "A_1"),
  ("_{", some "_"),
  ("__{", some "__"),
  ("0x{", none),
  ("a-b{", none),
  ("a b{", none),
  ("a\nb{", none),
  ("\\rules {", none),
  ("x", none),
  ("x}", none),
  ("x{{", none),
  ("x｛", none),
  ("λ{", none),
  (" x{", none),
  ("x{ ", none),
  ("x\t{", some "x"),
  ("x_9{", some "x_9"),
  (String.singleton (Char.ofNat 11) ++ "x{", none)
]

/-- Logical whitespace boundary, proved without evaluating the String APIs. -/
theorem whitespace_exact (c : Char) :
    c.isWhitespace = (c = ' ' || c = '\t' || c = '\r' || c = '\n') := rfl

/-- The original leading-digit rejection guard is retained. -/
theorem digit_rejected (c : Char) (cs : List Char) (h : c.isDigit = true) :
    (!c.isDigit && (c :: cs).all isIdentChar) = false := by
  simp only [h, Bool.not_true, Bool.false_and]

#print axioms whitespace_exact
#print axioms digit_rejected

/-- info: true -/
#guard_msgs in
#eval cases.map (fun row => headerName? row.1) == cases.map Prod.snd
end H62.MigrateYul.New
