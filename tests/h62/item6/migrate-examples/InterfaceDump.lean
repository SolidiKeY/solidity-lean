import Lean
import SolidityExamples

/-! Audit-only serializer. It adds no declarations to the model or generated roots.
    The output includes constants generated by commands, assigned by source module.
    Metadata-normalized expressions retain binders, levels and all logical structure.
    Any changed type hash requires review; this tool does not prove type equivalence. -/

namespace H62MigrateExamplesAudit
open Lean Elab Command

private def nameJson : Name → Json
  | .anonymous => Json.arr #[toJson "anonymous"]
  | .str p value => Json.arr #[toJson "str", nameJson p, toJson value]
  | .num p value => Json.arr #[toJson "num", nameJson p, toJson value]

private def binderJson : BinderInfo → Json
  | .default => toJson "default"
  | .implicit => toJson "implicit"
  | .strictImplicit => toJson "strictImplicit"
  | .instImplicit => toJson "instImplicit"

private def levelJson : Level → Json
  | .zero => toJson (["zero"] : List String)
  | .succ u => Json.arr #[toJson "succ", levelJson u]
  | .max u v => Json.arr #[toJson "max", levelJson u, levelJson v]
  | .imax u v => Json.arr #[toJson "imax", levelJson u, levelJson v]
  | .param n => Json.arr #[toJson "param", nameJson n]
  | .mvar n => Json.arr #[toJson "unexpected-level-mvar", nameJson n.name]

private def typeJson : Expr → Json
  | .bvar n => Json.arr #[toJson "bvar", toJson n]
  | .fvar n => Json.arr #[toJson "unexpected-fvar", nameJson n.name]
  | .mvar n => Json.arr #[toJson "unexpected-mvar", nameJson n.name]
  | .sort u => Json.arr #[toJson "sort", levelJson u]
  | .const n us => Json.arr #[toJson "const", nameJson n, Json.arr (us.toArray.map levelJson)]
  | .app f a => Json.arr #[toJson "app", typeJson f, typeJson a]
  | .lam n t b bi => Json.arr #[toJson "lam", nameJson n, typeJson t, typeJson b, binderJson bi]
  | .forallE n t b bi => Json.arr #[toJson "forallE", nameJson n, typeJson t, typeJson b, binderJson bi]
  | .letE n t v b nonDep => Json.arr #[toJson "letE", nameJson n, typeJson t, typeJson v, typeJson b, toJson nonDep]
  | .lit (.natVal n) => Json.arr #[toJson "nat-literal", toJson n]
  | .lit (.strVal value) => Json.arr #[toJson "string-literal", toJson value]
  | .mdata _ e => typeJson e
  | .proj n i e => Json.arr #[toJson "proj", nameJson n, toJson i, typeJson e]

private def kind : ConstantInfo → String
  | .axiomInfo _ => "axiom"
  | .defnInfo _ => "definition"
  | .thmInfo _ => "theorem"
  | .opaqueInfo _ => "opaque"
  | .quotInfo _ => "quotient"
  | .inductInfo _ => "inductive"
  | .ctorInfo _ => "constructor"
  | .recInfo _ => "recursor"

run_cmd do
  let env ← getEnv
  let some output ← liftIO (IO.getEnv "H62_INTERFACE_OUTPUT")
    | throwError "H62_INTERFACE_OUTPUT must name an off-git output path"
  let modules : Array Name := env.header.moduleNames
  let roots : Array (String × Name × ConstantInfo) := env.constants.fold (init := (#[] : Array (String × Name × ConstantInfo))) fun acc n ci =>
    match env.getModuleIdxFor? n with
    | some i =>
      let m := modules[i.toNat]!
      if m.toString.startsWith "Solidity.Examples." then acc.push (m.toString, n, ci) else acc
    | none => acc
  let roots := roots.qsort fun a b => if a.1 == b.1 then (nameJson a.2.1).compress < (nameJson b.2.1).compress else a.1 < b.1
  let handle ← liftIO (IO.FS.Handle.mk output IO.FS.Mode.write)
  let sourceModules : Array String := ((modules.filter fun n => n.toString.startsWith "Solidity.Examples.").map Name.toString).qsort (· < ·)
  liftIO <| handle.putStrLn <| (Json.mkObj [("schema", toJson "h62-examples-interface-v1"), ("modules", toJson sourceModules)]).compress
  for (m, n, ci) in roots do
    if ci.type.hasMVar || ci.type.hasFVar then
      throwError "unexpected open declaration type: {n}"
    let typeRefs := (ci.type.getUsedConstants.map Name.toString).qsort (· < ·)
    let valueRefs := (((ci.value? true).map Expr.getUsedConstants).getD #[] |>.map Name.toString).qsort (· < ·)
    let row := Json.mkObj [
      ("module", toJson m), ("name", toJson n.toString), ("name_key", nameJson n), ("kind", toJson (kind ci)),
      ("unsafe", toJson ci.isUnsafe), ("private_name", toJson (isPrivateName n)),
      ("protected_name", toJson (isProtected env n)), ("level_parameters", Json.arr (ci.levelParams.toArray.map nameJson)),
      ("type", typeJson ci.type), ("type_constants", toJson typeRefs), ("value_constants", toJson valueRefs)]
    liftIO <| handle.putStrLn row.compress
  liftIO <| handle.putStrLn <| (Json.mkObj [("complete", toJson true), ("declarations", toJson roots.size)]).compress
  liftIO handle.flush
  logInfo m!"H62_INTERFACE_DUMP: {roots.size} declarations from {sourceModules.size} example modules"

end H62MigrateExamplesAudit
