+WITHDRAWAL_KEYS = {'question', 'date', 'record', 'prior'}
+
+
+def validate_withdrawal(r):
+    # H37/H70: a withdrawn exclusion is open model work with a diagnostic. Its
+    # former G00 Q1 decision is kept as provenance, never as an active decision.
+    if 'diagnostic' not in r and 'withdrawal' not in r:
+        return
+    assert r.get('diagnostic') == 'unsupported', ('diagnostic without withdrawal', r['id'])
+    w = r.get('withdrawal')
+    assert w and set(w) == WITHDRAWAL_KEYS, ('withdrawal provenance', r['id'], w)
+    assert r['scope'] == 'model' and r['current'] == 'missing', ('withdrawn row is open model work', r['id'])
+    assert 'decision' not in r, ('withdrawn row keeps an active decision', r['id'])
+    assert w['question'] == 'H37/H70' and re.fullmatch(r'\d{4}-\d{2}-\d{2}', w['date']), w
+    path, _, anchor = w['record'].partition('#')
+    assert anchor and (ROOT / path).is_file(), ('withdrawal record not found', w['record'])
+    slug = lambda h: re.sub(r'[^a-z0-9 -]', '', h.lower()).replace(' ', '-')
+    assert any(line.startswith('#') and slug(line.lstrip('#').strip()) == anchor
+               for line in (ROOT / path).read_text().splitlines()), ('withdrawal anchor not found', w['record'])
+    prior = w['prior']
+    assert prior['question'] == 'G00 Q1' and prior['outcome'] == 'approvedExclusion', prior
+    decision_marker(prior['record'], prior['date'])
+
+
