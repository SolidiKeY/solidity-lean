solc_scoped_problems V1Storage.storageCopy_ir.Identity decl

run_cmd do
  for N in [``V1Storage.storageAlias_legacy.Identity, ``V1Storage.storageAlias_ir.Identity,
      ``V1Storage.storageCopy_legacy.Identity, ``V1Storage.storageCopy_ir.Identity] do
    let rows ← reportRows N
    let some row := rows.find? (fun row => row.name == "identity" && row.status == .elaborated && row.tag.modality?.isSome)
      | throwError "{N}: missing admitted modality row"
    liftTermElabM do
      let formula ← testFormula N row
      let goal ← mkAppM ``Solidity.Fml.Valid #[formula]
      let candidate ← Solidity.Tools.refuteSourceCandidateV1? goal
      if candidate.isSome then throwError "{N}: producer capability changed; inspect certificate"
      let certificate := row.declName N ++ `refuted
      if (← getEnv).contains certificate then throwError "{N}: unexpected retained certificate"
      logInfo m!"V1_STORAGE_CASE {N}: admitted; candidate=none; retainedCertificate=absent"

#print axioms Solidity.Frontend.importRowOriginsV1_forget
#print axioms Solidity.Frontend.retainedCounterexampleMetadataV1_forget

-- Audit every theorem generated by these four imports, including input equalities.
run_cmd do
  for (name, info) in (← getEnv).constants.toList do
    if name.toString.startsWith "V1Storage." then
      match info with
      | .thmInfo _ => elabCommand (← `(command| #print axioms $(mkIdent name)))
      | _ => pure ()
