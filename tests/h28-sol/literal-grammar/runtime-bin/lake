#!/bin/bash
set -eu
real=/workspace/scratch/h28-runtime/lean-4.24.0-linux/bin/lake
config=/workspace/solidity-lean/tests/h28-sol/literal-grammar/runtime.toml
serial_lock=/tmp/h28-literal-runtime.lock
case "${1:-}" in
  build)
    shift
    exec flock "$serial_lock" python3 /workspace/solidity-lean/tests/h28-sol/literal-grammar/runtime-bin/serial-build.py "$@" ;;
  serve)
    exec "$real" -f "$config" "$@" --tstack=131072 -j1 ;;
  env)
    if [ "${2:-}" = lean ]; then
      shift 2
      exec flock "$serial_lock" "$real" -f "$config" env lean -j1 "$@"
    fi ;;
  lean)
    exec flock "$serial_lock" "$real" -f "$config" "$@" -- -j1 ;;
  --quiet)
    if [ "${2:-}" = --no-build ] && [ "${3:-}" = lean ]; then
      exec flock "$serial_lock" "$real" -f "$config" "$@" -j1
    fi ;;
  --version|--help|-h)
    exec "$real" -f "$config" "$@" ;;
esac
echo 'h28 runtime: unsupported Lake invocation; use explicit build targets or the supported per-file/probe forms' >&2
exit 2
