info: Solidity/Backend/FailurePaths/ReasonCodecControls.lean:30:0: Solidity.Backend.FailurePaths.ReasonCodecControls.client (pipeline : Roadmap.Pipeline) (reason : Roadmap.Bytes)
  (small : List.length reason ≤ 33) :
  Parametric.compile (global pipeline) 5 (ReasonCodec.statement reason) =
      some (Failure.emit 5 (Failure.Input.custom (errorData reason))) ∧
    Parametric.Reverts (global pipeline) frame 7 0 (ReasonCodec.statement reason) ParametricControls.locals populated
        (errorData reason) ∧
      Failure.Slice.checkedRun (Failure.emit 5 (Failure.Input.custom (errorData reason)) ++ Controls.tail)
            Controls.machine =
          some
            (have __src := Controls.machine;
              { stack := __src.stack, memory := Failure.Slice.putBytes Controls.machine.memory 5 (errorData reason) },
              some (Roadmap.Outcome.revert (errorData reason))) ∧
        Semantics.decodeError
            (Failure.Slice.getBytes (Failure.Slice.putBytes Controls.machine.memory 5 (errorData reason)) 5
              (List.length (errorData reason))) =
          some reason
