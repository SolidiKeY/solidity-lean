     Main.compiler_checked (enteredRevertCompiled C a) input⟩
 
+/-- One Bool cell controls a genuinely completed, nonallocating loop turn. -/
+abbrev TurnCtx : Ctx := .val .bool :: MemCtx
+
+def turnBody : Prog C TurnCtx TurnCtx :=
+  .cons (.assignLocal .here (.simple (.bool false))) .nil
+
+def turnProgram (a : LoopAnn C TurnCtx) : Prog C MemCtx TurnCtx :=
+  .cons (.declLocal .bool (.user "flag") (some (.simple (.bool true))))
+    (.cons (.loop a (.simple (.local .here)) (turnBody C)) .nil)
+
+def turnResult (a : LoopAnn C TurnCtx) :
+    Evm.Memory.Loops.CompiledProg 1 (liveLayout C) (turnProgram C a) :=
+  (Evm.Memory.Loops.compileProg 1 (liveLayout C) (turnProgram C a)).get (by rfl)
+
+def turnCompiled (a : LoopAnn C TurnCtx) :
+    Evm.Compiler.Compilation 1 (liveLayout C) (turnProgram C a) :=
+  .memoryLoops (turnResult C a)
+
+theorem turn_loop_source (a : LoopAnn C TurnCtx) (σ : State C MemCtx) :
+    Stmt.run (σ.push true) (.loop a (.simple (.local .here)) (turnBody C)) =
+      .ok ⟨(σ.push true).setLocal .here false, List.prefix_refl _⟩ := by
+  rw [Stmt.run_loop]
+  exact TLoop.run_of_iterN (n := 2) rfl
+
+theorem turn_program_source (a : LoopAnn C TurnCtx) (σ : State C MemCtx) :
+    Prog.run σ (turnProgram C a) =
+      .ok ⟨(σ.push true).setLocal .here false, List.prefix_refl _⟩ := by
+  rw [turnProgram, Prog.run_cons_ok (show Stmt.run σ
+    (.declLocal .bool (.user "flag") (some (.simple (.bool true)))) =
+      .ok ⟨σ.push true, List.prefix_refl _⟩ from rfl)]
+  rw [Prog.run_cons_ok (turn_loop_source C a σ)]
+  rfl
+
+/-- This prefix uses next, rather than the zero-turn start constructor alone. -/
+theorem turn_completed_prefix (σ : State C MemCtx) :
+    Evm.Memory.LoopPrefix (.simple (.local (.here : Idx TurnCtx (.val .bool))))
+      (turnBody C) (σ.push true)
+      ⟨(σ.push true).setLocal .here false, List.prefix_refl _⟩ 0 := by
+  exact Evm.Memory.LoopPrefix.next
+    (o := ⟨σ.push true, List.prefix_refl _⟩)
+    (o' := ⟨(σ.push true).setLocal .here false, List.prefix_refl _⟩) .start rfl rfl
+
+theorem turn_input (a : LoopAnn C TurnCtx)
+    {σ : State C MemCtx} {base : Nat → Fin Evm.W} {mc : Evm.Machine}
+    (h : Evm.Memory.Objects.StateRepr 1 1 128 (liveLayout C) σ base mc) :
+    (turnCompiled C a).Input 1 128 base σ mc := by
+  change Evm.Memory.StateRepr 1 1 128 (liveLayout C) σ base mc ∧
+    1 + (turnResult C a).cert.need ≤ 128 ∧
+      Evm.Memory.Loops.Room (turnResult C a).cert 128 σ base mc
+  refine ⟨h.legacy, ?_, ?_⟩
+  · change 3 ≤ 128
+    decide +kernel
+  · exact Evm.Memory.Loops.room_nonallocating (turnResult C a).cert
+      (show Evm.Prog.allocates (turnProgram C a) = false from rfl) σ base mc
+
+def turnEntry (mc : Evm.Machine) : Evm.Machine :=
+  Evm.Memory.writeMachine mc 2 (.val (Evm.wmod 1))
+
+def turnExit (mc : Evm.Machine) : Evm.Machine :=
+  Evm.Memory.writeMachine (turnEntry mc) 2 (.val (Evm.wmod 0))
+
+/-- Independent VM evaluation checks true, executes the body, then checks false. -/
+theorem turn_target (a : LoopAnn C TurnCtx) (mc : Evm.Machine) :
+    Evm.run (turnCompiled C a).code mc = .ok (turnExit mc) 0 := by
+  have ht : Evm.loopRun
+      (fun m => Evm.exec [.mload 2] 0 m)
+      (fun m => Evm.exec [.push (.val (Evm.wmod 0)), .mstore 2] 0 m)
+      (turnEntry mc) = .ok (turnExit mc) 0 :=
+    Evm.loopRun_of_iterN (n := 2) rfl
+  with_unfolding_all
+    change ((Evm.loopRun
+      (fun m => Evm.exec [.mload 2] 0 m)
+      (fun m => Evm.exec [.push (.val (Evm.wmod 0)), .mstore 2] 0 m)
+      (turnEntry mc)).bind (fun m k => Evm.exec [] k m)) = _
+  rw [ht]
+  rfl
+
 end Solidity.Assurance.NonVacuityH28
