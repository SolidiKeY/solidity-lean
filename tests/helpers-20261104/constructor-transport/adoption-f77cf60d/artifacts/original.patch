+++import Solidity.Lowering.V08.HelperPackets.ConstructorTransport.Producer
+++
+++/-! Same-case negative order and uint256 boundary controls. -/
+++namespace Solidity.Lowering.V08.HelperPackets.ConstructorTransport
+++open Solidity Source
+++
+++def wrongBody : Source.RBody E :=
+++  ⟨[uint],[],false,[uint],[uint,uint],
+++    .stmt (.expr (.assign (.state savedDecl rfl rfl) (.local .here)))
+++    (.stmt (.declInit (.state savedDecl rfl) rfl)
+++    (.stmt (.expr (.assign (.state capturedDecl rfl rfl) (.local .here))) .nil)),[]⟩
+++def wrongGlobal (p : Roadmap.Pipeline) : Source.Glob E :=
+++  {global p with prog:={program with ctor:=fun c => if c="Cell" then some wrongBody else none}}
+++def wrongReached (bytes : Roadmap.Bytes) (n : Int) (h : range n) :=
+++  write (write (initialized bytes) savedDecl n h) capturedDecl n h
+++
+++theorem wrong_order_actual (p : Roadmap.Pipeline) (bytes : Roadmap.Bytes) (n : Int) (h : range n) :
+++    (Source.construct (wrongGlobal p) frame 16 "Cell" (locals n h)).run
+++      (Source.L0 E,initial bytes) = (.ok (),(Source.L0 E,wrongReached bytes n h)) := by
+++  cases p <;> rfl
+++
+++theorem wrong_order_counterexample (bytes : Roadmap.Bytes) (n : Int) (h : range n) (different : n ≠ 7) :
+++    wrongReached bytes n h ≠ reached bytes n h := by
+++  intro same
+++  have scalar := congrArg (fun s : Source.St E =>
+++    ((s.ex.world.accounts frame.this).storage.read capturedDecl.path).bind (fun v => v.key)) same
+++  change (some n : Option Int) = some 7 at scalar
+++  exact different (Option.some.inj scalar)
+++
+++abbrev maxUint : Int := 2^256-1
+++
+++theorem boundary_zero (p : Roadmap.Pipeline) :
+++    (Source.construct (global p) frame 16 "Cell" (locals 0 (by decide +kernel))).run
+++      (Source.L0 E,initial []) = (.ok (),(Source.L0 E,reached [] 0 (by decide +kernel))) :=
+++  source_actual p [] 0 (by decide +kernel)
+++
+++theorem boundary_max (p : Roadmap.Pipeline) :
+++    (Source.construct (global p) frame 16 "Cell" (locals maxUint (by decide +kernel))).run
+++      (Source.L0 E,initial [0,255,128]) =
+++      (.ok (),(Source.L0 E,reached [0,255,128] maxUint (by decide +kernel))) :=
+++  source_actual p [0,255,128] maxUint (by decide +kernel)
+++
+++theorem boundary_seven :
+++    wrongReached [] 7 (by decide +kernel) = reached [] 7 (by decide +kernel) := rfl
+++def nondefaultInitial (bytes : Roadmap.Bytes) :=
+++  write (write (initial bytes) savedDecl 17 (by decide +kernel)) capturedDecl 88 (by decide +kernel)
+++def nondefaultReached (bytes : Roadmap.Bytes) (n : Int) (h : range n) :=
+++  write (write (write (nondefaultInitial bytes) savedDecl 7 (by decide +kernel)) savedDecl n h)
+++    capturedDecl 7 (by decide +kernel)
+++
+++theorem nondefault_actual (p : Roadmap.Pipeline) (bytes : Roadmap.Bytes) (n : Int) (h : range n) :
+++    (Source.construct (global p) frame 16 "Cell" (locals n h)).run
+++      (Source.L0 E,nondefaultInitial bytes) = (.ok (),(Source.L0 E,nondefaultReached bytes n h)) := by
+++  cases p <;> rfl
+++
+++theorem nondefault_capture (bytes : Roadmap.Bytes) (n : Int) (h : range n) :
+++    ((nondefaultReached bytes n h).ex.world.accounts frame.this).storage.read capturedDecl.path =
+++      some (.int 7 (by decide +kernel)) := rfl
+++end Solidity.Lowering.V08.HelperPackets.ConstructorTransport
++diff --git a/Solidity/Lowering/V08/HelperPackets/ConstructorTransport/Producer.lean b/Solidity/Lowering/V08/HelperPackets/ConstructorTransport/Producer.lean
++new file mode 100644
++index 00000000..1679c622
++--- /dev/null
+++++ b/Solidity/Lowering/V08/HelperPackets/ConstructorTransport/Producer.lean
++@@ -0,0 +1,98 @@
+++import Solidity.Lowering.V08.HelperPackets.ConstructorTransport.Target
+++
+++/-! The concrete SS-NEW body duty derived from actual execution.
+++SlotRel is independent of constructor arguments and post-state definitions. -/
+++namespace Solidity.Lowering.V08.HelperPackets.ConstructorTransport
+++open Solidity
+++open Solidity.Lowering.V07
+++
+++def SlotRel (d : Source.Decl) (r : SRef Cell (.prim .uint))
+++    (s : Source.St E) (t : State Cell [])
+++    (hd : E.lay frame.this d.path = uint := by rfl) : Prop :=
+++  ∃ (v : Int) (hv : range v),
+++    (s.ex.world.accounts frame.this).storage.read d.path = some (hd.symm ▸ (Source.Val.int v hv : Source.Val E.layout uint)) ∧
+++    t.storage.find r = some (.prim (integerValue Source.IntTy.u256 v hv))
+++
+++structure MachineRel (bytes : Roadmap.Bytes) (s : Source.St E) (t : State Cell []) : Prop where
+++  saved : SlotRel savedDecl (SRef.ofRoot "saved" rfl) s t
+++  captured : SlotRel capturedDecl (SRef.ofRoot "captured" rfl) s t
+++  sourceHeap : s.heap = (initial bytes).heap
+++  sourceEvents : s.events = (initial bytes).events
+++  sourceLogs : s.logs = (initial bytes).logs
+++  sourceLocals : s.fnLocals = (initial bytes).fnLocals
+++  targetHeap : t.H = entered.H
+++  heap : HEq t.heap entered.heap
+++  balance : (s.ex.world.accounts frame.this).balance.val = t.selfBalance.1.toNat
+++  net : t.net = entered.net
+++  tx : t.tx = entered.tx
+++
+++theorem initial_related (bytes : Roadmap.Bytes) : MachineRel bytes (initial bytes) entered := by
+++  refine ⟨?_,?_,rfl,rfl,rfl,rfl,rfl,HEq.rfl,rfl,rfl,rfl⟩
+++  · exact ⟨0,by decide +kernel,rfl,rfl⟩
+++  · exact ⟨0,by decide +kernel,rfl,rfl⟩
+++
+++theorem reached_related (bytes : Roadmap.Bytes) (n : Int) (h : range n) :
+++    MachineRel bytes (reached bytes n h) (targetReached n h) := by
+++  refine ⟨?_,?_,rfl,rfl,rfl,rfl,rfl,HEq.rfl,rfl,rfl,rfl⟩
+++  · exact ⟨n,h,source_saved bytes n h,target_saved n h⟩
+++  · exact ⟨7,by decide +kernel,source_captured bytes n h,target_captured n h⟩
+++
+++/-- Exactly the concrete producer duty, with an arbitrary reached Source
+++post-state. The source run determines that state; no body equality or output
+++relation appears among the premises. -/
+++theorem concrete_ssNew_body (p : Roadmap.Pipeline) (bytes : Roadmap.Bytes)
+++    (n : Int) (h : range n) (after : Source.St E) :
+++    (Source.construct (global p) frame 16 "Cell" (locals n h)).run
+++      (Source.L0 E,initial bytes) = (.ok (),(Source.L0 E,after)) →
+++    ∃ out : Out Cell entered.H [],
+++      (targetBody n h).run entered = .ok out ∧ MachineRel bytes after out.st := by
+++  intro ran
+++  rw [source_actual p bytes n h] at ran
+++  have same : reached bytes n h = after := congrArg (fun x => x.2.2) ran
+++  subst after
+++  exact ⟨⟨targetReached n h,List.prefix_refl _⟩,target_body_actual n h,reached_related bytes n h⟩
+++
+++/-- Both pipelines reach related complete machines and create the specified
+++address; Source.construct is a constructor phase, not code installation. -/
+++theorem complete_transport (p : Roadmap.Pipeline) (bytes : Roadmap.Bytes)
+++    (n : Int) (h : range n) :
