+++
+++theorem target_captured (n : Int) (h : range n) :
+++    (targetStore n h).find (SRef.ofRoot "captured" rfl) =
+++      some (.prim (integerValue Source.IntTy.u256 7 (by decide +kernel))) := by rfl
+++
