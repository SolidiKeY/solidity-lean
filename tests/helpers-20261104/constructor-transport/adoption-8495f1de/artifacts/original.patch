++  ⟨[uint],[],false,[uint],[uint,uint],
++    .stmt (.declInit (.state savedDecl rfl) rfl)
++    (.stmt (.expr (.assign (.state savedDecl rfl rfl) (.local (.there .here))))
++    (.stmt (.expr (.assign (.state capturedDecl rfl rfl) (.local .here))) .nil)),[]⟩
