++  let s := (s.write (SRef.ofRoot "saved" rfl) (.prim (integerValue Source.IntTy.u256 n h))).getD s
++  (s.write (SRef.ofRoot "captured" rfl) (.prim (integerValue Source.IntTy.u256 7 (by decide +kernel)))).getD s
