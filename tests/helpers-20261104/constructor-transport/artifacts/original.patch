+#!/usr/bin/env bash
+set -uo pipefail
+cd /workspace/solidity-lean
+exec 9>/tmp/solidity-lean-feature-groups-20261025/writer.lock
+flock 9
+out=tests/helpers-20261104/constructor-transport/final-gates
+mkdir -p "$out"
+: > "$out/gates.tsv"
+failed=0
+run() {
+  local name=$1; shift
+  local result=0 command
+  printf -v command '%q ' "$@"
+  command=${command% }
+  bash tests/helpers-20261104/constructor-transport/bounded.sh "$@" > "$out/$name.log" 2>&1 || result=$?
+  printf '%s	%s	%s
+' "$name" "$result" "$command" >> "$out/gates.tsv"
+  printf '%s EXIT=%s
+' "$name" "$result"
+  if [ "$result" -ne 0 ]; then failed=1; fi
+}
+run runtime /bin/bash -c 'set -e; printf "MEMORY_MAX="; cat /sys/fs/cgroup/memory.max; printf "SWAP_MAX="; cat /sys/fs/cgroup/memory.swap.max; lake --version; lean --version; lake env lean -j1 --tstack=131072 Solidity/KeySort.lean; echo "KeySort PASS; RUNTIME_GATE_PASS"'
+run packet-build lake -f tests/helpers-20261104/constructor-transport/serial.toml build Solidity.Lowering.V08.HelperPackets.ConstructorTransport.Controls
+run axiom-pins lake env lean -j1 --tstack=131072 tests/helpers-20261104/constructor-transport/AxiomPins.lean
+run controls-mcp /bin/bash -c 'export PATH=/workspace/solidity-lean/tests/helpers-20261104/constructor-transport/bin:$PATH; export LEAN_LSP_MAX_OPEN_FILES=1; trap "python3 scripts/coord-tools/lean-mcp stop" EXIT; python3 scripts/coord-tools/lean-mcp diag Solidity/Lowering/V08/HelperPackets/ConstructorTransport/Controls.lean'
+run compiler node tests/helpers-20261104/constructor-transport/compiler-control.cjs
+run full-gate /bin/bash run-lean.sh
+exit "$failed"
diff --git a/tests/helpers-20261104/constructor-transport/compiler-control.cjs b/tests/helpers-20261104/constructor-transport/compiler-control.cjs
new file mode 100644
index 00000000..cde80c54
--- /dev/null
+++ b/tests/helpers-20261104/constructor-transport/compiler-control.cjs
@@ -0,0 +1,28 @@
+const fs = require('node:fs');
+const crypto = require('node:crypto');
+const assert = require('node:assert/strict');
+const solcPath = '/workspace/.setup/soljson/soljson-v0.8.34+commit.80d5c536.js';
+const compilerHash = crypto.createHash('sha256').update(fs.readFileSync(solcPath)).digest('hex');
+assert.equal(compilerHash, 'c8649f8d57f81b3244c7d2dd662efc0620d1ae296f623b347a2c616a6cfd11d8');
+const solc = require(solcPath);
+const compile = solc.cwrap('solidity_compile', 'string', ['string', 'number', 'number']);
+const source = fs.readFileSync(__dirname + '/Cell.sol', 'utf8');
+const records = [];
+for (const viaIR of [false, true]) {
+ const input = {language: 'Solidity', sources: {'Cell.sol': {content: source}}, settings: {
+   viaIR, optimizer: {enabled: false}, evmVersion: 'osaka',
+   outputSelection: {'*': {'*': ['evm.bytecode.object', 'storageLayout']}}
+ }};
+ const output = JSON.parse(compile(JSON.stringify(input), 0, 0));
+ assert.deepEqual((output.errors || []).filter(e => e.severity === 'error'), []);
+ const cell = output.contracts['Cell.sol'].Cell;
+ assert.ok(cell.evm.bytecode.object.length > 0);
+ assert.deepEqual(cell.storageLayout.storage.map(x => [x.label, x.slot]), [['saved', '0'], ['captured', '1']]);
+ records.push({pipeline: viaIR ? 'viaIR' : 'legacy', creationBytes: cell.evm.bytecode.object.length/2,
+   bytecodeSha256: crypto.createHash('sha256').update(Buffer.from(cell.evm.bytecode.object, 'hex')).digest('hex'),
+   slots: cell.storageLayout.storage.map(x => [x.label,x.slot])});
+}
+console.log(JSON.stringify({version: solc.cwrap('solidity_version', 'string', [])(),
+ compilerSha256: crypto.createHash('sha256').update(fs.readFileSync(solcPath)).digest('hex'),
+ sourceSha256: crypto.createHash('sha256').update(source).digest('hex'), records,
+ boundary: 'Compiler acceptance and slot controls only; no EVM execution or compiler-correctness proof.'}, null, 2));
