{
  "name": "solidity-lean-offline-ide",
  "version": "0.1.0",
  "private": true,
  "description": "Offline web workbench for the Solidity Lean VS Code extension",
  "scripts": {
    "start": "node server.cjs",
    "test": "node --test test/server.test.cjs",
    "test:browser": "node test/browser.cjs",
    "test:proofs": "node test/browser.cjs --proofs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "monaco-editor": "0.55.1",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "pixelmatch": "7.1.0",
    "playwright": "1.62.1",
    "pngjs": "7.0.0"
  }
}
