diff --git a/src/kernel/replace_fn.cpp b/src/kernel/replace_fn.cpp
index 08e6b17..5ee4e3e 100644
--- a/src/kernel/replace_fn.cpp
+++ b/src/kernel/replace_fn.cpp
@@ -13,6 +13,90 @@ Author: Leonardo de Moura
 
 namespace lean {
 
+#ifdef LEAN_EMSCRIPTEN
+// Browser engines have a small machine-call stack. Keep the original preorder,
+// cache policy and scope offsets while placing traversal continuations on the
+// heap. Borrow original nodes: extra owning references would change sharing
+// tests and therefore the callback/cache behavior.
+template<typename Enter, typename Finish>
+static expr browser_replace_iterative(expr const & root, unsigned offset, Enter enter, Finish finish) {
+    struct frame {
+        expr const * source;
+        unsigned offset;
+        unsigned stage{0};
+        bool shared{false};
+        expr first;
+        expr second;
+        frame(expr const & e, unsigned n):source(&e),offset(n) {}
+    };
+    std::vector<frame> frames;
+    frames.emplace_back(root, offset);
+    expr value;
+    while (!frames.empty()) {
+        frame & current = frames.back();
+        expr const & e = *current.source;
+        unsigned n = current.offset;
+        if (current.stage == 0) {
+            if (optional<expr> result = enter(e, n, current.shared)) {
+                value = std::move(*result);
+                frames.pop_back();
+                continue;
+            }
+            current.stage = 1;
+            switch (e.kind()) {
+            case expr_kind::Const: case expr_kind::Sort:
+            case expr_kind::BVar: case expr_kind::Lit:
+            case expr_kind::MVar: case expr_kind::FVar:
+                value = finish(e, n, e, current.shared);
+                frames.pop_back();
+                continue;
+            case expr_kind::MData: frames.emplace_back(mdata_expr(e), n); continue;
+            case expr_kind::Proj: frames.emplace_back(proj_expr(e), n); continue;
+            case expr_kind::App: frames.emplace_back(app_fn(e), n); continue;
+            case expr_kind::Pi: case expr_kind::Lambda:
+                frames.emplace_back(binding_domain(e), n); continue;
+            case expr_kind::Let: frames.emplace_back(let_type(e), n); continue;
+            }
+            lean_unreachable();
+        }
+        switch (e.kind()) {
+        case expr_kind::MData:
+            value = finish(e, n, update_mdata(e, value), current.shared); break;
+        case expr_kind::Proj:
+            value = finish(e, n, update_proj(e, value), current.shared); break;
+        case expr_kind::App: case expr_kind::Pi: case expr_kind::Lambda:
+            if (current.stage == 1) {
+                current.first = std::move(value);
+                current.stage = 2;
+                if (e.kind() == expr_kind::App) frames.emplace_back(app_arg(e), n);
+                else frames.emplace_back(binding_body(e), n + 1);
+                continue;
+            }
+            value = finish(e, n, e.kind() == expr_kind::App ? update_app(e, current.first, value) : update_binding(e, current.first, value), current.shared);
+            break;
+        case expr_kind::Let:
+            if (current.stage == 1) {
+                current.first = std::move(value);
+                current.stage = 2;
+                frames.emplace_back(let_value(e), n);
+                continue;
+            }
+            if (current.stage == 2) {
+                current.second = std::move(value);
+                current.stage = 3;
+                frames.emplace_back(let_body(e), n + 1);
+                continue;
+            }
+            value = finish(e, n, update_let(e, current.first, current.second, value), current.shared);
+            break;
+        default: lean_unreachable();
+        }
+        frames.pop_back();
+    }
+    return value;
+}
+#endif
