+                lean_dec_ref(result);
+                return some_expr(save_result(node, replaced, shared));
+            }, [&](expr const & node, unsigned, expr result, bool shared) {
+                return save_result(node, result, shared);
+            });
+#else
         bool shared = false;
         if (is_shared(e)) {
             auto it = m_cache.find(e.raw());
@@ -142,6 +261,7 @@ class replace_fn {
             return save_result(e, update_let(e, new_t, new_v, new_b), shared);
         }}
         lean_unreachable();
+    #endif
