+#ifdef LEAN_EMSCRIPTEN
+        return browser_replace_iterative(e, 0,
+            [&](expr const & node, unsigned, bool & shared) -> optional<expr> {
+                if (is_shared(node)) {
+                    auto it = m_cache.find(node.raw());
+                    if (it != m_cache.end()) return some_expr(it->second);
+                    shared = true;
