import Solidity.Backend.Creation.Laws

/-! Bounded section/source-map records. Source anchors are supplied metadata;
these laws certify byte ranges, not frontend source-map fidelity or source
execution. The source file's actual supplied contents determine source bounds. -/
namespace Solidity.Backend.Creation

inductive Section where
  | wrapper | runtime | arguments
  deriving DecidableEq, Repr

def sectionBytes (a : Artifact Lib) : Section → List UInt8
  | .wrapper => encode (wrapper a.lengthWord)
  | .runtime => a.runtime
  | .arguments => a.args

def sectionStart (a : Artifact Lib) : Section → Nat
  | .wrapper => 0
  | .runtime => a.runtimeStart
  | .arguments => a.argsStart

theorem section_slice (a : Artifact Lib) (s : Section) :
    (a.payload.drop (sectionStart a s)).take (sectionBytes a s).length = sectionBytes a s := by
  cases s with
  | wrapper =>
    change (((encode (wrapper a.lengthWord) ++ a.runtime) ++ a.args).drop 0).take
      (encode (wrapper a.lengthWord)).length = _
    rw [List.drop_zero, List.append_assoc, List.take_left]
    rfl
  | runtime => exact a.runtime_slice
  | arguments =>
    change (a.payload.drop a.argsStart).take a.args.length = a.args
    rw [a.args_slice, List.take_length]

theorem section_bounds (a : Artifact Lib) (s : Section) :
    sectionStart a s + (sectionBytes a s).length ≤ a.payload.length := by
  cases s <;> simp only [sectionStart, sectionBytes, Artifact.payload, Artifact.initcode,
    Artifact.runtimeStart, Artifact.argsStart, List.length_append, wrapper_length] <;> omega

structure SourceFile where
  path : String
  bytes : List UInt8

/-- A range of generated bytes and the source range supplied by its producer.
Source span width need not equal generated byte width. -/
structure Provenance (a : Artifact Lib) where
  part : Section
  width : Nat
  location : Location (sectionBytes a part).length width
  source : SourceFile
  sourceWidth : Nat
  sourceRange : Location source.bytes.length sourceWidth

def Provenance.globalOffset (p : Provenance a) : Nat := sectionStart a p.part + p.location.offset

theorem Provenance.global_bounds (p : Provenance a) :
    p.globalOffset + p.width ≤ a.payload.length := by
  have hs : sectionStart a p.part + (sectionBytes a p.part).length ≤ a.payload.length := section_bounds a p.part
  have hl : p.location.offset + p.width ≤ (sectionBytes a p.part).length := p.location.bounds
  unfold Provenance.globalOffset
  omega

theorem Provenance.bytes_exact (p : Provenance a) :
    (a.payload.drop p.globalOffset).take p.width =
      ((sectionBytes a p.part).drop p.location.offset).take p.width := by
  have h : (((a.payload.drop (sectionStart a p.part)).take (sectionBytes a p.part).length).drop p.location.offset).take p.width =
      ((sectionBytes a p.part).drop p.location.offset).take p.width :=
    congrArg (fun bytes => (bytes.drop p.location.offset).take p.width) (section_slice a p.part)
  have hl : p.width ≤ (sectionBytes a p.part).length - p.location.offset := by
    have hb : p.location.offset + p.width ≤ (sectionBytes a p.part).length := p.location.bounds
    omega
  simpa only [List.drop_take, List.take_take, List.drop_drop, Nat.min_eq_left hl,
    Provenance.globalOffset] using h

end Solidity.Backend.Creation
