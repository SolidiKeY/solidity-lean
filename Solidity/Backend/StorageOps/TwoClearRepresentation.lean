import Solidity.Backend.StorageOps.TargetArrayDeleteSequence
import Solidity.Backend.StorageOps.TargetClearRepresentation

/-! Two actual CURRENT-header numeric clears and the PUBLIC graph relation.
Second OLD owner/transport/target agreement are derived from generated writes,
not supplied as desired intermediate preservation premises. -/
namespace Solidity.Backend.StorageOps.TwoClearRepresentation
open TypeGraph Solidity.Storage Solidity.Storage.Representation Solidity.Storage.Representation.Graph

def execute (N : Nat) (hash : Solidity.Storage.Pre → Nat) (left right : Solidity.Storage.Loc)
    (numeric : WordStore) : WordStore :=
  TargetClearRepresentation.execute N hash right (TargetClearRepresentation.execute N hash left numeric)

def afterStore {n m : Nat} {G : Schema n} {H : Schema m} {p q : PrimTy}
    (left : Value G (.array (.prim p))) (right : Value H (.array (.prim q)))
    (leftBase rightBase : Solidity.Storage.Loc) (store : Store) : Store :=
  TargetClearRepresentation.afterStore right rightBase (TargetClearRepresentation.afterStore left leftBase store)

/-- Operation-side application of the EXISTING PUBLIC owner, using the exact
header/live prefix generated by clear. Source compatibility/read outcomes stay
unchanged; even failed reads do not supply a default physical word. -/
theorem represented_clear_frame {n m : Nat} {G : Schema n} {H : Schema m} {p : PrimTy} {A : TypeGraph.Ty m}
    (cleared : Value G (.array (.prim p))) (value : Value H A) (queries : List (Query H A))
    (clearedBase observedBase : Solidity.Storage.Loc) (store : Store)
    (before : Represented value queries observedBase store)
    (outside : ∀ query ∈ queries, query.location observedBase ≠ clearedBase ∧
      ∀ j, j < cleared.length.val → query.location observedBase ≠ .data clearedBase j) :
    Represented value queries observedBase (TargetClearRepresentation.afterStore cleared clearedBase store) := by
  intro query member
  obtain ⟨supported,compatible,observed⟩ := before query member
  refine ⟨supported,compatible,?_⟩
  intro word found
  unfold TargetClearRepresentation.afterStore
  rw [Representation.write_other _ _ _ _ (outside query member).1,
    TargetClearRepresentation.symbolic_outside store clearedBase (query.location observedBase) cleared.length.val (outside query member).2]
  exact observed word found

/-- Actual two-loop code, both PUBLIC postowners, numeric transport and selected
readbacks. Each numeric algorithm and target loop reads its CURRENT header.
Heterogeneous schemas/primitive endpoints share only the existing Store/run. -/
theorem complete {n m N L R : Nat} {G : Schema n} {H : Schema m} {p q : PrimTy}
    {hash : Solidity.Storage.Pre → Nat} {P : List Solidity.Storage.Pre} {locations : List Solidity.Storage.Loc}
    (run : FiniteRun N L R hash P locations)
    (left : Value G (.array (.prim p))) (right : Value H (.array (.prim q)))
    (leftIndices rightIndices : List Index) (leftBase rightBase : Solidity.Storage.Loc)
    (leftFits : TargetOperations.KeysFit leftBase) (rightFits : TargetOperations.KeysFit rightBase)
    (store : Store) (numeric : WordStore) (target : Evm.Machine) (tail : List Evm.Word)
    (leftBefore : Represented left (TargetClearRepresentation.oldQueries left leftIndices) leftBase store)
    (rightBefore : Represented right (TargetClearRepresentation.oldQueries right rightIndices) rightBase store)
    (rightOldFrame : ∀ query ∈ TargetClearRepresentation.oldQueries right rightIndices,
      query.location rightBase ≠ leftBase ∧ ∀ j, j < left.length.val → query.location rightBase ≠ .data leftBase j)
    (leftPostFrame : ∀ query ∈ PrimitivePop.queries (G := G) (p := p) leftIndices,
      query.location leftBase ≠ rightBase ∧ ∀ j, j < right.length.val → query.location leftBase ≠ .data rightBase j)
    (initial : Transport N hash locations store numeric)
    (leftCovered : ∀ query ∈ PrimitivePop.queries (G := G) (p := p) leftIndices, query.location leftBase ∈ locations)
    (rightCovered : ∀ query ∈ PrimitivePop.queries (G := H) (p := q) rightIndices, query.location rightBase ∈ locations)
    (leftVisited : ∀ j, j < left.length.val → Solidity.Storage.Loc.data leftBase j ∈ locations)
    (rightVisited : ∀ j, j < right.length.val → Solidity.Storage.Loc.data rightBase j ∈ locations)
    (fitting : ∀ l ∈ locations, TargetOperations.KeysFit l)
    (targetInitial : ∀ l (member : l ∈ locations), target.store.cells (TargetOperations.toSlot l (fitting l member)) = TargetOperations.encodeWord (store l)) :
    let finalStore := afterStore left right leftBase rightBase store
    let finalNumeric := execute N hash leftBase rightBase numeric
    let finalTarget := TargetArrayDeleteSequence.after target tail
      (TargetOperations.toSlot leftBase leftFits) (TargetOperations.toSlot rightBase rightFits)
    Evm.run (TargetArrayDeleteSequence.code (TargetOperations.toSlot rightBase rightFits))
      {target with stack := .slot (TargetOperations.toSlot leftBase leftFits) :: tail} = .ok finalTarget 0 ∧
    Represented left.clear (PrimitivePop.queries leftIndices) leftBase finalStore ∧
    Represented right.clear (PrimitivePop.queries rightIndices) rightBase finalStore ∧
    Transport N hash locations finalStore finalNumeric ∧
    (∀ l (member : l ∈ locations), finalTarget.store.cells (TargetOperations.toSlot l (fitting l member)) =
      TargetOperations.encodeWord (finalNumeric (l.word N hash))) ∧
    (∀ query ∈ PrimitivePop.queries (G := G) (p := p) leftIndices, ∀ word, query.read left.clear = some word →
      finalNumeric ((query.location leftBase).word N hash) = word) ∧
    (∀ query ∈ PrimitivePop.queries (G := H) (p := q) rightIndices, ∀ word, query.read right.clear = some word →
      finalNumeric ((query.location rightBase).word N hash) = word) := by
  dsimp only
  have first := TargetClearRepresentation.complete run left leftIndices leftBase leftFits store numeric target tail
    leftBefore initial leftCovered leftVisited fitting targetInitial
  have rightMiddle := represented_clear_frame left right (TargetClearRepresentation.oldQueries right rightIndices)
    leftBase rightBase store rightBefore rightOldFrame
  have targetMiddle : ∀ l (member : l ∈ locations),
      (TargetArrayClear.afterClear target tail (TargetOperations.toSlot leftBase leftFits)).store.cells (TargetOperations.toSlot l (fitting l member)) =
        TargetOperations.encodeWord (TargetClearRepresentation.afterStore left leftBase store l) := by
    intro l member
    exact (first.2.2.2.1 l member).trans (congrArg TargetOperations.encodeWord (first.2.2.1 l member))
  have second := TargetClearRepresentation.complete run right rightIndices rightBase rightFits
    (TargetClearRepresentation.afterStore left leftBase store) (TargetClearRepresentation.execute N hash leftBase numeric)
    (TargetArrayClear.afterClear target tail (TargetOperations.toSlot leftBase leftFits)) tail
    rightMiddle first.2.2.1 rightCovered rightVisited fitting targetMiddle
  have leftFinal := represented_clear_frame right left.clear (PrimitivePop.queries leftIndices)
    rightBase leftBase (TargetClearRepresentation.afterStore left leftBase store) first.2.1 leftPostFrame
  refine ⟨TargetArrayDeleteSequence.run_current target tail _ _,leftFinal,second.2.1,second.2.2.1,second.2.2.2.1,?_,second.2.2.2.2⟩
  intro query member word found
  exact leftFinal.numeric second.2.2.1 query member (leftCovered query member) word found

/-- Physical frames use OLD access counts. The second CURRENT numeric header
is derived from the framed PUBLIC owner and generated first transport, never
assumed as a middle/postcondition. Unrepresented outside words are preserved. -/
theorem physical_frame {n m N L R : Nat} {G : Schema n} {H : Schema m} {p q : PrimTy}
    {hash : Solidity.Storage.Pre → Nat} {P : List Solidity.Storage.Pre} {locations : List Solidity.Storage.Loc}
    (run : FiniteRun N L R hash P locations)
    (left : Value G (.array (.prim p))) (right : Value H (.array (.prim q)))
    (leftBase rightBase : Solidity.Storage.Loc) (store : Store) (numeric : WordStore)
    (leftHeader : Represented left [.length .nil] leftBase store)
    (rightHeader : Represented right [.length .nil] rightBase store)
    (rightFrame : rightBase ≠ leftBase ∧ ∀ j, j < left.length.val → rightBase ≠ .data leftBase j)
    (initial : Transport N hash locations store numeric)
    (leftCovered : leftBase ∈ locations) (rightCovered : rightBase ∈ locations)
    (leftVisited : ∀ j, j < left.length.val → Solidity.Storage.Loc.data leftBase j ∈ locations)
    (address : Nat)
    (outsideLeftHeader : address ≠ leftBase.word N hash)
    (outsideLeftData : ∀ j, j < left.length.val → address ≠ (Solidity.Storage.Loc.data leftBase j).word N hash)
    (outsideRightHeader : address ≠ rightBase.word N hash)
    (outsideRightData : ∀ j, j < right.length.val → address ≠ (Solidity.Storage.Loc.data rightBase j).word N hash) :
    execute N hash leftBase rightBase numeric address = numeric address := by
  have leftWord := LifecycleNumeric.array_header_numeric left leftBase store numeric hash locations leftHeader initial leftCovered
  have leftLength := LifecycleNumeric.headerLength_known hash leftBase numeric left.length leftWord
  have transportedPrefix := TargetClearRepresentation.prefix_numeric run store numeric leftBase initial left.length.val leftVisited
  have final := transport_write run transportedPrefix leftBase leftCovered ClearDemands.zero
  have middleTransport : Transport N hash locations (TargetClearRepresentation.afterStore left leftBase store)
      (TargetClearRepresentation.execute N hash leftBase numeric) := by
    unfold TargetClearRepresentation.execute
    rw [leftLength]
    exact final
  have middleOwner := represented_clear_frame left right [.length .nil] leftBase rightBase store rightHeader
    (by intro query member; have same := List.mem_singleton.mp member; subst query; exact rightFrame)
  have rightWord := LifecycleNumeric.array_header_numeric right rightBase (TargetClearRepresentation.afterStore left leftBase store)
    (TargetClearRepresentation.execute N hash leftBase numeric) hash locations middleOwner middleTransport rightCovered
  have rightLength := LifecycleNumeric.headerLength_known hash rightBase (TargetClearRepresentation.execute N hash leftBase numeric) right.length rightWord
  unfold execute
  rw [TargetClearRepresentation.numeric_outside N hash _ rightBase address outsideRightHeader
    (by intro j inside; rw [rightLength] at inside; exact outsideRightData j inside)]
  exact TargetClearRepresentation.numeric_outside N hash numeric leftBase address outsideLeftHeader
    (by intro j inside; rw [leftLength] at inside; exact outsideLeftData j inside)

/-- info: 'Solidity.Backend.StorageOps.TwoClearRepresentation.represented_clear_frame' depends on axioms: [propext,
 Classical.choice,
 Quot.sound] -/
#guard_msgs in #print axioms represented_clear_frame
/-- info: 'Solidity.Backend.StorageOps.TwoClearRepresentation.complete' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in #print axioms complete
/-- info: 'Solidity.Backend.StorageOps.TwoClearRepresentation.physical_frame' depends on axioms: [propext,
 Classical.choice,
 Quot.sound] -/
#guard_msgs in #print axioms physical_frame
end Solidity.Backend.StorageOps.TwoClearRepresentation
