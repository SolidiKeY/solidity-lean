import Solidity.Backend.InternalFlow.RuntimeFrameInterfaceV3
import Solidity.Lowering.P8.ProducerAssembly

/-! Approved-profile provenance interface, version 1. Generated by
scripts/generate-runtime-frame-approved-profile.py. There is no producer
instance, default admission domain, execution oracle or new source semantics.
The source specification, origins, admission half and input correspondence
must be independently pinned to the original source/resource profile.
Existing frozen V3 signatures are unchanged. -/
namespace Solidity.Backend.InternalFlow.RuntimeFrame.ApprovedProfile
open Evm Evm.Memory
open Solidity.Lowering.P8

/-- An explicit external input-correspondence dependency. It relates the
EXISTING source-origin program, exact artifact, environment and resource to the SAME intrinsic
caller, address map, machine, frame and quotation index used by V3. No value
of this type is provided. Its actual-source adequacy remains a producer duty;
it must not be chosen from an emitter's Entry, run or admission predicate. -/
abbrev SourceInputs (S : P8a.Spec) (C : Contract) (Γ : Ctx) :=
 P8a.SourceProgram → Roadmap.Artifact → S.lang.Env → S.lang.Res →
 (index L frame : Nat) → State C Γ → (Nat → Fin W) → Machine → Nat → Prop

/-- Exact image of the published admission half and independently supplied
source/runtime input relation. All and only such linked source cases are
retained for the SAME supplied artifact; no existential artifact replacement
is allowed. No NoFail, Forward-only, fixed-index or extra resource exclusion is
introduced. This definition alone proves no actual correspondence. -/
def sourceImage {C : Contract} {Γ : Ctx} {S : P8a.Spec} {roots : P8a.RootModel S}
 (admission : ProducerAssembly.AdmissionHalf S roots) (origins : P8a.SourceOrigins S)
 (artifact : Roadmap.Artifact) (inputs : SourceInputs S C Γ) (index : Nat) : InterfaceV3.Admission C Γ :=
 fun L frame caller base machine start =>
   ∃ (input : S.Input) (resolved : S.Resolved) (well : S.WellFormed resolved)
     (profile : S.InProfile resolved)
     (environment : S.lang.Env) (resource : S.lang.Res),
     admission.admission.frontend input = some resolved ∧
     S.lang.Allowed environment ∧ S.lang.Admissible resource ∧
     inputs (origins.meaning resolved well profile artifact) artifact environment resource
       index L frame caller base machine start

/-- Pending provenance and runtime agreement at a specified index. The
external source inputs are parameters, not models selected by this record.
Inhabiting it does not supply a P8 realization, runtime frame producer or the
actual-source adequacy of SourceInputs. All remain separate obligations. -/
structure Pending {C : Contract} {Γ : Ctx} {S : P8a.Spec} {roots : P8a.RootModel S}
 (admission : ProducerAssembly.AdmissionHalf S roots) (origins : P8a.SourceOrigins S)
 (artifact : Roadmap.Artifact) (inputs : SourceInputs S C Γ) (index : Nat)
 (approved admitted : InterfaceV3.Admission C Γ) where
 required_source : InterfaceV3.AdmissionAgreement approved (sourceImage admission origins artifact inputs index)
 required_agreement : InterfaceV3.AdmissionAgreement approved admitted

/-- The same provenance/agreement duties at EVERY supplied index. This
reuses V3's actual family agreement without replacing its coverage, code,
success/revert witnesses, source coherence or target execution claims. No
record inhabitant or claim of full-profile coverage is provided. -/
structure PendingFamily {C : Contract} {Γ : Ctx} {S : P8a.Spec} {roots : P8a.RootModel S}
 (admission : ProducerAssembly.AdmissionHalf S roots) (origins : P8a.SourceOrigins S)
 (artifact : Roadmap.Artifact) (inputs : SourceInputs S C Γ)
 (approved admitted : Nat → InterfaceV3.Admission C Γ) where
 required_source : InterfaceV3.FamilyAdmissionAgreement approved (sourceImage admission origins artifact inputs)
 required_agreement : InterfaceV3.FamilyAdmissionAgreement approved admitted

end Solidity.Backend.InternalFlow.RuntimeFrame.ApprovedProfile
