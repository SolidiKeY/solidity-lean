  naturalThresholdRow24,
  naturalThresholdRow25,
  naturalThresholdRow26,
  naturalThresholdRow27,
  naturalThresholdRow28,
  naturalThresholdRow29,
  naturalThresholdRow30,
  naturalThresholdRow31
]

theorem threshold_bounds : ∀ (w : Fin 32) (i : Fin 255),
    naturalThresholds[w][i] < 2 ^ widthBits w ∧
    naturalThresholds[w][i] ^ (i.val + 1) < 2 ^ widthBits w ∧
    2 ^ widthBits w ≤ (naturalThresholds[w][i] + 1) ^ (i.val + 1) := by
  intro w i
  have hw : w = 0 ∨ w = 1 ∨ w = 2 ∨ w = 3 ∨ w = 4 ∨ w = 5 ∨ w = 6 ∨ w = 7 ∨ w = 8 ∨ w = 9 ∨ w = 10 ∨ w = 11 ∨ w = 12 ∨ w = 13 ∨ w = 14 ∨ w = 15 ∨ w = 16 ∨ w = 17 ∨ w = 18 ∨ w = 19 ∨ w = 20 ∨ w = 21 ∨ w = 22 ∨ w = 23 ∨ w = 24 ∨ w = 25 ∨ w = 26 ∨ w = 27 ∨ w = 28 ∨ w = 29 ∨ w = 30 ∨ w = 31 := by omega
  rcases hw with h0 | h1 | h2 | h3 | h4 | h5 | h6 | h7 | h8 | h9 | h10 | h11 | h12 | h13 | h14 | h15 | h16 | h17 | h18 | h19 | h20 | h21 | h22 | h23 | h24 | h25 | h26 | h27 | h28 | h29 | h30 | h31
  · subst w; exact rowBounds0 i
  · subst w; exact rowBounds1 i
  · subst w; exact rowBounds2 i
  · subst w; exact rowBounds3 i
  · subst w; exact rowBounds4 i
  · subst w; exact rowBounds5 i
  · subst w; exact rowBounds6 i
  · subst w; exact rowBounds7 i
  · subst w; exact rowBounds8 i
  · subst w; exact rowBounds9 i
  · subst w; exact rowBounds10 i
  · subst w; exact rowBounds11 i
  · subst w; exact rowBounds12 i
  · subst w; exact rowBounds13 i
  · subst w; exact rowBounds14 i
  · subst w; exact rowBounds15 i
  · subst w; exact rowBounds16 i
  · subst w; exact rowBounds17 i
  · subst w; exact rowBounds18 i
  · subst w; exact rowBounds19 i
  · subst w; exact rowBounds20 i
  · subst w; exact rowBounds21 i
  · subst w; exact rowBounds22 i
  · subst w; exact rowBounds23 i
  · subst w; exact rowBounds24 i
  · subst w; exact rowBounds25 i
  · subst w; exact rowBounds26 i
  · subst w; exact rowBounds27 i
  · subst w; exact rowBounds28 i
  · subst w; exact rowBounds29 i
  · subst w; exact rowBounds30 i
  · subst w; exact rowBounds31 i

def thresholdWord (w : Fin 32) (i : Fin 255) : Word :=
  BitVec.ofNat 256 naturalThresholds[w][i]

def exponentWord (i : Fin 255) : Word := BitVec.ofNat 256 (i.val + 1)

theorem thresholdWord_nat (w : Fin 32) (i : Fin 255) :
    (thresholdWord w i).toNat = naturalThresholds[w][i] := by
  have hb : naturalThresholds[w][i] < 2 ^ 256 :=
    Nat.lt_of_lt_of_le (threshold_bounds w i).1
      (Nat.pow_le_pow_right (by decide) (widthBits_bounds w).2)
  simp only [thresholdWord, BitVec.toNat_ofNat, Nat.mod_eq_of_lt hb]

theorem exponentWord_nat (i : Fin 255) :
    (exponentWord i).toNat = i.val + 1 := by
  have hi : i.val + 1 < 2 ^ 256 := by have : i.val < 255 := i.isLt; omega
  simp only [exponentWord, BitVec.toNat_ofNat, Nat.mod_eq_of_lt hi]

#print axioms threshold_bounds

end Solidity.Backend.Scalar
