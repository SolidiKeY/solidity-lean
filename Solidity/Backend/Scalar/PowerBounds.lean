/-!
# Checked-power threshold constants

Generated by scripts/backend-scalar-thresholds.py. The generator is not
trusted: threshold_bounds is checked by the Lean kernel over every entry,
row by row in `PowerBounds/Part01`–`Part08`.
The constants are numeric compiler data, not a source or opcode language.
-/
-- Keep the 32 kernel-checked rows from retaining concurrent proof tasks.
set_option Elab.async false

namespace Solidity.Backend.Scalar

def naturalThresholds : Vector (Vector Nat 255) 32 := #v[
  naturalThresholdRow0,
  naturalThresholdRow1,
  naturalThresholdRow2,
  naturalThresholdRow3,
  naturalThresholdRow4,
  naturalThresholdRow5,
  naturalThresholdRow6,
  naturalThresholdRow7,
  naturalThresholdRow8,
  naturalThresholdRow9,
  naturalThresholdRow10,
  naturalThresholdRow11,
  naturalThresholdRow12,
