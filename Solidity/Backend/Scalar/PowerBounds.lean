    naturalThresholdRow28[i] < 2 ^ 232 ∧
    naturalThresholdRow28[i] ^ (i.val + 1) < 2 ^ 232 ∧
    2 ^ 232 ≤ (naturalThresholdRow28[i] + 1) ^ (i.val + 1) := by
  decide +kernel

