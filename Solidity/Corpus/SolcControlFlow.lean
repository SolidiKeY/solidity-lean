theorem nestedIfElseSelectsBranch :
    Diamond State.solcControlFlowStore
    sol[SolcControlFlow]{
      uint x = 500;
      uint d = 0;
      if (x > 100) { if (x > 1000) { d = 1000; } else { d = 100; }; } else { if (x > 50) { d = 50; } else { d = 10; }; };
      assert(d == 100);
