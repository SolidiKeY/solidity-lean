/-- solkey `SolcMemory.memoryAliasIsNotACopy` (`solc/SolcMemory.sol`).

solc: structs/memory_structs_nested.sol — a memory struct member is a reference, so two
locals bound to it alias each other. -/
theorem memoryAliasIsNotACopy :
    Diamond (Core.TState.init SolcMemory)
    sol[SolcMemory]{
      Outer memory o;
      Inner memory ref = o.s;
      ref.a = 100;
      assert(o.s.a == 100);
    } := by
  corpus_decide

