theorem storageToMemoryCopyIsDeep :
    Diamond (Core.TState.init SolcMemory)
    sol[SolcMemory]{
      outerX.s.a = 17;
      Inner memory m = outerX.s;
      outerX.s.a = 18;
      assert(m.a == 17);
    } := by
  corpus_decide

