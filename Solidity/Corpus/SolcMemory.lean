theorem memoryArrayInStruct :
    Diamond (State.init SolcMemory)
    sol[SolcMemory]{
      Basket memory b;
      uint[] memory xs = new uint[](4);
      b.items = xs;
      b.items[1] = 33;
      assert(b.items[1] == 33);
