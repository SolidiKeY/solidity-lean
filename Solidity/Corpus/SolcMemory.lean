  corpus_decide

/-- solkey `SolcMemory.deleteMemoryArrayElement` (`solc/SolcMemory.sol`).

solc: array/delete/memory_arrays_delete.sol — `delete x[i]` resets one memory element
and leaves its neighbour alone. -/
theorem deleteMemoryArrayElement :
    Diamond (State.init SolcMemory)
    sol[SolcMemory]{
      uint[] memory xs = new uint[](4);
      xs[1] = 17;
      xs[2] = 18;
      delete xs[1];
      assert(xs[1] == 0);
      assert(xs[2] == 18);
    } := by
  corpus_decide

