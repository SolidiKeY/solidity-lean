/-- solkey `SolcStructs.deleteMemberThroughStorageAlias` (`solc/SolcStructs.sol`).

solc: structs/struct_delete_member.sol — `T storage x = data1;` does not copy: writing
and then deleting through `x` is observable on `data1`. -/
theorem deleteMemberThroughStorageAlias :
    Diamond (State.init SolcStructs)
    sol[SolcStructs]{
      data1.value = 2;
      Simple storage x = data1;
      x.value = 4;
      delete x.value;
      assert(data1.value == 0);
    } := by
  corpus_decide

/-- solkey `SolcStructs.deleteStructLeavesNeighbours` (`solc/SolcStructs.sol`).

solc: structs/struct_delete_storage.sol — `delete s` resets every member of the struct
and leaves the neighbouring state variables alone. -/
theorem deleteStructLeavesNeighbours :
    Diamond (State.init SolcStructs)
    sol[SolcStructs]{
      neighbourBefore = 23;
      neighbourAfter = 17;
      triple.x = 42;
      triple.y = 42;
      triple.z = 42;
      delete triple;
      assert(triple.x == 0);
      assert(triple.y == 0);
      assert(triple.z == 0);
      assert(neighbourBefore == 23);
      assert(neighbourAfter == 17);
    } := by
  corpus_decide

