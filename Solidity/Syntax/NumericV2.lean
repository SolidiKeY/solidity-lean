def word {C : Contract} {Γ : Ctx} (n : Fin (2^256)) : Val C Γ .uint :=
  .simple (.lit (n.val : Int) (by
    simp only [PrimTy.inRange, decide_eq_true_eq]
    exact ⟨Int.natCast_nonneg _, Int.ofNat_lt.mpr n.isLt⟩))

/-- A finite case split on the exponent; no power is evaluated by the guard. -/
def lookup {C : Contract} {Γ : Ctx} (negative : Val C Γ .bool)
    (magnitude exponent : Val C Γ .uint) : List Threshold → Val C Γ .bool
  | [] => .simple (.bool false)
  | (n,positive,neg) :: rest =>
      .ternary (.binop .eqB rfl rfl exponent (word ⟨n.val, by have := n.isLt; omega⟩))
        (.binop .le rfl rfl magnitude (.ternary negative (word neg) (word positive)))
        (lookup negative magnitude exponent rest)

def powerFits {C : Contract} {Γ : Ctx} (a : Val C Γ .int)
    (b : Val C Γ .uint) : Val C Γ .bool :=
  .ternary (.binop .le rfl rfl (Val.signedMagnitude a) (word 1))
    (.simple (.bool true))
    (.ternary (.binop .eqB rfl rfl b (word 0)) (.simple (.bool true))
      (lookup (Val.powerNegative a b) (Val.signedMagnitude a) b thresholds))

def powerValue {C : Contract} {Γ : Ctx} (a : Val C Γ .int)
    (b : Val C Γ .uint) : Val C Γ .int := Val.checkedSignedPower a b

def checkedSignedPower {C : Contract} {Γ : Ctx} (a : Val C Γ .int)
    (b : Val C Γ .uint) : Stmt C Γ Γ × Val C Γ .int :=
  (panicStmt 0x11 (powerFits a b), powerValue a b)

end Solidity.Val.NumericV2
