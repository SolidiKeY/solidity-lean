def expressionPath (s : Syn .expr) : Option IdPath := expressionPathAny s

/-- Explicit paths, identifiers and member prefixes. Runtime fields of
non-path receivers remain with G13; their ordinary subterms are traversed. -/
def referencesM {c : Cat} (s : Syn c) : List IdPath :=
  Syn.casesOn (motive := fun c (_ : Syn c) => List IdPath) s
    («nil» := fun {_} => [])
    («cons» := fun {_} a0 a1 => (referencesM a0) ++ (referencesM a1))
    («none» := fun {_} => [])
    («some» := fun {_} a0 => (referencesM a0))
    («unit» := fun a0 => (referencesM a0))
    («pragma» := fun _ => [])
    («importPath» := fun _ _ => [])
    («importSymbols» := fun a0 a1 _ => (referencesM a0) ++ (referencesM a1))
    («importStar» := fun _ _ => [])
    («importAlias» := fun _ _ => [])
    («contract» := fun _ _ a2 a3 a4 => (referencesM a2) ++ (referencesM a3) ++ (referencesM a4))
    («interface» := fun _ a1 a2 => (referencesM a1) ++ (referencesM a2))
    («library» := fun _ a1 => (referencesM a1))
    («topPart» := fun a0 => (referencesM a0))
    («inherit» := fun a0 a1 => [a0] ++ (referencesM a1))
    («constructor» := fun a0 a1 _ _ a4 => (referencesM a0) ++ (referencesM a1) ++ (referencesM a4))
    («function» := fun {_} _ a1 _ _ a4 _ a6 a7 a8 => a6.getD [] ++ (referencesM a1) ++ (referencesM a4) ++ (referencesM a7) ++ (referencesM a8))
    («modifier» := fun _ a1 _ a3 a4 => a3.getD [] ++ (referencesM a1) ++ (referencesM a4))
    («fallback» := fun a0 _ _ a3 _ a5 a6 => a5.getD [] ++ (referencesM a0) ++ (referencesM a3) ++ (referencesM a6))
    («fbNoParams» := [])
    («fbParams» := fun a0 a1 a2 => (referencesM a0) ++ (referencesM a1) ++ (referencesM a2))
    («receive» := fun _ _ a2 _ a4 a5 => a4.getD [] ++ (referencesM a2) ++ (referencesM a5))
    («struct» := fun {_} _ a1 a2 => (referencesM a1) ++ (referencesM a2))
    («structMember» := fun a0 _ => (referencesM a0))
    («enum» := fun {_} _ _ _ => [])
    («udvt» := fun {_} _ _ => [])
    («stateVar» := fun a0 _ _ a3 _ _ a6 => a3.getD [] ++ (referencesM a0) ++ (referencesM a6))
    («constant» := fun a0 _ a2 => (referencesM a0) ++ (referencesM a2))
    («event» := fun {_} _ a1 _ => (referencesM a1))
    («eventParam» := fun a0 _ _ => (referencesM a0))
    («error» := fun {_} _ a1 => (referencesM a1))
    («errorParam» := fun a0 _ => (referencesM a0))
    («usingPart» := fun {_} a0 => (referencesM a0))
    («usingPath» := fun a0 a1 _ => [a0] ++ (referencesM a1))
    («usingAliases» := fun a0 a1 a2 _ => (referencesM a0) ++ (referencesM a1) ++ (referencesM a2))
    («usingAlias» := fun a0 _ => [a0])
    («positional» := fun a0 => (referencesM a0))
    («named» := fun a0 => (referencesM a0))
    («namedArg» := fun _ a1 => (referencesM a1))
    («modInv» := fun a0 a1 => [a0] ++ (referencesM a1))
    («param» := fun a0 _ _ => (referencesM a0))
    («elem» := fun _ => [])
    («fnType» := fun a0 _ _ a3 => (referencesM a0) ++ (referencesM a3))
    («mapping» := fun a0 _ a2 _ => MapKey.paths a0 ++ (referencesM a2))
    («userType» := fun a0 => [a0])
    («array» := fun a0 a1 => (referencesM a0) ++ (referencesM a1))
    («varDecl» := fun a0 _ _ => (referencesM a0))
    («index» := fun a0 a1 => (referencesM a0) ++ (referencesM a1))
    («slice» := fun a0 a1 a2 => (referencesM a0) ++ (referencesM a1) ++ (referencesM a2))
    («member» := fun a0 a1 => (expressionPath (.member a0 a1)).toList ++ (referencesM a0))
    («callOptions» := fun a0 a1 a2 => (referencesM a0) ++ (referencesM a1) ++ (referencesM a2))
    («call» := fun a0 a1 => (referencesM a0) ++ (referencesM a1))
    («payableConv» := fun a0 => (referencesM a0))
    («metaType» := fun a0 => (referencesM a0))
    («unaryPrefix» := fun _ a1 => (referencesM a1))
    («unarySuffix» := fun _ a1 => (referencesM a1))
    («exp» := fun a0 a1 => (referencesM a0) ++ (referencesM a1))
    («mulDivMod» := fun _ a1 a2 => (referencesM a1) ++ (referencesM a2))
    («addSub» := fun _ a1 a2 => (referencesM a1) ++ (referencesM a2))
    («shift» := fun _ a1 a2 => (referencesM a1) ++ (referencesM a2))
    («bitAnd» := fun a0 a1 => (referencesM a0) ++ (referencesM a1))
    («bitXor» := fun a0 a1 => (referencesM a0) ++ (referencesM a1))
    («bitOr» := fun a0 a1 => (referencesM a0) ++ (referencesM a1))
    («order» := fun _ a1 a2 => (referencesM a1) ++ (referencesM a2))
