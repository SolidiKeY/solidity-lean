    («nil» := fun {_} => by rfl)
    («cons» := fun {_} _ _ _ _ => by rfl)
    («none» := fun {_} => by rfl)
    («some» := fun {_} _ _ => by rfl)
    («unit» := fun _ _ => by rfl)
    («pragma» := fun _ => by rfl)
