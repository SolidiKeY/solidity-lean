    («function» := fun {_} _ _ _ _ _ _ _ _ _ _ _ _ _ => by rfl)
    («modifier» := fun _ _ _ _ _ _ _ => by rfl)
    («fallback» := fun _ _ _ _ _ _ _ _ _ _ => by rfl)
    («fbNoParams» := by rfl)
