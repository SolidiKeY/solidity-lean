/-- CLZ's answer `r` for operand `v`, checked by the bit window of `v`'s word:
`2^(255-r) ≤ x < 2^(256-r)`, or `r = 256` for zero. `Nat.log2` reduces slowly in
the kernel on 256-bit literals; `clz_of_window` connects the two. -/
def clzWindow (v r : Nat) : Bool :=
  if v % 2 ^ 256 = 0 then r == 256
  else decide (r ≤ 255) && decide (2 ^ (255 - r) ≤ v % 2 ^ 256) && decide (v % 2 ^ 256 < 2 ^ (256 - r))

theorem clz_of_window {v r : Nat} (h : clzWindow v r = true) :
    (Pure.eval .«clz» (fun _ => word v)).val = r := by
  rw [clz_val]
  change (if v % 2 ^ 256 = 0 then 256 else 255 - (v % 2 ^ 256).log2) % OpcodeSpec.modulus = r
  unfold clzWindow at h
  split at h
  · next hz => rw [if_pos hz, eq_of_beq h]; rfl
  · next hz =>
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    obtain ⟨⟨h1, h2⟩, h3⟩ := h
    have hl : (v % 2 ^ 256).log2 = 255 - r :=
      (Nat.log2_eq_iff hz).2 ⟨h2, by rwa [show 255 - r + 1 = 256 - r by omega]⟩
    rw [if_neg hz, hl, Nat.mod_eq_of_lt (by unfold OpcodeSpec.modulus; omega)]
    omega

/-- Kernel-fast agreement: BYTE and SIGNEXTEND run the evaluator, CLZ checks
the bit window. -/
def Row.fast : Row → Bool
  | .clz v r => clzWindow v r
  | r => r.check

theorem Row.check_of_fast : ∀ r : Row, r.fast = true → r.check = true
  | .byte .., h | .signextend .., h => h
  | .clz _ _, h => beq_iff_eq.2 (clz_of_window h)

/-- The aggregate decision: every row agrees, in one kernel check. -/
theorem rows_fast : rows.all Row.fast = true := by decide +kernel

/-- Every row agrees with the evaluator `Pure.eval`. -/
theorem rows_check : rows.all Row.check = true :=
  List.all_eq_true.2 fun r h => r.check_of_fast (List.all_eq_true.1 rows_fast r h)

theorem byte_holds {i v r : Nat} (h : Row.byte i v r ∈ rows) :
    (Pure.eval .«byte» (fun i' => if i'.val = 0 then word i else word v)).val = r :=
  eq_of_beq (List.all_eq_true.mp rows_check _ h)

theorem signextend_holds {i v r : Nat} (h : Row.signextend i v r ∈ rows) :
    (Pure.eval .«signextend» (fun i' => if i'.val = 0 then word i else word v)).val = r :=
  eq_of_beq (List.all_eq_true.mp rows_check _ h)

theorem clz_holds {v r : Nat} (h : Row.clz v r ∈ rows) :
    (Pure.eval .«clz» (fun _ => word v)).val = r :=
  eq_of_beq (List.all_eq_true.mp rows_check _ h)

end Solidity.Yul.Checks.Bytes
