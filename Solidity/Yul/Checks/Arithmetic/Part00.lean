import Solidity.Yul.Words

/-! # Arithmetic opcode vectors as one literal table

Rows are `(opcode, source-order operands, expected result)` with literal
expected answers from an integer oracle outside this repository. They are
finite kernel-checked model outcomes, not external EVM conformance. Row `k`
of `Arithmetic.table` is the former theorem `vNNNN` with `NNNN = k`; one
aggregate `decide +kernel` in `Solidity.Yul.Checks.Arithmetic` checks them all. -/
namespace Solidity.Yul.Checks.Arithmetic

/-- One vector: an opcode, its operands in Yul source order, and the expected word. -/
structure Row where
  {arity : Nat}
  op : Pure arity
  args : List Nat
  out : Nat

/-- Operand list as the evaluator's argument function; operands are below 2^256. -/
def operands {a : Nat} (args : List Nat) : Fin a → Word := fun i => word (args.getD i.val 0)

/-- A row holds when it supplies exactly `arity` operands and evaluates to `out`. -/
def Row.check (r : Row) : Bool :=
  r.args.length == r.arity && (Pure.eval r.op (operands r.args)).val == r.out

/-- Generic projection: every row of a checked list evaluates to its expected word. -/
theorem Row.holds {rows : List Row} (h : rows.all Row.check = true) :
    ∀ r ∈ rows, (Pure.eval r.op (operands r.args)).val = r.out := by
  intro r hr
  have hc := List.all_eq_true.mp h r hr
  simp only [Row.check, Bool.and_eq_true, beq_iff_eq] at hc
  exact hc.2

