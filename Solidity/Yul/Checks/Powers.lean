import Solidity.Yul.Words

/-! # EXP: universal meaning and literal vectors

`exp_val` is the universal statement: for every base and exponent word, EXP is
the mathematical power modulo 2^256 (exponent zero and `0^0 = 1` included),
reusing `powWord_correct`.

The `vNNNN` theorems are kernel controls generated by a script not in this
repository: finite integer-oracle tests, independent of `exp_val`. They stay
separate declarations because one aggregate kernel decision over these large
exponents measured several times slower. -/
namespace Solidity.Yul.Checks.Powers

/-- EXP with operand 0 as base and operand 1 as exponent, for every word input. -/
theorem exp_val (xs : Fin 2 → Word) :
    (Pure.eval .«exp» xs).val = (xs 0).val ^ (xs 1).val % (2 ^ 256) :=
  powWord_correct (xs 0) (xs 1).val

