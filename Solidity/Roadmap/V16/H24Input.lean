import Solidity.Lowering.P8.DeclarationGraphAdmission
import Solidity.Lowering.P8b.P8aInterface

/-! FROZEN V1: additive V16 input boundary for the published H24 producer.
Generated by scripts/roadmap-v16-h24-interface.py. Signatures only; no producer,
admitted input, graph certificate, lowerer or semantic certificate is constructed.
The base P8a dependency currently has no concrete inhabitant. This interface
cannot be counted as inhabited admission or G48/compiler coverage. -/
namespace Solidity.Roadmap.V16.H24Input
open Solidity.Lowering.P8

/-- The exact H24 wrapper, retaining BOTH graphs and actual Source refusal. -/
abbrev Producer (S : P8a.Spec) (reference : P8a.OperationalReference)
    (origins : P8a.SourceOrigins S) (roots : P8a.RootModel S) :=
  DeclarationGraphAdmission.Producer S reference origins roots

/-- Existing checked frontend receipt at the SAME wrapped base producer.
No second checker, acceptance predicate or fragment restriction is introduced. -/
abbrev CertifiedInput {S : P8a.Spec} {reference : P8a.OperationalReference}
    {origins : P8a.SourceOrigins S} {roots : P8a.RootModel S}
    (producer : Producer S reference origins roots) (input : S.Input) :=
  Solidity.Lowering.P8b.P8aInterface.CertifiedInput producer.base input

/-- Explicit input obligations for later V16 composition. The producer and
its checked receipt are premises, not fabricated instances. Graph admission is
indexed by producer.base, including its exact origin/artifact/location indices. -/
structure Request {S : P8a.Spec} {reference : P8a.OperationalReference}
    {origins : P8a.SourceOrigins S} {roots : P8a.RootModel S}
    (producer : Producer S reference origins roots) (input : S.Input) where
  checked : CertifiedInput producer input
  artifact : Roadmap.Artifact

/-- The unchanged P8b lowering/certificate obligation remains SEPARATE from
H24. No total emitter, dom/agrees proof or G01 Cert follows from Request. -/
abbrev LoweringObligation (S : P8a.Spec) (I : Roadmap.IntrinsicSpec) :=
  Solidity.Lowering.P8b.P8aInterface.ProducerOutput S I

end Solidity.Roadmap.V16.H24Input
