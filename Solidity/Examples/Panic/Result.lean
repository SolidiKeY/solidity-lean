import Solidity.Semantics.Panic.Result

/-!
# Panic result boundary regressions

The bare V1 intrinsic panic has no code. In particular, projecting an assertion
panic must not turn external `Panic(1)` bytes into an intrinsic failure, nor
assert that V1 self-catch and a code-aware self-catch bind the same code.
These are kernel-checked result-interface tests, not interpreter or EVM tests.
They retain typed `Out` states and heap-extension proofs on successful paths.
-/

namespace Solidity.Examples.PanicResult

open Solidity.Semantics
open Solidity.Semantics.Panic

/-- A small typed origin used only by this interface's tests. -/
inductive Site where
  | assertion (line : Nat)
  | arithmetic (line : Nat)
  deriving Repr, DecidableEq

/-- Every solc code is concrete, including codes not generated by this test. -/
example : ([Code.generic, .assert, .arithmetic, .divZero, .enumConv,
    .storageEncoding, .popEmpty, .index, .alloc, .zeroFn].map Code.code) =
    [0x00, 0x01, 0x11, 0x12, 0x21, 0x22, 0x31, 0x32, 0x41, 0x51] := rfl

/-- The success contains the complete state and extension proof, not ABI words. -/
example {C : Contract} {H : HTy} {Γ : Ctx} (out : Out C H Γ) :
    (Result.success (Origin := Site) out).toV1 = (.ok out : TRes (Out C H Γ)) :=
  Result.success_project out

/-- A successful projection suffices to recover that very typed output. -/
example {C : Contract} {H : HTy} {Γ : Ctx} (out : Out C H Γ)
    (result : Result Site (Out C H Γ)) (h : result.toV1 = .ok out) :
    result = .ok out :=
  (Result.toV1_eq_ok_iff result out).mp h

/-- Mapping to the state keeps its intrinsic storage/heap/local types. -/
example {C : Contract} {H : HTy} {Γ : Ctx} (out : Out C H Γ) :
    Result.toV1 ((.ok out : Result Site (Out C H Γ)).map Out.st) =
      (.ok out.st : TRes (State C Γ)) := by
  rw [Result.toV1_map, Result.toV1_ok]
  rfl

/-- All failure constructors project separately; explicit ordinary data and
external data are both preserved, while empty external bytes normalize as V1. -/
example : ([Halt.intrinsic .assert (.assertion 7), .externalRevert [1, 2],
    .externalRevert [], .revert, .revertWith [3, 4], .revertWith [],
    .exhausted, .diverge] : List (Halt Site)).map
      (fun halt => Result.toV1 (.error halt : Result Site Nat)) =
    [.error .panic, .error (.revertWith [1, 2]), .error .revert, .error .revert,
      .error (.revertWith [3, 4]), .error (.revertWith []), .error .exhausted,
      .error .diverge] := rfl

/-- Assertion code 1 and its origin survive before the V1 information loss. -/
example : (Halt.intrinsic .assert (.assertion 7) : Halt Site) ≠
    .intrinsic .arithmetic (.assertion 7) := by
  intro h
  have codes := (Halt.intrinsic_eq_iff _ _ _ _).mp h
  cases codes.1

/-- Equal codes do not collapse distinct origin sites. -/
example : (Halt.intrinsic .assert (.assertion 7) : Halt Site) ≠
    .intrinsic .assert (.assertion 8) := by
  intro h
  have sites := (Halt.intrinsic_eq_iff _ _ _ _).mp h
  cases sites.2

/-- An external panic encoding is still external, even for assertion code 1. -/
example : (Halt.intrinsic .assert (.assertion 7) : Halt Site) ≠
    .externalRevert (encodePanic 1) :=
  Halt.intrinsic_ne_external _ _ _

example : (Result.toV1 (.error (.intrinsic .assert (.assertion 7)) : Result Site Nat),
    Result.toV1 (.error (.externalRevert (encodePanic 1)) : Result Site Nat)) =
    (.error .panic, .error (THalt.ofData (encodePanic 1))) := by
  rw [Result.toV1_intrinsic, Result.toV1_external]

/-- Ordinary explicit revert bytes are not relabeled as an external origin. -/
example : (Halt.revertWith (encodePanic 1) : Halt Site) ≠
    .externalRevert (encodePanic 1) := by
  intro h
  cases h

/-- A continuation which would generate a different intrinsic panic. -/
def next (n : Nat) : Result Site Nat :=
  if n = 7 then .error (.intrinsic .arithmetic (.arithmetic 99)) else .ok (n + 1)

/-- A successful bind can introduce the continuation's arithmetic code. -/
example : ((.ok 7 : Result Site Nat) >>= next) =
    .error (.intrinsic .arithmetic (.arithmetic 99)) := rfl

/-- A failed bind must preserve the *first* assertion code and origin. -/
example : ((.error (.intrinsic .assert (.assertion 7)) : Result Site Nat) >>= next) =
    .error (.intrinsic .assert (.assertion 7)) := rfl

/-- The projected bind agrees only with that same projected continuation. -/
example : Result.toV1 ((.ok 7 : Result Site Nat) >>= next) =
    ((Result.toV1 (.ok 7 : Result Site Nat)) >>= fun n => (next n).toV1) :=
  Result.toV1_bind _ next

/-- A non-panicking branch of the continuation retains the full success. -/
example : Result.toV1 (((.ok 8 : Result Site Nat) >>= next).map (fun n => (n, true))) =
    (.ok (9, true) : TRes (Nat × Bool)) := rfl

/-- Origin transport changes the origin value without changing code or payload. -/
def line : Site → Nat
  | .assertion n => n
  | .arithmetic n => n

example : (Halt.intrinsic .assert (.assertion 7)).mapOrigin line = .intrinsic .assert 7 ∧
    (Halt.externalRevert (encodePanic 1) : Halt Site).mapOrigin line =
      .externalRevert (encodePanic 1) := ⟨rfl, rfl⟩

example : ((Halt.intrinsic .assert (.assertion 7)).mapOrigin line).toV1 =
    (Halt.intrinsic .assert (Site.assertion 7)).toV1 :=
  Halt.toV1_mapOrigin line _

end Solidity.Examples.PanicResult

namespace Solidity.Examples.PanicResult

open Solidity.Semantics
open Solidity.Semantics.Panic

/-- V1 distinguishes assertion sites from failed checked operations.
Code alone cannot choose this interpretation. -/
def legacySite (_ : Code) : Site → THalt
  | .assertion _ => .panic
  | .arithmetic _ => .revert

/-- Equal solc codes can have different V1 failure classes. -/
example : (Halt.intrinsic .arithmetic (.assertion 7)).toV1With legacySite = .panic ∧
    (Halt.intrinsic .arithmetic (.arithmetic 7)).toV1With legacySite = .revert :=
  ⟨rfl, rfl⟩

/-- A checked option uses an operation origin only for the actual failure. -/
def checkedOption {α : Type} : Option α → Result Site α
  | some value => .ok value
  | none => .error (.intrinsic .arithmetic (.arithmetic 99))

/-- Local correspondence with the existing primitive option adapter, for both
failure and full success. This is not a whole-program run correspondence. -/
example {α : Type} (value : Option α) :
    Result.toV1With legacySite (checkedOption value) = TRes.ofOpt value := by
  cases value <;> rfl

example {C : Contract} {H : HTy} {Γ : Ctx} (out : Out C H Γ) :
    Result.toV1With legacySite (Result.success out) = .ok out :=
  Result.toV1With_ok legacySite out

example {C : Contract} {H : HTy} {Γ : Ctx} (out : Out C H Γ)
    (result : Result Site (Out C H Γ)) (h : result.toV1With legacySite = .ok out) :
    result = .ok out :=
  (Result.toV1With_eq_ok_iff legacySite result out).mp h

example {C : Contract} {H : HTy} {Γ : Ctx} (out : Out C H Γ) :
    Result.toV1With legacySite ((.ok out : Result Site (Out C H Γ)).map Out.st) =
      (.ok out.st : TRes (State C Γ)) := by
  rw [Result.toV1With_map, Result.toV1With_ok]
  rfl

example : Result.toV1With legacySite ((.ok 7 : Result Site Nat) >>= next) =
    ((Result.toV1With legacySite (.ok 7 : Result Site Nat)) >>=
      fun n => (next n).toV1With legacySite) :=
  Result.toV1With_bind legacySite _ next

example : Result.toV1With legacySite ((.ok 7 : Result Site Nat) >>= next) =
    (.error .revert : TRes Nat) := rfl

example : (Halt.externalRevert (encodePanic 0x11)).toV1With legacySite =
    .revertWith (encodePanic 0x11) := rfl

/-- Compatibility of classifier and origin transport is explicit. -/
example : ((Halt.intrinsic .arithmetic (.arithmetic 7)).mapOrigin
    (fun site => (site, line site))).toV1With (fun code pair => legacySite code pair.1) =
      (Halt.intrinsic .arithmetic (.arithmetic 7)).toV1With legacySite :=
  Halt.toV1With_mapOrigin _ _ _

/-- The existing default API remains its original structural projection. -/
example (result : Result Site Nat) :
    result.toV1With (fun _ _ => .panic) = result.toV1 :=
  Result.toV1With_default result

end Solidity.Examples.PanicResult
