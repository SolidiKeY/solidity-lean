import Solidity.Secp256k1

/-! secp256k1 recovery conformance, including Ethereum's permitted high-s case. -/
namespace Solidity.Examples.Tactics.Recovery
open Secp256k1
set_option maxRecDepth 2048

/-- The generator's x coordinate is the r of nonce one. -/
def rOne : Nat := 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798

/-- A zero digest and nonce/private-key one recover the generator. -/
theorem recover_generator : recoverPoint 0 27 rOne rOne = some generator := by
  decide +kernel

/-- The corresponding address, checked without a native-decision axiom. -/
theorem recover_address : (recover 0 27 rOne rOne).map Fin.val =
    some 0x7e5f4552091a69125d5dfcb7b8c2659029395bdf := by
  simp only [recover, recover_generator, Option.map_some]
  decide +kernel

#guard (recover 1 27 rOne (rOne + 1)).map Fin.val == some 0x7e5f4552091a69125d5dfcb7b8c2659029395bdf
#guard (recover 1 28 rOne (order - rOne - 1)).map Fin.val == some 0x7e5f4552091a69125d5dfcb7b8c2659029395bdf
#guard (recover 0 29 rOne rOne).isNone
#guard (recover 0 27 0 rOne).isNone
#guard (recover 0 27 rOne 0).isNone
#guard (recover 0 27 order rOne).isNone
#guard (recover 0 27 rOne order).isNone

-- Independent RFC6979 signatures, checked against Solidity/EVM recovery.
#guard (recover 42 28 82996604291996786528555805222018812208176109759801898649520513547090162681726 8585020162441241376191144265910054611966225693043790238167422338240122001561).map Fin.val == some 247512291986854564435551364600938690683113101007
#guard (recover 42 27 82996604291996786528555805222018812208176109759801898649520513547090162681726 (order - 8585020162441241376191144265910054611966225693043790238167422338240122001561)).map Fin.val == some 247512291986854564435551364600938690683113101007
#guard (recover 42 28 114442710157957076769569719893580847108642036219123938124440474020339832225418 55625236952425834185487605862116206832861309427483984076609655123502409939097).map Fin.val == some 1210930943336347771396396330116102456817544228795
#guard (recover 42 27 114442710157957076769569719893580847108642036219123938124440474020339832225418 (order - 55625236952425834185487605862116206832861309427483984076609655123502409939097)).map Fin.val == some 1210930943336347771396396330116102456817544228795
#guard (recover 42 27 15926886430996334453021976091690963323755725543293164968439808676993899061737 918201743097959519332352979637811022278693716190462798805452507048141563178).map Fin.val == some 1343182721476138285347669940982011290883466303785
#guard (recover 42 28 15926886430996334453021976091690963323755725543293164968439808676993899061737 (order - 918201743097959519332352979637811022278693716190462798805452507048141563178)).map Fin.val == some 1343182721476138285347669940982011290883466303785

-- Candidate nonresidue, infinity, and digest reduction modulo the group order.
#guard Secp256k1.recover 0 27 5 1 == none
#guard Secp256k1.recover 1 27 rOne 1 == none
#guard Secp256k1.recover Secp256k1.order 27 rOne rOne ==
  some ⟨0x7e5f4552091a69125d5dfcb7b8c2659029395bdf, by decide⟩

end Solidity.Examples.Tactics.Recovery
