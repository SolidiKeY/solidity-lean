SolidityBridge.PrecompileAgreement.zero_padding (bs : List ℕ) (n : ℕ) :
  Solidity.Precompiles.ofBE (bs ++ List.replicate n 0) = Solidity.Precompiles.ofBE bs * 256 ^ n
SolidityBridge.PrecompileAgreement.blake_padding (d : ByteArray) :
  Solidity.Precompiles.Osaka.gas Solidity.Roadmap.Evm.Precompile.blake2f d.toList =
    EvmYul.fromByteArrayBigEndian (d.extract 0 4) * 256 ^ (4 - min 4 d.size)
SolidityBridge.PrecompileAgreement.blake_zero_header (d : ByteArray)
  (zero : EvmYul.fromByteArrayBigEndian (d.extract 0 4) = 0) :
  Solidity.Precompiles.Osaka.gas Solidity.Roadmap.Evm.Precompile.blake2f d.toList = 0
SolidityBridge.PrecompileAgreement.blake_price (d : ByteArray) (header : 4 ≤ d.size) :
  Solidity.Precompiles.Osaka.gas Solidity.Roadmap.Evm.Precompile.blake2f d.toList =
    EvmYul.fromByteArrayBigEndian (d.extract 0 4)
SolidityBridge.PrecompileAgreement.blake_gas (σ : EvmYul.AccountMap EvmYul.OperationType.EVM) (g : EvmYul.UInt256)
  (A : EvmYul.Substate) (I : EvmYul.ExecutionEnv EvmYul.OperationType.EVM) (header : 4 ≤ I.calldata.size) :
  (Ξ_BLAKE2_F σ g A I).2.2.1.toNat =
    if (Ξ_BLAKE2_F σ g A I).1 = true then
      g.toNat - Solidity.Precompiles.Osaka.gas Solidity.Roadmap.Evm.Precompile.blake2f I.calldata.toList
    else 0
SolidityBridge.PrecompileAgreement.blake_valid (σ : EvmYul.AccountMap EvmYul.OperationType.EVM) (g : EvmYul.UInt256)
  (A : EvmYul.Substate) (I : EvmYul.ExecutionEnv EvmYul.OperationType.EVM)
  (enough : EvmYul.fromByteArrayBigEndian (I.calldata.extract 0 4) ≤ g.toNat) (size : I.calldata.size = 213)
  (flag : I.calldata[212]! = 0) :
  Ξ_BLAKE2_F σ g A I =
    (true, σ, g - EvmYul.UInt256.ofNat (EvmYul.fromByteArrayBigEndian (I.calldata.extract 0 4)), A,
      ffi.BLAKE2Compress I.calldata)
SolidityBridge.PrecompileAgreement.blake_insufficient (σ : EvmYul.AccountMap EvmYul.OperationType.EVM)
  (g : EvmYul.UInt256) (A : EvmYul.Substate) (I : EvmYul.ExecutionEnv EvmYul.OperationType.EVM)
  (short : g.toNat < EvmYul.fromByteArrayBigEndian (I.calldata.extract 0 4)) :
  Ξ_BLAKE2_F σ g A I = (false, ∅, { val := 0 }, A, ByteArray.empty)
SolidityBridge.PrecompileAgreement.blake_invalid_flag (σ : EvmYul.AccountMap EvmYul.OperationType.EVM)
  (g : EvmYul.UInt256) (A : EvmYul.Substate) (I : EvmYul.ExecutionEnv EvmYul.OperationType.EVM)
  (size : I.calldata.size = 213) (flag : I.calldata[212]! = 2) :
  Ξ_BLAKE2_F σ g A I = (false, ∅, { val := 0 }, A, ByteArray.empty)
SolidityBridge.PrecompileAgreement.blake_valid_one (σ : EvmYul.AccountMap EvmYul.OperationType.EVM) (g : EvmYul.UInt256)
  (A : EvmYul.Substate) (I : EvmYul.ExecutionEnv EvmYul.OperationType.EVM)
  (enough : EvmYul.fromByteArrayBigEndian (I.calldata.extract 0 4) ≤ g.toNat) (size : I.calldata.size = 213)
  (flag : I.calldata[212]! = 1) :
  Ξ_BLAKE2_F σ g A I =
    (true, σ, g - EvmYul.UInt256.ofNat (EvmYul.fromByteArrayBigEndian (I.calldata.extract 0 4)), A,
      ffi.BLAKE2Compress I.calldata)
SolidityBridge.PrecompileAgreement.blake_invalid_size (σ : EvmYul.AccountMap EvmYul.OperationType.EVM)
  (g : EvmYul.UInt256) (A : EvmYul.Substate) (I : EvmYul.ExecutionEnv EvmYul.OperationType.EVM)
  (size : I.calldata.size ≠ 213) : Ξ_BLAKE2_F σ g A I = (false, ∅, { val := 0 }, A, ByteArray.empty)
SolidityBridge.PrecompileAgreement.blake_zero_gas (σ : EvmYul.AccountMap EvmYul.OperationType.EVM) (g : EvmYul.UInt256)
  (A : EvmYul.Substate) (I : EvmYul.ExecutionEnv EvmYul.OperationType.EVM)
  (zero : EvmYul.fromByteArrayBigEndian (I.calldata.extract 0 4) = 0) :
  (Ξ_BLAKE2_F σ g A I).2.2.1.toNat =
    if (Ξ_BLAKE2_F σ g A I).1 = true then
      g.toNat - Solidity.Precompiles.Osaka.gas Solidity.Roadmap.Evm.Precompile.blake2f I.calldata.toList
    else 0
SolidityBridge.PrecompileAgreement.identity_gas (d : ByteArray) :
  Solidity.Precompiles.identityGas d.toList = 15 + 3 * ((d.size + 31) / 32)
SolidityBridge.PrecompileAgreement.identity_output (d : ByteArray) :
  Solidity.Precompiles.identity d.toList = some d.toList
SolidityBridge.PrecompileAgreement.identity_run (σ : EvmYul.AccountMap EvmYul.OperationType.EVM) (g : EvmYul.UInt256)
  (A : EvmYul.Substate) (I : EvmYul.ExecutionEnv EvmYul.OperationType.EVM) :
  Ξ_ID σ g A I =
    if g.toNat < Solidity.Precompiles.identityGas I.calldata.toList then (false, ∅, { val := 0 }, A, ByteArray.empty)
    else (true, σ, g - EvmYul.UInt256.ofNat (Solidity.Precompiles.identityGas I.calldata.toList), A, I.calldata)
SolidityBridge.PrecompileAgreement.identity_success (σ : EvmYul.AccountMap EvmYul.OperationType.EVM)
  (g : EvmYul.UInt256) (A : EvmYul.Substate) (I : EvmYul.ExecutionEnv EvmYul.OperationType.EVM)
  (enough : Solidity.Precompiles.identityGas I.calldata.toList ≤ g.toNat) :
  Ξ_ID σ g A I = (true, σ, g - EvmYul.UInt256.ofNat (Solidity.Precompiles.identityGas I.calldata.toList), A, I.calldata)
SolidityBridge.PrecompileAgreement.identity_failure (σ : EvmYul.AccountMap EvmYul.OperationType.EVM)
  (g : EvmYul.UInt256) (A : EvmYul.Substate) (I : EvmYul.ExecutionEnv EvmYul.OperationType.EVM)
  (short : g.toNat < Solidity.Precompiles.identityGas I.calldata.toList) :
  Ξ_ID σ g A I = (false, ∅, { val := 0 }, A, ByteArray.empty)
SolidityBridge.PrecompileAgreement.identity_charged (σ : EvmYul.AccountMap EvmYul.OperationType.EVM)
  (g : EvmYul.UInt256) (A : EvmYul.Substate) (I : EvmYul.ExecutionEnv EvmYul.OperationType.EVM)
  (enough : Solidity.Precompiles.identityGas I.calldata.toList ≤ g.toNat) :
  (Ξ_ID σ g A I).2.2.1.toNat + Solidity.Precompiles.identityGas I.calldata.toList = g.toNat
SolidityBridge.PrecompileAgreement.identity_success_iff (σ : EvmYul.AccountMap EvmYul.OperationType.EVM)
  (g : EvmYul.UInt256) (A : EvmYul.Substate) (I : EvmYul.ExecutionEnv EvmYul.OperationType.EVM) :
  (Ξ_ID σ g A I).1 = true ↔ Solidity.Precompiles.identityGas I.calldata.toList ≤ g.toNat
SolidityBridge.PrecompileAgreement.identity_exact (σ : EvmYul.AccountMap EvmYul.OperationType.EVM) (A : EvmYul.Substate)
  (I : EvmYul.ExecutionEnv EvmYul.OperationType.EVM)
  (fits : Solidity.Precompiles.identityGas I.calldata.toList < EvmYul.UInt256.size) :
  Ξ_ID σ (EvmYul.UInt256.ofNat (Solidity.Precompiles.identityGas I.calldata.toList)) A I =
    (true, σ, EvmYul.UInt256.ofNat 0, A, I.calldata)
SolidityBridge.PrecompileAgreement.identity_one_short (σ : EvmYul.AccountMap EvmYul.OperationType.EVM)
  (A : EvmYul.Substate) (I : EvmYul.ExecutionEnv EvmYul.OperationType.EVM)
  (fits : Solidity.Precompiles.identityGas I.calldata.toList < EvmYul.UInt256.size) :
  Ξ_ID σ (EvmYul.UInt256.ofNat (Solidity.Precompiles.identityGas I.calldata.toList - 1)) A I =
    (false, ∅, { val := 0 }, A, ByteArray.empty)
SolidityBridge.PrecompileAgreement.identity_unaffordable (σ : EvmYul.AccountMap EvmYul.OperationType.EVM)
  (g : EvmYul.UInt256) (A : EvmYul.Substate) (I : EvmYul.ExecutionEnv EvmYul.OperationType.EVM)
  (huge : EvmYul.UInt256.size ≤ Solidity.Precompiles.identityGas I.calldata.toList) :
  Ξ_ID σ g A I = (false, ∅, { val := 0 }, A, ByteArray.empty)
