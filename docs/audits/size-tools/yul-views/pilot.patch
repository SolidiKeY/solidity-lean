 and real Placement bounds, never inline child contents or guessed ownership. -/
 namespace Solidity.Yul.Views
 
+/-- Finite word layouts: offsets are explicit, so arrays and struct fields
+share the same read relation. Packed/storage/hash layouts are not covered. -/
+inductive WordLayout where
+  | empty
+  | cell (offset : Nat) (word : Roadmap.Word) (tail : WordLayout)
+
+def WordLayout.Reads : WordLayout → ByteView → Nat → Prop
+  | .empty, _, _ => True
+  | .cell offset word tail, m, base =>
+      mload m (base+offset)=word ∧ tail.Reads m base
+
+def WordLayout.Owns : WordLayout → Nat → Prop
+  | .empty, _ => False
+  | .cell offset _ tail, a => a=offset ∨ tail.Owns a
+
+theorem WordLayout.frame (layout : WordLayout) (m next : ByteView) (base : Nat)
+    (same : ∀ offset, layout.Owns offset → mload next (base+offset)=mload m (base+offset))
+    (reads : layout.Reads m base) : layout.Reads next base := by
+  induction layout with
+  | empty => trivial
+  | cell offset word tail ih =>
+    exact ⟨(same offset (Or.inl rfl)).trans reads.1, ih (fun a owned => same a (Or.inr owned)) reads.2⟩
+
+theorem WordLayout.store_read (m : ByteView) (target address : Nat) (word : Roadmap.Word)
+    (separate : address=target ∨ address+32≤target ∨ target+32≤address) :
+    mload (mstore m target word) address=
+      if address=target then word else mload m address := by
+  by_cases same : address=target
+  · rw [if_pos same, same, mload_mstore]
+  · rw [if_neg same]
+    apply mload_congr _ m address
+    intro byte
+    apply mstore_outside
+    have small := byte.isLt
+    rcases separate with equal | before | after <;> omega
+
+def WordLayout.Separated : WordLayout → Nat → Nat → Prop
+  | .empty, _, _ => True
+  | .cell offset _ tail, base, target =>
+      (base+offset=target ∨ base+offset+32≤target ∨ target+32≤base+offset) ∧
+      tail.Separated base target
+
+def WordLayout.update : WordLayout → Nat → Nat → Roadmap.Word → WordLayout
+  | .empty, _, _, _ => .empty
+  | .cell offset old tail, base, target, word =>
+      .cell offset (if base+offset=target then word else old) (tail.update base target word)
+
+theorem WordLayout.store (layout : WordLayout) (m : ByteView) (base target : Nat) (word : Roadmap.Word)
+    (separate : layout.Separated base target) (reads : layout.Reads m base) :
+    (layout.update base target word).Reads (mstore m target word) base := by
+  induction layout with
+  | empty => trivial
+  | cell offset old tail ih =>
+    constructor
+    · change mload (mstore m target word) (base+offset)=if base+offset=target then word else old
+      rw [WordLayout.store_read m target (base+offset) word separate.1, reads.1]
+    · exact ih separate.2 reads.2
+
 def wordListView : List Roadmap.Word → ByteView → Nat → ByteView
   | [], m, _ => m
   | w :: ws, m, base => mstore (wordListView ws m (base + 32)) base w
