+-- Each row shares its opcode and first input; expected outputs remain literal.
+syntax "word_vectors " ident num "[" (ident num num),* "]" : command
+macro_rules
+  | `(word_vectors $op:ident $a:num [$[$names:ident $bs:num $rs:num],*]) => do
+    let cmds ← names.zip (bs.zip rs) |>.mapM fun (name, b, r) =>
+      `(theorem $name : (Pure.eval .$op (fun i => if i.val = 0 then word $a else word $b)).val = $r := by decide +kernel)
+    return Lean.mkNullNode (cmds.map (·.raw))
