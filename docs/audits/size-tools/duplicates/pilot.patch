diff --git a/Solidity/TestSuite/ScopedProblems.lean b/Solidity/TestSuite/ScopedProblems.lean
index 213ce5d77..246f9d47a 100644
--- a/Solidity/TestSuite/ScopedProblems.lean
+++ b/Solidity/TestSuite/ScopedProblems.lean
@@ -22,0 +23,11 @@ timing gate (`docs/intrinsic.md`, W3b lane `testsuite`).
+
+open Solidity
+open scoped Scoped
+
+/-- Declare the listed scoped obligations, preserving their public theorem names. -/
+macro "solkey_prove_batch " names:ident+ : command => do
+  let commands ← names.mapM fun name => do
+    let proved := Lean.mkIdent (name.getId ++ `proved)
+    let problem := Lean.mkIdent (name.getId ++ `problem)
+    `(theorem $proved : ⊢ $problem := by sol_prove)
+  return ⟨Lean.mkNullNode commands⟩
