new file mode 100644
index 0000000..89645e8
--- /dev/null
+++ b/Lean4Checker/FusedDepsV3.lean
@@ -0,0 +1,25 @@
+/-
+Copyright (c) 2026. Released under Apache 2.0 license; see LICENSE.
+-/
+prelude
+import Lean.Util.FoldConsts
+
+namespace Lean.Environment.Replay'
+
+/-- Metadata-only carrier for one existing native fold over type and value.
+The temporary application need not be well typed and never enters a declaration
+or kernel check. Reuses the existing fold's pointer/name deduplication; no new
+unsafe implementation or proof reduction hook is introduced. -/
+def fusedExprConstantsV3 (typeExpr valueExpr : Lean.Expr) : Lean.NameSet :=
+  (Lean.Expr.app typeExpr valueExpr).getUsedConstantsAsSet
+
+/-- Preserve the original collector's opaque body and inductive/ctor/recursor
+metadata cases. Only body-bearing cases share a single fold state. -/
+def getUsedConstantsFusedV3 (ci : Lean.ConstantInfo) : Lean.NameSet :=
+  match ci with
+  | .defnInfo info => fusedExprConstantsV3 ci.type info.value
+  | .thmInfo info => fusedExprConstantsV3 ci.type info.value
+  | .opaqueInfo info => fusedExprConstantsV3 ci.type info.value
+  | _ => ci.getUsedConstantsAsSet
+
+end Lean.Environment.Replay'
diff --git a/Lean4Checker/FusedDepsV3Controls.lean b/Lean4Checker/FusedDepsV3Controls.lean
new file mode 100644
index 0000000..a34326f
--- /dev/null
+++ b/Lean4Checker/FusedDepsV3Controls.lean
@@ -0,0 +1,71 @@
+/-
+Copyright (c) 2026. Released under Apache 2.0 license; see LICENSE.
+-/
+import Lean4Checker.FusedDepsV3
+
+namespace Lean.Environment.Replay'.FusedDepsV3Controls
+
+/-- Compare actual ascending Name.quickCmp enumeration, not TreeSet shape. -/
+def orderedNames (deps : NameSet) : Array Name := Id.run do
+  let mut names := #[]
+  for name in deps do names := names.push name
+  return names
+
+/-- Guards omitted native dependencies, opaque bodies, metadata exceptions and
+order drift. Independent expected nonempty names prevent the logical opaque
+fold initializer (empty set) from passing both sides vacuously. These records
+are synthetic metadata, never declarations submitted to any kernel. -/
+def checkCase (label : String) (ci : ConstantInfo) (expectedNames : Array Name) : IO Unit := do
+  let expected := orderedNames (NameSet.ofList expectedNames.toList)
+  let original := orderedNames ci.getUsedConstantsAsSet
+  let fused := orderedNames (getUsedConstantsFusedV3 ci)
+  unless original == expected && fused == expected do
+    throw <| IO.userError s!"{label}: expected {expected}, original {original}, fused {fused}"
+
+def bodyInfo (kind : Nat) (type value : Expr) : ConstantInfo :=
+  match kind with
+  | 0 => .defnInfo { name := `fixtureDef, levelParams := [], type := type, value := value, hints := .opaque, safety := .safe, all := [`ignoredDefMetadata] }
+  | 1 => .thmInfo { name := `fixtureThm, levelParams := [], type := type, value := value, all := [`ignoredThmMetadata] }
+  | _ => .opaqueInfo { name := `fixtureOpaque, levelParams := [], type := type, value := value, isUnsafe := false, all := [`ignoredOpaqueMetadata] }
+
+/-- Guards the actual compiled collector on all eight ConstantInfo variants,
+shared/disjoint/nested expression roots and ignored labels. No environment is
+imported or replayed; even the synthetic expressions may be ill typed. -/
+def runSynthetic : IO Unit := do
+  let a := Expr.const `typeOnly []
+  let b := Expr.const `valueOnly []
+  let shared := Expr.app a b
+  let ignored : MData := ({} : MData).setName `ignoredKey `ignoredPayload
+  let mut count := 0
+  for kind in [0:3] do
+    let cases : Array (String × Expr × Expr × Array Name) := #[
+      ("disjoint", a, b, #[`typeOnly, `valueOnly]),
+      ("shared", shared, shared, #[`typeOnly, `valueOnly]),
+      ("nested", shared, .app shared (.const `nestedOnly []), #[`typeOnly, `valueOnly, `nestedOnly]),
+      ("repeated-universes", a, .const `typeOnly [.succ .zero], #[`typeOnly]),
+      ("ignored-labels", .mdata ignored a, .proj `ignoredStructure 0 b, #[`typeOnly, `valueOnly]),
+      ("empty-type", .sort .zero, b, #[`valueOnly]),
+      ("empty-value", a, .sort .zero, #[`typeOnly]),
+      ("binders", .forallE `ignoredBinder a (.lam `ignoredBinder b (.bvar 0) .default) .default,
+       .letE `ignoredLet a b (.const `letBody []) false, #[`typeOnly, `valueOnly, `letBody])]
+    for (label, type, value, expected) in cases do
+      checkCase s!"body-{kind}-{label}" (bodyInfo kind type value) expected
+      count := count + 1
+  checkCase "axiom" (.axiomInfo { name := `ignoredAxiomName, levelParams := [], type := a, isUnsafe := false }) #[`typeOnly]
+  checkCase "inductive" (.inductInfo { name := `ignoredInductName, levelParams := [], type := a, numParams := 0, numIndices := 0, all := [`ignoredMutualInduct], ctors := [`ctorA, `ctorB], numNested := 0, isRec := false, isUnsafe := false, isReflexive := false }) #[`typeOnly, `ctorA, `ctorB]
+  checkCase "constructor" (.ctorInfo { name := `constructorSelf, levelParams := [], type := a, induct := `ignoredParent, cidx := 0, numParams := 0, numFields := 0, isUnsafe := false })
+    #[`typeOnly, `constructorSelf]
+  checkCase "recursor" (.recInfo { name := `ignoredRecName, levelParams := [], type := a, all := [`mutualA, `mutualB], numParams := 0, numIndices := 0, numMotives := 0, numMinors := 0, rules := [{ ctor := `ignoredRuleCtor, nfields := 0, rhs := .const `ignoredRuleBody [] }], k := false, isUnsafe := false }) #[`typeOnly, `mutualA, `mutualB]
+  checkCase "quotient" (.quotInfo { name := `ignoredQuotName, levelParams := [], type := a, kind := .type }) #[`typeOnly]
+  -- A deliberately wrong independent oracle must fail, rather than silently
+  -- reporting differential agreement between two empty native fallbacks.
+  let rejected ← try
+    checkCase "negative-oracle" (bodyInfo 2 a b) #[`typeOnly]
+    pure false
+  catch _ => pure true
+  unless rejected do throw <| IO.userError "negative oracle was not rejected"
+  IO.println s!"V3_METADATA_CONTROLS_PASS {count + 5} cases; negative oracle rejected; no replay"
+
+end Lean.Environment.Replay'.FusedDepsV3Controls
+
+def main : IO Unit := Lean.Environment.Replay'.FusedDepsV3Controls.runSynthetic
