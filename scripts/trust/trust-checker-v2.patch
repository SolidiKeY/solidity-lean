 import Lake.Load.Manifest
 
 open Lean
+
+/-- Optional v2 metadata cache: successful canonicalizations only, scoped to one scan.
+The full ordered-root walk and all kernel replay code remain unchanged. -/
+def canonicalV2 (cache : IO.Ref (Std.HashMap String System.FilePath))
+    (path : System.FilePath) : IO System.FilePath := do
+  if let some canonical := (← cache.get)[path.toString]? then
+    return canonical
+  let canonical ← IO.FS.realPath path
+  cache.modify (·.insert path.toString canonical)
+  return canonical
+
+def searchModuleV2 (cache : IO.Ref (Std.HashMap String System.FilePath))
+    (fname : System.FilePath) (roots : SearchPath) : IO (Option Name) := do
+  for root in roots do
+    try
+      let file ← canonicalV2 cache fname
+      let mut dir := (← canonicalV2 cache root).normalize
+      if !dir.toString.endsWith System.FilePath.pathSeparator.toString then
+        dir := ⟨dir.toString ++ System.FilePath.pathSeparator.toString⟩
+      if !dir.toString.isPrefixOf file.normalize.toString then
+        throw <| IO.userError "v2 root does not contain file"
+      let suffix := file.toString.drop dir.toString.length
+      return some <| (System.FilePath.mk suffix).withExtension ""
+        |>.components.foldl Name.mkStr Name.anonymous
+    catch
+      | _ => pure ()
+  return none
+
+def phaseV2 (phase : String) : IO Unit := do
+  let stderr ← IO.getStderr
+  stderr.putStrLn s!"trust-checker-v2: {phase}"
+  stderr.flush
 
