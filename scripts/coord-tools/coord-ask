#!/bin/sh
# The factory installs the native coord-ask in the lane tools directory.
# COORD_ASK_NATIVE supports a different installation path for local development.
tool=${COORD_ASK_NATIVE:-/workspace/coord-tools/coord-ask}
if [ ! -x "$tool" ]; then
  printf "%s\n" "coord-ask: the native tool is missing at $tool. Ask the factory to install it for this lane." >&2
  exit 127
fi
if [ "$tool" -ef "$0" ]; then
  printf "%s\n" "coord-ask: the native tool path resolves to this launcher" >&2
  exit 126
fi
if [ -z "${COORD_Q_REPO:-}" ]; then
  export COORD_Q_REPO=https://github.com/SolidiKeY/solidity-lean-coord.git
fi
unset COORD_PREPUSH_CMD
exec "$tool" "$@"
