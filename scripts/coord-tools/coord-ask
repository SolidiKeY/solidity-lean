#!/usr/bin/env python3
"""coord-ask — the lane's only channel to the coordinator (runs on a lane VM; needs git and push access to the
coordination repository, nothing else; in the lane's own repository it only fetches master, for --done).

  coord-ask [-t TITLE] [-q QID] TEXT     ask a question (TEXT may also come on stdin); the QID leads the title
  coord-ask --ack QID [NOTE]             the coordinator's answer to QID was applied: closes the question
  coord-ask --done [--result FILE]       this turn finished; FILE (or - for stdin) is the turn's CLOUDVM-RESULT
                                            JSON, which the coordinator uses as the lane's result the moment it lands

Each call commits one small file on top of the coordination repo's main in a tree-less shallow clone and pushes it
to coord-q/<lane>/<ts>, coord-ack/<lane>/<ts> or coord-done/<lane>/<ts>. The coordinator's inbox receives the push
through a GitHub webhook and opens, follows up (same lane + QID) or closes the issue, then deletes the ref.
--done also checks the head against the fetched master: when it lacks master commits older than COORD_STALE_HOURS
(6), it warns (the merge pre-gate builds the head merged onto current master) and records `behind:` in the push; it
never refuses.
Environment: COORD_Q_REPO (repository URL; default: this project's coordination repository), CLOUDVM_BATCH / CLOUDVM_SLUG
(override the batch/slug parsed from a codex/<batch>/<slug> branch name).
"""
import argparse, os, re, subprocess, sys, tempfile, time


def git(*a, inp=None, env=None):
    r = subprocess.run(['git', *a], input=inp, capture_output=True, text=True, env=env)
    if r.returncode: sys.exit(f'coord_ask: git {a[0]} failed: {r.stderr.strip()[-300:]}')
    return r.stdout.strip()


def behind_master(hours):
    """(commits, age of the oldest in hours) of the fetched origin master that HEAD lacks, if the oldest is at least
    `hours` old. Compares against FETCH_HEAD, so a lane clone whose fetch refspec omits master is still checked."""
    if subprocess.run(['git', 'fetch', '-q', 'origin', 'master'], capture_output=True).returncode: return None
    r = subprocess.run(['git', 'log', '--format=%ct', 'HEAD..FETCH_HEAD'], capture_output=True, text=True)
    ts = [int(x) for x in r.stdout.split()] if r.returncode == 0 else []
    if not ts: return None
    age = (time.time() - min(ts)) / 3600
    return (len(ts), age) if age >= hours else None


def main():
    ap = argparse.ArgumentParser(usage=__doc__)
    ap.add_argument('-t', dest='title', default=''); ap.add_argument('-q', dest='qid', default='')
    ap.add_argument('--ack', metavar='QID'); ap.add_argument('--done', action='store_true')
    ap.add_argument('--result', metavar='FILE')
    ap.add_argument('text', nargs='?')
    a = ap.parse_args()
    repo = os.environ.get('COORD_Q_REPO') or 'https://github.com/SolidiKeY/solidity-lean-coord.git'
    if a.ack: kind, prefix, first, body = 'acks', 'coord-ack', f'qid: {a.ack}', a.text or 'acknowledged'
    elif a.done:
        kind, prefix, first, body = 'done', 'coord-done', 'done: turn finished', a.text or 'turn finished'
        if a.result:
            import json
            body = sys.stdin.read() if a.result == '-' else open(a.result).read()
            body = body.strip()
            if body.startswith('```'): body = body.strip('`').partition('\n')[2].rstrip('`').strip()
            try: json.loads(body)
            except ValueError as e: sys.exit(f'coord_ask: --result is not JSON ({e})')
    else:
        body = a.text if a.text is not None else sys.stdin.read()
        if not body.strip(): sys.exit('coord_ask: empty question')
        title = a.title or body.splitlines()[0][:80]
        if a.qid and not title.startswith(f'{a.qid}:'): title = f'{a.qid}: {title}'
        kind, prefix, first = 'questions', 'coord-q', f'title: {title}'
    lane = git('rev-parse', '--abbrev-ref', 'HEAD'); head = git('rev-parse', 'HEAD')
    parts = lane.split('/')
    batch = os.environ.get('CLOUDVM_BATCH') or (parts[1] if len(parts) > 2 else '')
    slug = os.environ.get('CLOUDVM_SLUG') or (parts[2] if len(parts) > 2 else '')
    extra = ''
    if a.done:
        try: hours = float(os.environ.get('COORD_STALE_HOURS') or 6)
        except ValueError: hours = 6.0
        if not 0 <= hours < float('inf'): hours = 6.0   # nan, inf and negatives fall back too
        b = behind_master(hours)
        if b:
            extra = f'behind: {b[0]} commits, oldest {b[1]:.0f}h\n'
            print(f'coord-ask: WARNING: your head lacks {b[0]} commits of origin/master (the oldest is {b[1]:.0f} h old). '
                  'The merge pre-gate builds your head merged onto current master: merge origin/master and run '
                  '`bash scripts/coord-tools/gate.sh touched` before your next push (docs/contributing.md#before-pushing).',
                  file=sys.stderr)
    blob = f'{first}\nlane: {lane}\nhead: {head}\nbatch: {batch}\nslug: {slug}\n{extra}---\n{body}\n'
    ts = time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())
    with tempfile.TemporaryDirectory() as tmp:
        env = dict(os.environ, GIT_TERMINAL_PROMPT='0', GIT_DIR=os.path.join(tmp, 'q'))
        clone_env = {k: v for k, v in env.items() if k != 'GIT_DIR'}
        if subprocess.run(['git', 'clone', '-q', '--bare', '--depth', '1', '--filter=tree:0', repo, env['GIT_DIR']],
                          env=clone_env).returncode: sys.exit('coord_ask: clone of the coordination repository failed')
        g = lambda *x, inp=None: git(*x, inp=inp, env=env)
        base = g('rev-parse', 'HEAD')
        b = g('hash-object', '-w', '--stdin', inp=blob)
        qt = g('mktree', inp=f'100644 blob {b}\t{ts}.md\n')
        ct = g('mktree', inp=f'040000 tree {qt}\t{kind}\n')
        rest = [l for l in g('ls-tree', f'{base}^{{tree}}').splitlines() if not l.endswith('\tcoord')]
        tree = g('mktree', '--missing', inp='\n'.join(rest + [f'040000 tree {ct}\tcoord']) + '\n')
        c = g('-c', f'user.name={os.environ.get("GIT_AUTHOR_NAME", "coord-ask")}',
              '-c', f'user.email={os.environ.get("GIT_AUTHOR_EMAIL", "coord-ask@localhost")}',
              'commit-tree', tree, '-p', base, '-m', f'{kind[:-1] if kind != "done" else "done"}: {first}')
        ref = f'{prefix}/' + re.sub(r'[^A-Za-z0-9._/-]', '-', lane) + f'/{ts}'
        g('push', '-q', repo, f'{c}:refs/heads/{ref}')
    print(f'{ {"acks": "acked", "done": "done", "questions": "asked"}[kind] }: {ref}')


if __name__ == '__main__':
    main()
