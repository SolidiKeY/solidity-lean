#!/usr/bin/env python3
"""Per-area prose ratchet. Missing areas have a zero budget; --update never raises it."""
import argparse
from bisect import bisect_left
from fractions import Fraction
import hashlib
import json
from pathlib import Path
import re
import sys

RAW = re.compile(r'r(#+)?"')
CHAR = re.compile(r"'(?:[^'\\\n]|\\(?:u\{[0-9a-fA-F]+\}|.))'")
METRICS = ("docs_lines", "comment_lines", "docstring_lines", "process_ids")

# Lean 4.24 Init.Meta.Defs.isIdRest: interpolation keywords need token boundaries.
_ID_RANGES = ((0x3B1, 0x3C9), (0x391, 0x3A9), (0x3CA, 0x3FB),
              (0x1F00, 0x1FFE), (0x2100, 0x214F), (0x1D49C, 0x1D59F),
              (0xC0, 0xFF), (0x100, 0x17F), (0x2080, 0x2089),
              (0x2090, 0x209C), (0x1D62, 0x1D6A), (0x2C7C, 0x2C7C))


def _identifier_rest(char):
    n = ord(char)
    return (char.isascii() and (char.isalnum() or char in "_'!?")) or (
        n not in {0x3BB, 0x3A0, 0x3A3, 0xD7, 0xF7}
        and any(low <= n <= high for low, high in _ID_RANGES))


# Inventory: pinned Init/Lean interpolatedStr declarations, plus Lake.DSL v!.
_INTERPOLATORS = {
    "s!": "direct", "m!": "direct", "f!": "direct", "v!": "adjacent",
    "dbg_trace": "direct", "println!": "direct", "throwError": "direct",
    "reportIssue!": "direct", "throwErrorAt": "ref",
    "throwNamedError": "name", "logNamedError": "name", "logNamedWarning": "name",
    "throwNamedErrorAt": "ref_name", "logNamedErrorAt": "ref_name",
    "logNamedWarningAt": "ref_name", "trace[": "trace",
    "trace_goal[": "trace", "Macro.trace[": "trace",
}
_PREFIX = re.compile("|".join(re.escape(x) for x in sorted(_INTERPOLATORS, key=len, reverse=True)))
_CODE = re.compile(r'--|/-|r#*"|["\'«`()\[\]{}⟨⟩‹›⟦⟧]|' + _PREFIX.pattern)
_COMMENT = re.compile(r'/-|-/')
_STRING = re.compile(r'"(?:[^"\\]|\\[\s\S])*"')
_TEXT = re.compile(r'["\\{]')
_GROUPS = {"(": ")", "[": "]", "{": "}", "⟨": "⟩", "‹": "›", "⟦": "⟧"}


# Fixed-arity maximal terms in Lean.Parser.Term and Init.Tactics.
_REF_WRAPPERS = {
    "no_index": 1, "private_decl%": 1, "type_of%": 1,
    "no_implicit_lambda%": 1, "value_of%": 1, "ensure_expected_type%": 2,
    "unop%": 2, "binrel%": 3, "binrel_no_prop%": 3, "binop%": 3,
    "binop_lazy%": 3, "leftact%": 3, "rightact%": 3,
    "for_in%": 3, "for_in'%": 3, "decl_name%": 0,
    "default_or_ofNonempty%": 0, "exact?%": 0,
}
_REF_HEAD = re.compile("|".join(re.escape(x) for x in sorted(_REF_WRAPPERS, key=len, reverse=True)))
_NUMBER = re.compile(r'(?:0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*(?:\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)')


class _Scanner:
    def __init__(self, source):
        self.source = source
        self.unclosed = False
        self.newlines = [m.start() for m in re.finditer("\n", source)]
        self.comments, self.docs, self.interpolations = set(), set(), set()

    def mark(self, start, end, target):
        if end > start:
            target.update(range(bisect_left(self.newlines, start) + 1,
                                bisect_left(self.newlines, end - 1) + 2))

    def block(self, start, collect):
        source = self.source
        stack = [(start, source.startswith(("/--", "/-!"), start))]
        pos = start + 2
        while stack:
            token = _COMMENT.search(source, pos)
            if token is None:
                self.unclosed = True
                pos = len(source)
                if collect:
                    for opening, doc in stack:
                        if doc:
                            self.mark(opening, pos, self.docs)
                break
            pos = token.end()
            if token[0] == "/-":
                stack.append((token.start(), source.startswith(("/--", "/-!"), token.start())))
            else:
                opening, doc = stack.pop()
                if doc and collect:
                    self.mark(opening, pos, self.docs)
        if collect:
            self.mark(start, pos, self.comments)
        return pos

    def trivia(self, pos):
        source = self.source
        while pos < len(source):
            if source[pos].isspace():
                pos += 1
            elif source.startswith("--", pos):
                end = source.find("\n", pos)
                pos = len(source) if end < 0 else end
            elif source.startswith("/-", pos):
                pos = self.block(pos, False)
            else:
                break
        return pos

    def identifier(self, pos, partial_dot=False):
        source = self.source
        start = pos
        while pos < len(source):
            if source[pos] == "«":
                end = source.find("»", pos + 1)
                if getattr(self, "strict_names", False) and end < 0:
                    self.unclosed = True
                pos = len(source) if end < 0 else end + 1
            elif _identifier_rest(source[pos]):
                while pos < len(source) and _identifier_rest(source[pos]):
                    pos += 1
            else:
                return pos if pos > start else None
            if pos >= len(source) or source[pos] != ".":
                return pos
            following = pos + 1
            if following < len(source) and (source[following] == "«" or _identifier_rest(source[following])):
                pos = following
            else:
                return following if partial_dot else pos
        return pos if pos > start else None

    def prefix(self, pos, boundary=True):
        source = self.source
        token = _PREFIX.match(source, pos)
        if token is None or (boundary and pos and (_identifier_rest(source[pos - 1]) or source[pos - 1] == ".")):
            return None
        end = token.end()
        if not token[0].endswith("[") and end < len(source) and (_identifier_rest(source[end]) or source[end] == "."):
            return None
        return token

    def literal(self, pos):
        source = self.source
        raw = RAW.match(source, pos) if source[pos] == "r" else None
        char = CHAR.match(source, pos) if source[pos] == "'" else None
        if pos and (raw or char) and _identifier_rest(source[pos - 1]):
            raw = char = None
        if raw and pos and source[pos - 1] == ".":
            raw = None
        if raw:
            closing = '"' + (raw[1] or "")
            end = source.find(closing, raw.end())
            self.unclosed |= end < 0
            return len(source) if end < 0 else end + len(closing)
        if char:
            return char.end()
        if source[pos] == '"':
            token = _STRING.match(source, pos)
            self.unclosed |= token is None
            return token.end() if token else len(source)
        return None

    def atom(self, pos):
        """Skip a ref:max atom, including grouped expressions and postfixes."""
        source = self.source
        pos = self.trivia(pos)
        if pos >= len(source):
            return None
        if source[pos] in "@$↑⇑↥":
            return self.atom(pos + 1)
        quoted = source[pos] == "`"
        if quoted:
            while pos < len(source) and source[pos] == "`":
                pos += 1
            pos = self.trivia(pos)
        if pos >= len(source):
            return None
        token = None if quoted else self.prefix(pos, False)
        head = None if quoted else _REF_HEAD.match(source, pos)
        if head and _identifier_rest(head[0][-1]) and head.end() < len(source) and (_identifier_rest(source[head.end()]) or source[head.end()] == "."):
            head = None
        if quoted and source[pos] not in _GROUPS:
            pos = self.identifier(pos)
        elif head:
            pos = head.end()
            for _ in range(_REF_WRAPPERS[head[0]]):
                pos = self.atom(pos)
                if pos is None:
                    return None
            if head[0] == "default_or_ofNonempty%":
                unsafe = self.trivia(pos)
                end = unsafe + len("unsafe")
                if source.startswith("unsafe", unsafe) and (end == len(source) or not (_identifier_rest(source[end]) or source[end] == ".")):
                    pos = end
        elif source.startswith(("#[", "#v[", "%["), pos):
            opening = source.find("[", pos)
            pos = self.code(opening + 1, "]", False)
        elif source.startswith("*...*", pos):
            pos += 5
        elif source[pos] in "·⋯":
            pos += 1
        elif source[pos] == ".":
            if pos + 1 < len(source) and source[pos + 1] in _GROUPS:
                pos = self.code(pos + 2, _GROUPS[source[pos + 1]], False)
            else:
                pos = self.identifier(pos + 1) or pos + 1
        elif source[pos].isascii() and source[pos].isdigit():
            number = _NUMBER.match(source, pos)
            pos = number.end()
            if source.startswith("#", pos) and not source.startswith("#'", pos):
                pos = self.atom(pos + 1)
                if pos is None:
                    return None
        elif token:
            quote = self.message(token)
            if quote is not None:
                self.interpolations.add(quote)
                pos = self.interpolated(quote, False)
            else:
                pos = self.identifier(pos)
        elif source[pos] in _GROUPS:
            pos = self.code(pos + 1, _GROUPS[source[pos]], False)
        else:
            pos = self.literal(pos) or self.identifier(pos)
        if pos is None:
            return None
        while pos < len(source):
            suffix = self.trivia(pos)
            if source.startswith("<...*", suffix):
                pos = suffix + 5
                continue
            if source.startswith("...*", suffix):
                pos = suffix + 4
                continue
            if source.startswith("#'", pos):
                pos = self.atom(pos + 2)
                if pos is None:
                    return None
            elif source.startswith(".{", pos):
                pos = self.code(pos + 2, "}", False)
            elif source[pos] == ".":
                end = self.identifier(pos + 1)
                if end is None:
                    break
                pos = end
            elif source[pos] == "[":
                pos = self.code(pos + 1, "]", False)
                if pos < len(source) and source[pos] in "!?":
                    pos += 1
                elif pos < len(source) and source[pos] == "'":
                    pos = self.atom(pos + 1)
                    if pos is None:
                        return None
            else:
                break
        return pos

    def message(self, token):
        source = self.source
        mode = _INTERPOLATORS[token[0]]
        pos = token.end()
        if mode == "adjacent":
            return pos if pos < len(source) and source[pos] == '"' else None
        if mode.startswith("ref"):
            pos = self.atom(pos)
            if pos is None:
                return None
        if mode in ("name", "ref_name", "trace"):
            pos = self.identifier(self.trivia(pos), mode != "trace")
            if pos is None:
                return None
        pos = self.trivia(pos)
        if mode == "trace":
            if pos >= len(source) or source[pos] != "]":
                return None
            pos = self.trivia(pos + 1)
        return pos if pos < len(source) and source[pos] == '"' else None

    def interpolated(self, quote, collect):
        pos = quote + 1
        while token := _TEXT.search(self.source, pos):
            pos = token.end()
            if token[0] == '"':
                return pos
            if token[0] == "\\":
                pos = min(pos + 1, len(self.source))
            else:
                pos = self.code(pos, "}", collect)
        self.unclosed = True
        return len(self.source)

    def code(self, pos=0, stop=None, collect=True):
        source = self.source
        closers = [stop] if stop else []
        while token := _CODE.search(source, pos):
            pos = token.start()
            if source.startswith("--", pos):
                end = source.find("\n", pos)
                end = len(source) if end < 0 else end
                if collect:
                    self.mark(pos, end, self.comments)
                pos = end
            elif source.startswith("/-", pos):
                pos = self.block(pos, collect)
            elif source[pos] == "«":
                end = source.find("»", pos + 1)
                if getattr(self, "strict_names", False) and end < 0:
                    self.unclosed = True
                pos = len(source) if end < 0 else end + 1
            elif source[pos] == "`":
                while pos < len(source) and source[pos] == "`":
                    pos += 1
                # Name literals are tokens; syntax quotations remain code.
                end = self.identifier(pos)
                if end is not None:
                    pos = end
            elif source[pos] == '"' and pos in self.interpolations:
                pos = self.interpolated(pos, collect)
            elif end := self.literal(pos):
                pos = end
            elif prefix := self.prefix(pos):
                quote = self.message(prefix)
                if quote is not None:
                    self.interpolations.add(quote)
                pos = prefix.end() - int(prefix[0].endswith("["))
            elif source[pos] in _GROUPS:
                if closers:
                    closers.append(_GROUPS[source[pos]])
                pos += 1
            elif closers and source[pos] == closers[-1]:
                pos += 1
                closers.pop()
                if not closers:
                    return pos
            else:
                pos += 1
        self.unclosed |= bool(closers)
        return len(source)


def comment_lines(source):
    """Count physical comment lines and their docstring subset using Lean tokens."""
    scanner = _Scanner(source)
    scanner.code()
    return len(scanner.comments), len(scanner.docs)


PROCESS_ID = re.compile(r"\b[GH][0-9]+\b")
_MODULE_NAME = r"[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)+"
_IMPORT = re.compile(r"import[ \t]+(" + _MODULE_NAME + r")[ \t]*")
# Pinned Lean.Parser.Module header grammar, independent of imported commands.
_HEADER_IMPORT = re.compile(
    r"[ \t]*(?:(?P<public>public)[ \t]+)?(?:(?P<meta>meta)[ \t]+)?"
    r"import[ \t]+(?:(?P<all>all)[ \t]+)?"
    r"(?P<name>[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*)[ \t]*")
# Unknown bare names can be reserved header/command tokens. These standard
# library roots are known identifiers in the pinned empty header environment.
_HEADER_BARE_ROOTS = frozenset(("Init", "Lean", "Std"))
_REGISTRY_ROOTS = ("Solidity.lean", "SolidityExamples.lean", "SoliditySlowExamples.lean",
                   "Bridge/SolidityBridge.lean")


def registered_modules(root):
    """Read generated roots, never infer registration from the inspected source."""
    modules = set()
    for name in _REGISTRY_ROOTS:
        path = root / name
        if path.is_file():
            for line in path.read_text(encoding="utf-8").splitlines():
                if token := _IMPORT.fullmatch(line):
                    modules.add(token[1])
    return modules


def _command_mask(scanner):
    """Hide comments and opaque tokens without moving source offsets.

    Comment trivia becomes spaces. Literals/quotations become nontrivia, so they
    cannot accidentally turn a malformed command into a recognized command.
    """
    source = scanner.source
    pieces, previous, pos = [], 0, 0
    while token := _CODE.search(source, pos):
        start = token.start()
        pos = token.end()
        opaque = True
        if token[0] == "--":
            end = source.find("\n", start)
            pos = len(source) if end < 0 else end
            opaque = False
        elif token[0] == "/-":
            pos = scanner.block(start, False)
            if sum(1 if m[0] == "/-" else -1 for m in _COMMENT.finditer(source, start, pos)):
                return None
            opaque = False
        elif source[start] == "«":
            end = source.find("»", start + 1)
            if end < 0:
                return None
            pos = end + 1
        elif source[start] == "`":
            opening = start
            while opening < len(source) and source[opening] == "`":
                opening += 1
            opening = scanner.trivia(opening)
            if opening < len(source) and source[opening] in _GROUPS:
                # Quotations can introduce arbitrary command syntax. Fail closed
                # for this file rather than recognize commands in their payload.
                return None
            pos = scanner.identifier(opening)
            if pos is None:
                return None
        elif source[start] == '"' and start in scanner.interpolations:
            pos = scanner.interpolated(start, False)
        elif end := scanner.literal(start):
            raw = RAW.match(source, start)
            if source[start] == '"' and _STRING.match(source, start) is None:
                return None
            if raw and source.find('"' + (raw[1] or ""), raw.end()) < 0:
                return None
            pos = end
        else:
            continue
        pieces.extend((source[previous:start], re.sub(r"[^\r\n]", "~" if opaque else " ", source[start:pos])))
        previous = pos
    pieces.append(source[previous:])
    return "".join(pieces)


def process_ids(source, modules, scanner=None):
    """H290 partial checkpoint: certain canonical module-header import tokens.

    Namespace/end classification awaits authoritative imported command context;
    even an empty textual pair can be a redefined command production.
    """
    matches = list(PROCESS_ID.finditer(source))
    if not matches or not modules:
        return len(matches)
    scanner = scanner or _Scanner(source)
    if not getattr(scanner, "scanned", False):
        scanner.code()
    masked = _command_mask(scanner)
    if masked is None or scanner.unclosed:
        return len(matches)
    exempt, offset = set(), 0
    saw_import, saw_prelude, saw_module = False, False, False
    for line in masked.splitlines(keepends=True):
        text = line.rstrip("\r\n")
        if text.strip():
            imported = _HEADER_IMPORT.fullmatch(text)
            if imported:
                name = imported["name"]
                if "." not in name and name not in _HEADER_BARE_ROOTS:
                    return len(matches)
                if ((any(imported[k] for k in ("public", "meta", "all")) and not saw_module)
                        or (imported["public"] and imported["all"])):
                    return len(matches)
                saw_import = True
                # A bare G ID is never an exempt qualified module component.
                if "." in name and name in modules:
                    exempt.update(offset + imported.start("name") + m.start()
                                  for m in PROCESS_ID.finditer(name)
                                  if m[0].startswith("G"))
            elif text.strip(" \t") == "module":
                if saw_module or saw_import or saw_prelude:
                    return len(matches)
                saw_module = True
            elif text.strip(" \t") == "prelude":
                if saw_import or saw_prelude:
                    return len(matches)
                saw_prelude = True
            else:
                break
        offset += len(line)
    # Imported command syntax cannot consume an already parsed module header.
    return len(matches) - len(exempt)


def counts(root):
    for tree in ("docs", "Solidity"):
        if not (root / tree).is_dir():
            raise ValueError(f"missing source directory: {root / tree}")
    result = {}
    modules = registered_modules(root)
    for tree in ("docs", "Solidity"):
        for path in sorted((root / tree).rglob("*")):
            if not path.is_file() or (tree == "Solidity" and path.suffix != ".lean"):
                continue
            relative = path.relative_to(root / tree)
            area = tree + "/" + (relative.parts[0] if len(relative.parts) > 1 else "_root")
            row = result.setdefault(area, dict.fromkeys(METRICS, 0))
            source = path.read_text(encoding="utf-8")
            if tree == "docs":
                row["docs_lines"] += len(source.splitlines())
            else:
                scanner = _Scanner(source)
                scanner.code()
                scanner.scanned = True
                row["comment_lines"] += len(scanner.comments)
                row["docstring_lines"] += len(scanner.docs)
                row["process_ids"] += process_ids(source, modules, scanner)
    return result


CANDIDATE_KEY = "_calibrated_candidate"
FROZEN_SCOPE_SHA256 = 'aa0328769eb74b72e401f75e8237471e3919dee277712e62360dd27a1cacaa6c'


def read_baseline(path):
    data = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        raise ValueError("baseline must be an area-to-counts object")
    for area, row in data.items():
        if area == CANDIDATE_KEY:
            continue
        if not isinstance(row, dict) or set(row) != set(METRICS):
            raise ValueError("invalid metrics for " + area)
        if any(type(n) is not int or n < 0 for n in row.values()):
            raise ValueError("counts must be nonnegative integers: " + area)
    return data



def rational(value):
    """Only exact nonnegative integer/fraction strings, with positive denominators."""
    if not isinstance(value, str) or not re.fullmatch(r"[0-9]+(?:/[0-9]+)?", value):
        raise ValueError("candidate coefficients must be nonnegative rational strings")
    try:
        return Fraction(value)
    except ZeroDivisionError as error:
        raise ValueError("candidate denominator must be positive") from error


def validate_candidate(policy):
    if not isinstance(policy, dict) or "areas" not in policy:
        raise ValueError("missing candidate policy")
    metadata = {k: v for k, v in policy.items() if k != "areas"}
    digest = hashlib.sha256(json.dumps(metadata, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
    if digest != FROZEN_SCOPE_SHA256:
        raise ValueError("candidate scope/identities/inactive metadata changed")
    if not isinstance(policy["areas"], dict) or not set(policy["areas"]) <= set(policy["denominator_mapping"]):
        raise ValueError("candidate area scope changed")
    for area, row in policy["areas"].items():
        if not isinstance(row, dict) or not set(row) <= set(METRICS):
            raise ValueError("invalid candidate metrics: " + area)
        for entry in row.values():
            if not isinstance(entry, dict) or set(entry) != {"ratio", "margin"}:
                raise ValueError("invalid candidate allowance")
            rational(entry["ratio"])
            rational(entry["margin"])
    return policy


def allowance(n, d, entry=None):
    """Return exact decision and floor of the sum for display only."""
    if type(n) is not int or type(d) is not int or min(n, d) < 0:
        raise ValueError("unavailable/invalid candidate measurement")
    r = rational(entry["ratio"]) if entry else Fraction(0)
    m = rational(entry["margin"]) if entry else Fraction(0)
    a, b, c, e = r.numerator, r.denominator, m.numerator, m.denominator
    return n*b*e <= a*d*e + c*b, (a*d*e + c*b) // (b*e)


def code_measurement(source):
    """Reuse the lexer; remove comment spans, retaining literal text and line offsets."""
    scanner = _Scanner(source)
    scanner.strict_names = True
    spans = []
    mark = scanner.mark

    def capture(start, end, target):
        if target is scanner.comments and end > start:
            spans.append((start, end))
        mark(start, end, target)

    scanner.mark = capture
    scanner.code()
    scanner.scanned = True
    del scanner.mark
    if scanner.unclosed:
        raise ValueError("malformed Lean source (unclosed lexical token)")
    code, pos = set(), 0
    for start, end in sorted(spans) + [(len(source), len(source))]:
        if start > pos:
            line = bisect_left(scanner.newlines, pos) + 1
            for piece in source[pos:start].split("\n"):
                if piece.strip():
                    code.add(line)
                line += 1
        pos = max(pos, end)
    return scanner, len(code)


def blob_id(data):
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def verified_lines(root, path, data, entries):
    """Synthetic entries exercise bindings; real frozen policy has none.

    Entry identity is independent of generation headers. A changed identity lapses
    exclusion. Missing/unreadable generators are unavailable input, not credit.
    """
    lines = set()
    for entry in entries:
        if entry["path"] != path or entry["blob"] != blob_id(data):
            continue
        generator = Path(entry["generator_path"])
        if generator.is_absolute() or ".." in generator.parts:
            raise ValueError("invalid generator path")
        if blob_id((root / generator).read_bytes()) != entry["generator_blob"]:
            continue
        if entry["scope"] == "file":
            return None
        first, last = entry["scope"]
        if type(first) is not int or type(last) is not int or not 1 <= first <= last:
            raise ValueError("invalid generated scope")
        lines.update(range(first, last + 1))
    return lines


def calibrated_counts(root, entries=()):
    for tree in ("docs", "Solidity"):
        if not (root / tree).is_dir():
            raise ValueError(f"missing source directory: {root / tree}")
    rows, codes = {}, {}
    modules = registered_modules(root)
    for tree in ("docs", "Solidity"):
        for path in sorted((root / tree).rglob("*")):
            if not path.is_file() or (tree == "Solidity" and path.suffix != ".lean"):
                continue
            relative = path.relative_to(root / tree)
            area = tree + "/" + (relative.parts[0] if len(relative.parts) > 1 else "_root")
            row = rows.setdefault(area, dict.fromkeys(METRICS, 0))
            codes.setdefault(area, 0)
            data = path.read_bytes()
            excluded = verified_lines(root, path.relative_to(root).as_posix(), data, entries)
            if excluded is None:
                continue
            source = data.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")
            # Replacing verified lines symmetrically preserves physical positions;
            # registry occurrence classification uses the original source below.
            if excluded:
                raise ValueError("partial generated scopes require independent reproduction; unsupported")
            if tree == "docs":
                row["docs_lines"] += len(source.splitlines())
            else:
                scanner, code = code_measurement(source)
                codes[area] += code
                row["comment_lines"] += len(scanner.comments)
                row["docstring_lines"] += len(scanner.docs)
                row["process_ids"] += process_ids(source, modules, scanner)
    return rows, codes


def shrink_candidate(old, proposal):
    validate_candidate(old)
    validate_candidate(proposal)
    if (set(proposal["areas"]) != set(old["areas"]) or
            any(set(proposal["areas"][a]) != set(row) for a, row in old["areas"].items())):
        raise ValueError("candidate update area/metric scope changed")
    for area, row in old["areas"].items():
        for metric, entry in row.items():
            for coefficient in ("ratio", "margin"):
                if rational(proposal["areas"][area][metric][coefficient]) > rational(entry[coefficient]):
                    raise ValueError(f"candidate increase refused: {area} {metric} {coefficient}")
    return proposal


def calibrated_main(args, baseline_path, document):
    policy = validate_candidate(document.get(CANDIDATE_KEY))
    if args.update:
        if args.candidate_proposal is None:
            raise ValueError("candidate --update requires explicit --candidate-proposal")
        proposal = json.loads(args.candidate_proposal.read_text(encoding="utf-8"))
        policy = shrink_candidate(policy, proposal)
    rows, codes = calibrated_counts(args.root, policy["verified_generated"])
    global_code = sum(n for a, n in codes.items() if a.startswith("Solidity/"))
    failed = False
    for area in sorted(rows.keys() | policy["areas"].keys()):
        d = codes.get(area, 0) if area.startswith("Solidity/") else global_code
        for metric in METRICS:
            n = rows.get(area, {}).get(metric, 0)
            passed, floor = allowance(n, d, policy["areas"].get(area, {}).get(metric))
            exempt = area in policy["enforcement_exclusions"]
            state = "EXEMPT" if exempt else "PASS" if passed else "FAIL"
            print(f"{area} {metric}: {n} <= {floor} (denominator {d}) {state}")
            failed |= not passed and not exempt
    if failed:
        print("Inactive calibrated prose budget FAIL", file=sys.stderr)
        return 1
    if args.update:
        document[CANDIDATE_KEY] = policy
        baseline_path.write_text(json.dumps(document, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print("Inactive calibrated prose budget PASS")
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument("--baseline", type=Path, help="defaults to ROOT/scripts/prose-baseline.json")
    parser.add_argument("--calibrated-check", action="store_true", help="evaluate inactive candidate; never replaces legacy enforcement")
    parser.add_argument("--candidate-proposal", type=Path, help="explicit complete candidate policy for shrink-only --calibrated-check --update")
    parser.add_argument("--update", action="store_true", help="lower existing budgets; refuse every increase")
    args = parser.parse_args()
    baseline_path = args.baseline or args.root / "scripts/prose-baseline.json"
    try:
        document = read_baseline(baseline_path)
        if args.candidate_proposal and not (args.calibrated_check and args.update):
            raise ValueError("--candidate-proposal requires --calibrated-check --update")
        if args.calibrated_check:
            return calibrated_main(args, baseline_path, document)
        baseline = {k: v for k, v in document.items() if k != CANDIDATE_KEY}
        actual = counts(args.root)
        merged = {area: actual.get(area, dict.fromkeys(METRICS, 0))
                  for area in sorted(baseline.keys() | actual.keys())}
        failures = []
        for area, row in merged.items():
            for metric, value in row.items():
                limit = baseline.get(area, {}).get(metric, 0)
                if value > limit:
                    failures.append(f"{area} {metric}: {value} > {limit}")
        if failures:
            print("Prose budget exceeded:\n" + "\n".join(failures), file=sys.stderr)
            return 1
        if args.update:
            if CANDIDATE_KEY in document:
                merged[CANDIDATE_KEY] = document[CANDIDATE_KEY]
            baseline_path.write_text(json.dumps(merged, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        print(f"Prose budget PASS ({len(merged) - int(CANDIDATE_KEY in merged)} areas)" + ("; baseline lowered" if args.update else ""))
        return 0
    except (OSError, ValueError, TypeError, KeyError) as error:
        print(f"prose budget: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
