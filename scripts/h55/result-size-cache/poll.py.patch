@@ -58,0 +63,24 @@
+# Explicit opt-in leaves existing producers under their original parser.
+# Strict items must carry both an authoritative turnId and final phase.
+H55_STRICT_BATCHES = frozenset(filter(None, os.environ.get('H55_STRICT_BATCHES', '').split(',')))
+
+def strict_result_block(text):
+    if validate is None:
+        raise RuntimeError('CLOUDVM-RESULT invalid: validator unavailable')
+    try:
+        return validate(text)
+    except ResultError as exc:
+        raise RuntimeError('CLOUDVM-RESULT invalid: ' + str(exc)) from exc
+
+def strict_turn_result(last, msgs, batch, slug):
+    turn_id = last.get('id')
+    if not isinstance(turn_id, str) or not turn_id:
+        raise RuntimeError('CLOUDVM-RESULT invalid: completed turn has no identity')
+    finals = [m for m in msgs if m.get('turnId') == turn_id and m.get('phase') == 'final_answer']
+    if len(finals) != 1:
+        raise RuntimeError('CLOUDVM-RESULT invalid: expected exactly one final message for completed turn')
+    result = strict_result_block(finals[0].get('text', ''))
+    if result['batch'] != batch or result['slug'] != slug:
+        raise RuntimeError('CLOUDVM-RESULT invalid: batch or slug mismatch')
+    return result
+
