{
  "type": "object",
  "required": [
    "batch",
    "slug",
    "status",
    "branch",
    "base",
    "head",
    "repository",
    "checkpoints",
    "gates",
    "reviews",
    "limitations",
    "questions",
    "artifacts",
    "waits"
  ],
  "additionalProperties": false,
  "properties": {
    "batch": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "done",
        "partial",
        "blocked"
      ]
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "head": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "minLength": 40,
          "maxLength": 40
        },
        {
          "type": "null"
        }
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^/"
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "done",
              "partial",
              "blocked"
            ]
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "status",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "pending"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reviews": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sources",
          "question",
          "options"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q[0-9]+$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "maxItems": 3,
            "uniqueItems": true
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "original_patch",
        "handoff",
        "evidence",
        "checksums"
      ],
      "additionalProperties": false,
      "properties": {
        "original_patch": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^/"
            },
            {
              "type": "null"
            }
          ]
        },
        "handoff": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^/"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^/"
            },
            {
              "type": "null"
            }
          ]
        },
        "checksums": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^/"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "waits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lane",
          "item"
        ],
        "additionalProperties": false,
        "properties": {
          "lane": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "item": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "handoff_to": {
      "type": "string",
      "minLength": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "done"
          }
        }
      },
      "then": {
        "properties": {
          "head": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "minLength": 40,
            "maxLength": 40
          },
          "artifacts": {
            "properties": {
              "original_patch": {
                "type": "string",
                "pattern": "^/"
              },
              "handoff": {
                "type": "string",
                "pattern": "^/"
              },
              "evidence": {
                "type": "string",
                "pattern": "^/"
              },
              "checksums": {
                "type": "string",
                "pattern": "^/"
              }
            }
          },
          "gates": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": {
                  "const": "pass"
                }
              }
            }
          },
          "checkpoints": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": {
                  "const": "done"
                }
              }
            }
          },
          "questions": {
            "maxItems": 0
          },
          "waits": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
