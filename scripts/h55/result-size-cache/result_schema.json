{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "H97 minimum envelope with separate unversioned legacy compatibility; not proof or deployment approval.",
  "$defs": {
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "legacyRules": {
      "required": [
        "batch",
        "slug",
        "status",
        "branch",
        "base",
        "head",
        "repository",
        "checkpoints",
        "gates",
        "reviews",
        "limitations",
        "questions",
        "artifacts",
        "waits"
      ],
      "not": {
        "required": [
          "schema_version"
        ]
      },
      "properties": {
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "sources",
              "question",
              "options"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^Q[0-9]+$",
                "not": {
                  "pattern": "[\\r\\n]"
                }
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 2,
                "maxItems": 3,
                "uniqueItems": true
              }
            }
          }
        },
        "owner_tickets": false,
        "artifacts": {
          "required": [
            "original_patch",
            "handoff",
            "evidence",
            "checksums"
          ],
          "propertyNames": {
            "enum": [
              "original_patch",
              "handoff",
              "evidence",
              "checksums"
            ]
          }
        },
        "waits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "lane",
              "item"
            ],
            "additionalProperties": false,
            "properties": {
              "lane": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "item": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "done"
          }
        }
      },
      "then": {
        "properties": {
          "checkpoints": {
            "minItems": 1
          }
        }
      }
    },
    "h97Rules": {
      "required": [
        "batch",
        "slug",
        "status",
        "branch",
        "head",
        "gates",
        "reviews",
        "limitations",
        "questions",
        "waits"
      ],
      "properties": {
        "head": {
          "$ref": "#/$defs/head"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "question",
              "options"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "not": {
                  "pattern": "[\\r\\n]"
                }
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "consequence"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "consequence": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                }
              }
            }
          }
        },
        "waits": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "batch": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "done",
        "partial",
        "blocked"
      ]
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "head": {
      "oneOf": [
        {
          "$ref": "#/$defs/head"
        },
        {
          "type": "null"
        }
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^/"
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "done",
              "partial",
              "blocked"
            ]
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "status",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "pending"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reviews": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array"
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "original_patch": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^/"
            },
            {
              "type": "null"
            }
          ]
        },
        "handoff": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^/"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^/"
            },
            {
              "type": "null"
            }
          ]
        },
        "checksums": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^/"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "waits": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "handoff_to": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "owner_tickets": {
      "description": "Optional opaque coordinator metadata; no owner agreement is inferred."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "done"
          }
        }
      },
      "then": {
        "properties": {
          "head": {
            "$ref": "#/$defs/head"
          },
          "artifacts": {
            "properties": {
              "original_patch": {
                "type": "string",
                "pattern": "^/"
              },
              "handoff": {
                "type": "string",
                "pattern": "^/"
              },
              "evidence": {
                "type": "string",
                "pattern": "^/"
              },
              "checksums": {
                "type": "string",
                "pattern": "^/"
              }
            }
          },
          "gates": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": {
                  "const": "pass"
                }
              }
            }
          },
          "checkpoints": {
            "items": {
              "properties": {
                "status": {
                  "const": "done"
                }
              }
            }
          },
          "questions": {
            "maxItems": 0
          },
          "waits": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "anyOf": [
    {
      "$ref": "#/$defs/h97Rules"
    },
    {
      "$ref": "#/$defs/legacyRules"
    }
  ]
}
